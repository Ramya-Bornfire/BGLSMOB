<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/pro_banking_bg">

    <!-- Login Card Glassmorphism -->
    <LinearLayout
        android:id="@+id/loginCard"
        android:layout_width="420dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="32dp"
        android:background="@drawable/bg_premium_card"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Logo -->
        <ImageView
            android:id="@+id/logoImage"
            android:layout_width="110dp"
            android:layout_height="80dp"
            android:src="@drawable/bf_logo"
            android:layout_gravity="center"
            android:scaleType="centerCrop"
            android:clipToOutline="true"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BLMS LOGIN"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:layout_gravity="center"
            android:layout_marginTop="16dp" />

        <!--        <TextView-->
        <!--            android:layout_width="wrap_content"-->
        <!--            android:layout_height="wrap_content"-->
        <!--            android:text="Advanced Pro Banking"-->
        <!--            android:textColor="#00E5FF"-->
        <!--            android:textSize="14sp"-->
        <!--            android:layout_gravity="center"-->
        <!--            android:layout_marginTop="4dp" />-->

        <!-- Username -->
        <EditText
            android:id="@+id/username"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="User ID"
            android:textColorHint="#99FFFFFF"
            android:textColor="#FFFFFF"
            android:layout_marginTop="32dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="@drawable/bg_premium_edittext"
            android:inputType="textCapCharacters"
            android:textSize="16sp"/>

        <!-- Password with Eye Icon -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <EditText
                android:id="@+id/password"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Password"
                android:textColorHint="#99FFFFFF"
                android:textColor="#FFFFFF"
                android:inputType="textPassword"
                android:paddingStart="16dp"
                android:paddingEnd="48dp"
                android:background="@drawable/bg_premium_edittext"
                android:textSize="16sp"/>

            <ImageView
                android:id="@+id/eyeIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_eye"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="12dp"
                app:tint="#99FFFFFF"/>
        </RelativeLayout>

        <!-- Sign In Button -->
        <Button
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="SIGN IN"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_premium_button"
            android:textColor="#FFFFFF"
            app:backgroundTint="@null"/> <!-- Remove default material tint to show our custom gradient -->

        <!-- Change Password TEXT -->
        <TextView
            android:id="@+id/txtChangePassword"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Change Password?"
            android:textColor="#00E5FF"
            android:textStyle="bold"
            android:layout_gravity="center"
            android:layout_marginTop="24dp"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>