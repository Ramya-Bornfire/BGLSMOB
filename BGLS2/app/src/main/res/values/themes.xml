<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.BGLS" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>

        <item name="colorPrimary">@color/cyanblue</item>
        <item name="colorPrimaryVariant">@color/cyanblue</item>
        <item name="colorOnPrimary">@color/white</item>

        <item name="colorSecondary">@color/cyanblue</item>
        <item name="colorOnSecondary">@color/white</item>

        <item name="android:statusBarColor">@color/cyanblue</item>
        <item name="android:windowBackground">@color/colorBackground</item>

        <item name="android:textViewStyle">@style/UppercaseTextView</item>
        <item name="android:editTextStyle">@style/UppercaseEditText</item>
        <item name="editTextStyle">@style/UppercaseEditText</item>

    </style>

    <style name="Theme.BGLS.Auth" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:statusBarColor">#0F172A</item>
        <item name="android:windowBackground">@drawable/pro_banking_bg</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

    <!-- REQUIRED if referenced -->
    <style name="Theme.BGLS.AppBarOverlay" parent="ThemeOverlay.MaterialComponents.Dark.ActionBar" />

    <style name="Theme.BGLS.PopupOverlay" parent="ThemeOverlay.MaterialComponents.Light" />

    <style name="Theme.BGLS.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="UppercaseTextView" parent="Widget.AppCompat.TextView">
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="UppercaseEditText" parent="Widget.AppCompat.EditText">
        <item name="android:textAllCaps">true</item>
    </style>

</resources>
