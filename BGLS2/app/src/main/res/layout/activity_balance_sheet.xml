<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp">

            <!-- ASSET SECTION -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:elevation="2dp"
                android:layout_marginEnd="4dp">

                <LinearLayout
                    android:layout_marginTop="30dp"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:orientation="horizontal"
                    android:background="#E8EAED"
                    android:paddingHorizontal="12dp"
                    android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="ASSET" android:textStyle="bold" android:textSize="14sp" android:textColor="#333333"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2" android:text="BALANCE SHEET" android:gravity="center" android:textStyle="bold" android:textSize="16sp" android:textColor="#333333"/>
                    <Button android:id="@+id/btnFilterAsset" android:layout_width="wrap_content" android:layout_height="32dp" android:text="Filter" android:backgroundTint="#2196F3" android:textColor="#FFFFFF" android:textSize="10sp" android:textAllCaps="false" android:minHeight="0dp" android:minWidth="0dp" android:paddingHorizontal="12dp"/>
                </LinearLayout>

                <!-- Asset Table Header -->
                <LinearLayout
                    android:id="@+id/layoutFilterAsset"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="#E8EAED"
                    android:visibility="gone">
                    <EditText android:id="@+id/etFilterAssetGlHead" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.2" android:hint="GL HEAD" android:textSize="10sp" android:padding="8dp" android:background="@drawable/edittext_border" android:layout_margin="2dp"/>
                    <EditText android:id="@+id/etFilterAssetGlDesc" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2.0" android:hint="GL DESC" android:textSize="10sp" android:padding="8dp" android:background="@drawable/edittext_border" android:layout_margin="2dp"/>
                    <EditText android:id="@+id/etFilterAssetNoOfAc" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.0" android:hint="NO OF A" android:textSize="10sp" android:padding="8dp" android:background="@drawable/edittext_border" android:layout_margin="2dp" android:gravity="center"/>
                    <EditText android:id="@+id/etFilterAssetCurrency" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.8" android:hint="CURREN" android:textSize="10sp" android:padding="8dp" android:background="@drawable/edittext_border" android:layout_margin="2dp"/>
                    <EditText android:id="@+id/etFilterAssetAmount" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.2" android:hint="AMOUNT" android:textSize="10sp" android:padding="8dp" android:background="@drawable/edittext_border" android:layout_margin="2dp" android:gravity="end"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="#E8EAED">
                    <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.2" android:text="GL HEAD" android:textSize="10sp" android:padding="8dp"/>
                    <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="2.0" android:text="GL DESC" android:textSize="10sp" android:padding="8dp"/>
                    <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.0" android:text="NO OF AC" android:textSize="10sp" android:padding="8dp" android:gravity="center"/>
                    <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="0.8" android:text="CURRENCY" android:textSize="10sp" android:padding="8dp"/>
                    <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.2" android:text="AMOUNT" android:textSize="10sp" android:padding="8dp" android:gravity="end"/>
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvAsset"
                    android:layout_width="match_parent"
                    android:layout_height="400dp"
                    android:background="#FFFFFF"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="8dp"
                    android:gravity="end">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Total:" android:textStyle="bold" android:textSize="12sp" android:layout_marginEnd="16dp"/>
                    <TextView android:id="@+id/tvTotalAsset" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-43,538,802.10" android:textStyle="bold" android:textSize="12sp"/>
                </LinearLayout>

                <Button android:id="@+id/btnHome" android:layout_width="wrap_content" android:layout_height="32dp" android:text="Home" android:backgroundTint="#2196F3" android:textColor="#FFFFFF" android:textSize="10sp" android:layout_gravity="center" android:layout_marginBottom="8dp" android:minHeight="0dp" android:minWidth="0dp" android:paddingHorizontal="16dp"/>
            </LinearLayout>

            <!-- LIABILITY SECTION -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:elevation="2dp"
                android:layout_marginStart="4dp">

                <LinearLayout
                    android:layout_marginTop="30dp"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:orientation="horizontal"
                    android:background="#E8EAED"
                    android:paddingHorizontal="12dp"
                    android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="LIABILITY" android:textStyle="bold" android:textSize="14sp" android:textColor="#333333"/>
                    
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:background="@drawable/spinner_background"
                        android:paddingHorizontal="8dp"
                        android:gravity="center_vertical"
                        android:layout_marginEnd="8dp">
                        <TextView android:id="@+id/tvSelectedDate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="07-05-2026" android:textSize="10sp" android:layout_marginEnd="4dp"/>
                        <ImageView android:layout_width="12dp" android:layout_height="12dp" android:src="@android:drawable/ic_menu_my_calendar" android:tint="#666666"/>
                    </LinearLayout>
                    
                    <Button android:id="@+id/btnFilterLiability" android:layout_width="wrap_content" android:layout_height="32dp" android:text="Filter" android:backgroundTint="#2196F3" android:textColor="#FFFFFF" android:textSize="10sp" android:textAllCaps="false" android:minHeight="0dp" android:minWidth="0dp" android:paddingHorizontal="12dp"/>
                </LinearLayout>

                <!-- Liability Table Header -->
                <LinearLayout
                    android:id="@+id/layoutFilterLiability"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="#E8EAED"
                    android:visibility="gone">
                    <EditText android:id="@+id/etFilterLiabilityGlHead" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.2" android:hint="GL HEAD" android:textSize="10sp" android:padding="8dp" android:background="@drawable/edittext_border" android:layout_margin="2dp"/>
                    <EditText android:id="@+id/etFilterLiabilityGlDesc" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2.0" android:hint="GL DESC" android:textSize="10sp" android:padding="8dp" android:background="@drawable/edittext_border" android:layout_margin="2dp"/>
                    <EditText android:id="@+id/etFilterLiabilityNoOfAc" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.0" android:hint="NO OF A" android:textSize="10sp" android:padding="8dp" android:background="@drawable/edittext_border" android:layout_margin="2dp" android:gravity="center"/>
                    <EditText android:id="@+id/etFilterLiabilityCurrency" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.8" android:hint="CURREN" android:textSize="10sp" android:padding="8dp" android:background="@drawable/edittext_border" android:layout_margin="2dp"/>
                    <EditText android:id="@+id/etFilterLiabilityAmount" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.2" android:hint="AMOUNT" android:textSize="10sp" android:padding="8dp" android:background="@drawable/edittext_border" android:layout_margin="2dp" android:gravity="end"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="#E8EAED">
                    <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.2" android:text="GL HEAD" android:textSize="10sp" android:padding="8dp"/>
                    <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="2.0" android:text="GL DESC" android:textSize="10sp" android:padding="8dp"/>
                    <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.0" android:text="NO OF AC" android:textSize="10sp" android:padding="8dp" android:gravity="center"/>
                    <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="0.8" android:text="CURRENCY" android:textSize="10sp" android:padding="8dp"/>
                    <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.2" android:text="AMOUNT" android:textSize="10sp" android:padding="8dp" android:gravity="end"/>
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvLiability"
                    android:layout_width="match_parent"
                    android:layout_height="400dp"
                    android:background="#FFFFFF"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="8dp"
                    android:gravity="end">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Total:" android:textStyle="bold" android:textSize="12sp" android:layout_marginEnd="16dp"/>
                    <TextView android:id="@+id/tvTotalLiability" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="286,188,744.88" android:textStyle="bold" android:textSize="12sp"/>
                </LinearLayout>

                <Button android:id="@+id/btnBack" android:layout_width="wrap_content" android:layout_height="32dp" android:text="Back" android:backgroundTint="#2196F3" android:textColor="#FFFFFF" android:textSize="10sp" android:layout_gravity="center" android:layout_marginBottom="8dp" android:minHeight="0dp" android:minWidth="0dp" android:paddingHorizontal="16dp"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Bottom Report Status Info -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#FFFFFF"
        android:gravity="center">
        
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Report Status : " android:textStyle="bold" android:textSize="16sp" android:textColor="#333333"/>
            <TextView android:id="@+id/tvReportStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Loss" android:textStyle="bold" android:textSize="16sp" android:textColor="#FF0000"/>
        </LinearLayout>

        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Loss Amount : " android:textStyle="bold" android:textSize="16sp" android:textColor="#333333"/>
            <TextView android:id="@+id/tvLossAmount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="329,727,546.98" android:textStyle="bold" android:textSize="16sp" android:textColor="#333333"/>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
