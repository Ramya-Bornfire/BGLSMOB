<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- SLEEK PROFESSIONAL HEADER (Single Row) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/header_bg"
        android:layout_marginTop="30dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:paddingHorizontal="24dp"
        android:elevation="8dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/arrow_back"
            android:padding="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/white"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"/>

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BALANCE SHEET"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:layout_centerInParent="true"/>

        <!-- Right Side Container (User Info + Buttons) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true">

            <!-- Vertical User Info -->
            <LinearLayout
                android:id="@+id/userInfoLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginEnd="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="65dp"
                        android:layout_height="wrap_content"
                        android:text="User ID"
                        android:textColor="#AACFFF"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=":"
                        android:textColor="#AACFFF"
                        android:textSize="10sp"
                        android:layout_marginEnd="4dp"/>
                    <TextView
                        android:id="@+id/txtUserIdInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="EMP04"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="2dp">
                    <TextView
                        android:layout_width="65dp"
                        android:layout_height="wrap_content"
                        android:text="User Name"
                        android:textColor="#AACFFF"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=":"
                        android:textColor="#AACFFF"
                        android:textSize="10sp"
                        android:layout_marginEnd="4dp"/>
                    <TextView
                        android:id="@+id/txtUserNameInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Manivanan"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="2dp">
                    <TextView
                        android:layout_width="65dp"
                        android:layout_height="wrap_content"
                        android:text="Login Time"
                        android:textColor="#AACFFF"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=":"
                        android:textColor="#AACFFF"
                        android:textSize="10sp"
                        android:layout_marginEnd="4dp"/>
                    <TextView
                        android:id="@+id/txtLoginTimeInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>

            <ImageView
                android:id="@+id/btnHome"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/home"
                android:padding="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/white"/>

        </LinearLayout>
    </RelativeLayout>

    <!-- Toolbar for actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end|center_vertical"
        android:padding="8dp"
        android:background="#E9ECEF">
        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Report As On:"
            android:textSize="11sp"
            android:textColor="#333333"
            android:layout_marginEnd="8dp"/>

        <LinearLayout
            android:id="@+id/layoutDatePicker"
            android:layout_width="120dp"
            android:layout_height="32dp"
            android:background="@drawable/edittext_background"
            android:paddingHorizontal="12dp"
            android:gravity="center_vertical"
            android:layout_marginEnd="16dp">
            <TextView 
                android:id="@+id/tvSelectedDate" 
                android:layout_width="0dp" 
                android:layout_height="wrap_content" 
                android:layout_weight="1"
                android:text="07-05-2026" 
                android:textSize="11sp"
                android:textColor="#333333"/>
            <ImageView 
                android:layout_width="14dp" 
                android:layout_height="14dp" 
                android:src="@android:drawable/ic_menu_my_calendar" 
                app:tint="#007BFF"/>
        </LinearLayout>

        <Button 
            android:id="@+id/btnFilterAsset" 
            android:layout_width="wrap_content" 
            android:layout_height="32dp" 
            android:text="Toggle Asset Filters" 
            android:backgroundTint="@color/cyanblue"
            android:textColor="#FFFFFF" 
            android:textSize="10sp" 
            android:textAllCaps="false" 
            android:minHeight="0dp" 
            android:minWidth="0dp" 
            android:paddingHorizontal="12dp"
            android:layout_marginEnd="8dp"/>

        <Button 
            android:id="@+id/btnFilterLiability" 
            android:layout_width="wrap_content" 
            android:layout_height="32dp" 
            android:text="Toggle Liability Filters" 
            android:backgroundTint="@color/cyanblue"
            android:textColor="#FFFFFF" 
            android:textSize="10sp" 
            android:textAllCaps="false" 
            android:minHeight="0dp" 
            android:minWidth="0dp" 
            android:paddingHorizontal="12dp"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp">

            <!-- ASSET SECTION -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:elevation="4dp"
                android:layout_marginEnd="4dp">

                <TextView 
                    android:layout_width="match_parent" 
                    android:layout_height="wrap_content" 
                    android:text="ASSETS" 
                    android:textStyle="bold" 
                    android:textSize="13sp" 
                    android:textColor="#FFFFFF"
                    android:background="@color/iconTint"
                    android:padding="8dp"
                    android:gravity="center"/>

                <!-- Asset Table Header -->
                <LinearLayout
                    android:id="@+id/assetHeaderRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="#E9ECEF"
                    android:paddingVertical="8dp">
                    <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.2" android:text="GL HEAD" android:textSize="9sp" />
                    <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="2.0" android:text="GL DESC" android:textSize="9sp" />
                    <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.0" android:text="CURRENCY" android:textSize="9sp" android:gravity="center"/>
                    <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.0" android:text="NO OF ACCT" android:textSize="9sp" android:gravity="center"/>
                    <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.2" android:text="AMOUNT" android:textSize="9sp" android:gravity="end" android:paddingEnd="4dp"/>
                </LinearLayout>

                <!-- Asset Filter Row -->
                <LinearLayout
                    android:id="@+id/layoutFilterAsset"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="#F8F9FA"
                    android:visibility="gone"
                    android:padding="4dp">
                    <EditText android:id="@+id/etFilterAssetGlHead" android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1.2" android:hint="GL HEAD" android:textSize="9sp" android:paddingHorizontal="4dp" android:background="@drawable/edittext_background" android:layout_margin="1dp" android:inputType="text"/>
                    <EditText android:id="@+id/etFilterAssetGlDesc" android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="2.0" android:hint="GL DESC" android:textSize="9sp" android:paddingHorizontal="4dp" android:background="@drawable/edittext_background" android:layout_margin="1dp" android:inputType="text"/>
                    <EditText android:id="@+id/etFilterAssetCurrency" android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1.0" android:hint="CUR" android:textSize="9sp" android:paddingHorizontal="4dp" android:background="@drawable/edittext_background" android:layout_margin="1dp" android:inputType="text"/>
                    <EditText android:id="@+id/etFilterAssetNoOfAc" android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1.0" android:hint="No Ac" android:textSize="9sp" android:paddingHorizontal="4dp" android:background="@drawable/edittext_background" android:layout_margin="1dp" android:inputType="number"/>
                    <EditText android:id="@+id/etFilterAssetAmount" android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1.2" android:hint="AMT" android:textSize="9sp" android:paddingHorizontal="4dp" android:background="@drawable/edittext_background" android:layout_margin="1dp" android:inputType="numberDecimal" android:gravity="end"/>
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvAsset"
                    android:layout_width="match_parent"
                    android:layout_height="350dp"
                    android:background="#FFFFFF"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="8dp"
                    android:background="#F8F9FA"
                    android:gravity="end">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Asset Total:" android:textStyle="bold" android:textSize="11sp" android:layout_marginEnd="8dp"/>
                    <TextView android:id="@+id/tvTotalAsset" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.00" android:textStyle="bold" android:textSize="11sp" android:textColor="#007BFF"/>
                </LinearLayout>
            </LinearLayout>

            <!-- LIABILITY SECTION -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:elevation="4dp"
                android:layout_marginStart="4dp">

                <TextView 
                    android:layout_width="match_parent" 
                    android:layout_height="wrap_content" 
                    android:text="LIABILITIES" 
                    android:textStyle="bold" 
                    android:textSize="13sp" 
                    android:textColor="#FFFFFF"
                    android:background="@color/iconTint"
                    android:padding="8dp"
                    android:gravity="center"/>

                <!-- Liability Table Header -->
                <LinearLayout
                    android:id="@+id/liabilityHeaderRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="#E9ECEF"
                    android:paddingVertical="8dp">
                    <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.2" android:text="GL HEAD" android:textSize="9sp" />
                    <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="2.0" android:text="GL DESC" android:textSize="9sp" />
                    <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.0" android:text="CURRENCY" android:textSize="9sp" android:gravity="center"/>
                    <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.0" android:text="NO OF ACCT" android:textSize="9sp" android:gravity="center"/>
                    <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.2" android:text="AMOUNT" android:textSize="9sp" android:gravity="end" android:paddingEnd="4dp"/>
                </LinearLayout>

                <!-- Liability Filter Row -->
                <LinearLayout
                    android:id="@+id/layoutFilterLiability"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="#F8F9FA"
                    android:visibility="gone"
                    android:padding="4dp">
                    <EditText android:id="@+id/etFilterLiabilityGlHead" android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1.2" android:hint="GL HEAD" android:textSize="9sp" android:paddingHorizontal="4dp" android:background="@drawable/edittext_background" android:layout_margin="1dp" android:inputType="text"/>
                    <EditText android:id="@+id/etFilterLiabilityGlDesc" android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="2.0" android:hint="GL DESC" android:textSize="9sp" android:paddingHorizontal="4dp" android:background="@drawable/edittext_background" android:layout_margin="1dp" android:inputType="text"/>
                    <EditText android:id="@+id/etFilterLiabilityCurrency" android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1.0" android:hint="CUR" android:textSize="9sp" android:paddingHorizontal="4dp" android:background="@drawable/edittext_background" android:layout_margin="1dp" android:inputType="text"/>
                    <EditText android:id="@+id/etFilterLiabilityNoOfAc" android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1.0" android:hint="No Ac" android:textSize="9sp" android:paddingHorizontal="4dp" android:background="@drawable/edittext_background" android:layout_margin="1dp" android:inputType="number"/>
                    <EditText android:id="@+id/etFilterLiabilityAmount" android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1.2" android:hint="AMT" android:textSize="9sp" android:paddingHorizontal="4dp" android:background="@drawable/edittext_background" android:layout_margin="1dp" android:inputType="numberDecimal" android:gravity="end"/>
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvLiability"
                    android:layout_width="match_parent"
                    android:layout_height="350dp"
                    android:background="#FFFFFF"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="8dp"
                    android:background="#F8F9FA"
                    android:gravity="end">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Liability Total:" android:textStyle="bold" android:textSize="11sp" android:layout_marginEnd="8dp"/>
                    <TextView android:id="@+id/tvTotalLiability" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.00" android:textStyle="bold" android:textSize="11sp" android:textColor="#DC3545"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Bottom Report Status Info -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="#FFFFFF"
        android:gravity="center"
        android:elevation="8dp">
        
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Report Status" android:textSize="11sp" android:textColor="#666666"/>
            <TextView android:id="@+id/tvReportStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Calculating..." android:textStyle="bold" android:textSize="16sp" android:textColor="#333333"/>
        </LinearLayout>

        <View android:layout_width="1dp" android:layout_height="40dp" android:background="#FFFFFF" android:layout_marginHorizontal="16dp"/>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/tvLossProfitLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Difference Amount" android:textSize="11sp" android:textColor="#666666"/>
            <TextView android:id="@+id/tvLossAmount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.00" android:textStyle="bold" android:textSize="16sp" android:textColor="#333333"/>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>

