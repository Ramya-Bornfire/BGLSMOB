<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F0F0">

    <!-- SLEEK PROFESSIONAL HEADER (Single Row) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/header_bg"
        android:layout_marginTop="30dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:paddingHorizontal="24dp"
        android:elevation="8dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/arrow_back"
            android:padding="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/white"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"/>

        <TextView
            android:id="@+id/toolbarTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="USER PROFILE"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:layout_centerInParent="true"/>

        <!-- Right Side Container (User Info + Buttons) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true">

            <!-- Vertical User Info -->
            <LinearLayout
                android:id="@+id/userInfoLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginEnd="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="65dp"
                        android:layout_height="wrap_content"
                        android:text="User ID"
                        android:textColor="#AACFFF"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=":"
                        android:textColor="#AACFFF"
                        android:textSize="10sp"
                        android:layout_marginEnd="4dp"/>
                    <TextView
                        android:id="@+id/txtUserIdInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="EMP04"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="2dp">
                    <TextView
                        android:layout_width="65dp"
                        android:layout_height="wrap_content"
                        android:text="User Name"
                        android:textColor="#AACFFF"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=":"
                        android:textColor="#AACFFF"
                        android:textSize="10sp"
                        android:layout_marginEnd="4dp"/>
                    <TextView
                        android:id="@+id/txtUserNameInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Manivanan"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="2dp">
                    <TextView
                        android:layout_width="65dp"
                        android:layout_height="wrap_content"
                        android:text="Login Time"
                        android:textColor="#AACFFF"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=":"
                        android:textColor="#AACFFF"
                        android:textSize="10sp"
                        android:layout_marginEnd="4dp"/>
                    <TextView
                        android:id="@+id/txtLoginTimeInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/btnSubmit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Submit"
                android:textColor="#FFFFFF"
                android:backgroundTint="#2196F3"
                android:layout_marginEnd="8dp"/>

            <ImageView
                android:id="@+id/btnHome"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/home"
                android:padding="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/white"/>

        </LinearLayout>
    </RelativeLayout>

    <!-- ─── SCROLLABLE FORM ─── -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ══════════════════════════════════ -->
            <!-- MAIN FORM CARD                     -->
            <!-- ══════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_background"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <!-- ─── ROW 1: User Id * | User Name ─── -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="10dp"
                    android:gravity="center_vertical">

                    <LinearLayout android:layout_width="130dp" android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="User Id" android:textSize="12sp" android:textColor="#555555"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text=" *" android:textSize="12sp" android:textColor="#F44336"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:background="@drawable/edittext_background"
                        android:gravity="center_vertical">
                        <EditText android:id="@+id/etUserId"
                            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:background="@null"
                            android:paddingStart="8dp" android:paddingTop="8dp" android:paddingBottom="8dp"
                            android:textSize="13sp" android:textColor="#333333" android:inputType="text"/>
                        <ImageView android:id="@+id/ivUserIdInfo"
                            android:layout_width="32dp" android:layout_height="32dp"
                            android:src="@android:drawable/ic_dialog_info"
                            android:padding="6dp" app:tint="#2196F3"/>
                    </LinearLayout>

                    <View android:layout_width="16dp" android:layout_height="1dp"/>

                    <TextView android:layout_width="130dp" android:layout_height="wrap_content"
                        android:text="User Name" android:textSize="12sp" android:textColor="#555555"/>
                    <EditText android:id="@+id/etUserName"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:background="@drawable/edittext_background"
                        android:paddingStart="8dp" android:paddingEnd="8dp"
                        android:paddingTop="8dp" android:paddingBottom="8dp"
                        android:textSize="13sp" android:textColor="#333333" android:inputType="text"/>
                </LinearLayout>

                <!-- ─── ROW 2: Branch Id | Branch Des ─── -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="10dp"
                    android:gravity="center_vertical">

                    <TextView android:layout_width="130dp" android:layout_height="wrap_content"
                        android:text="Branch Id" android:textSize="12sp" android:textColor="#555555"/>
                    <EditText android:id="@+id/etBranchId"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:background="@drawable/edittext_background"
                        android:paddingStart="8dp" android:paddingEnd="8dp"
                        android:paddingTop="8dp" android:paddingBottom="8dp"
                        android:textSize="13sp" android:inputType="text"/>

                    <View android:layout_width="16dp" android:layout_height="1dp"/>

                    <TextView android:layout_width="130dp" android:layout_height="wrap_content"
                        android:text="Branch Des" android:textSize="12sp" android:textColor="#555555"/>
                    <EditText android:id="@+id/etBranchDes"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:background="@drawable/edittext_background"
                        android:paddingStart="8dp" android:paddingEnd="8dp"
                        android:paddingTop="8dp" android:paddingBottom="8dp"
                        android:textSize="13sp" android:textColor="#AAAAAA" android:enabled="false"/>
                </LinearLayout>

                <!-- ─── ROW 3: Mobile No | Email Id ─── -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="10dp"
                    android:gravity="center_vertical">

                    <TextView android:layout_width="130dp" android:layout_height="wrap_content"
                        android:text="Mobile No" android:textSize="12sp" android:textColor="#555555"/>
                    <EditText android:id="@+id/etMobileNo"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:background="@drawable/edittext_background"
                        android:paddingStart="8dp" android:paddingEnd="8dp"
                        android:paddingTop="8dp" android:paddingBottom="8dp"
                        android:textSize="13sp" android:inputType="phone"/>

                    <View android:layout_width="16dp" android:layout_height="1dp"/>

                    <TextView android:layout_width="130dp" android:layout_height="wrap_content"
                        android:text="Email Id" android:textSize="12sp" android:textColor="#555555"/>
                    <EditText android:id="@+id/etEmailId"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:background="@drawable/edittext_background"
                        android:paddingStart="8dp" android:paddingEnd="8dp"
                        android:paddingTop="8dp" android:paddingBottom="8dp"
                        android:textSize="13sp" android:inputType="textEmailAddress"/>
                </LinearLayout>

                <!-- ─── ROW 4: User Disable Date | User Disable Till Date ─── -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="10dp"
                    android:gravity="center_vertical">

                    <TextView android:layout_width="130dp" android:layout_height="wrap_content"
                        android:text="User Disable Date" android:textSize="12sp" android:textColor="#555555"/>
                    <EditText android:id="@+id/etUserDisableDate"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:background="@drawable/edittext_background"
                        android:paddingStart="8dp" android:paddingEnd="8dp"
                        android:paddingTop="8dp" android:paddingBottom="8dp"
                        android:hint="dd-mm-yyyy" android:textColorHint="#AAAAAA"
                        android:textSize="13sp" android:focusable="true" android:clickable="true"/>

                    <View android:layout_width="16dp" android:layout_height="1dp"/>

                    <TextView android:layout_width="130dp" android:layout_height="wrap_content"
                        android:text="User Disable Till Date" android:textSize="12sp" android:textColor="#555555"/>
                    <EditText android:id="@+id/etUserDisableTillDate"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:background="@drawable/edittext_background"
                        android:paddingStart="8dp" android:paddingEnd="8dp"
                        android:paddingTop="8dp" android:paddingBottom="8dp"
                        android:hint="dd-mm-yyyy" android:textColorHint="#AAAAAA"
                        android:textSize="13sp" android:focusable="true" android:clickable="true"/>
                </LinearLayout>

                <!-- ─── ROW 5: Password | Password Expiry Date * ─── -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="10dp"
                    android:gravity="center_vertical">

                    <TextView android:layout_width="130dp" android:layout_height="wrap_content"
                        android:text="Password" android:textSize="12sp" android:textColor="#555555"/>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:background="@drawable/edittext_background"
                        android:gravity="center_vertical">
                        <EditText android:id="@+id/etPassword"
                            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:background="@null"
                            android:paddingStart="8dp" android:paddingTop="8dp" android:paddingBottom="8dp"
                            android:textSize="13sp" android:inputType="textPassword"/>
                        <ImageView android:id="@+id/ivTogglePassword"
                            android:layout_width="32dp" android:layout_height="32dp"
                            android:src="@android:drawable/ic_menu_view"
                            android:padding="6dp"
                            android:clickable="true"
                            android:focusable="true"
                            app:tint="#888888" />
                    </LinearLayout>

                    <View android:layout_width="16dp" android:layout_height="1dp"/>

                    <LinearLayout android:layout_width="130dp" android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Pwd Expiry Date" android:textSize="12sp" android:textColor="#555555"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text=" *" android:textSize="12sp" android:textColor="#F44336"/>
                    </LinearLayout>
                    <EditText android:id="@+id/etPasswordExpiryDate"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:background="@drawable/edittext_background"
                        android:paddingStart="8dp" android:paddingEnd="8dp"
                        android:paddingTop="8dp" android:paddingBottom="8dp"
                        android:hint="dd-mm-yyyy" android:textColorHint="#AAAAAA"
                        android:textSize="13sp" android:focusable="true" android:clickable="true"/>
                </LinearLayout>

                <!-- ─── ROW 6: User Status | Login Status ─── -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="10dp"
                    android:gravity="center_vertical">

                    <TextView android:layout_width="130dp" android:layout_height="wrap_content"
                        android:text="User Status" android:textSize="12sp" android:textColor="#555555"/>
                    <Spinner android:id="@+id/spinnerUserStatus"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:background="@drawable/spinner_background"
                        android:paddingStart="8dp" android:paddingEnd="8dp"
                        android:paddingTop="8dp" android:paddingBottom="8dp"/>

                    <View android:layout_width="16dp" android:layout_height="1dp"/>

                    <TextView android:layout_width="130dp" android:layout_height="wrap_content"
                        android:text="Login Status" android:textSize="12sp" android:textColor="#555555"/>
                    <Spinner android:id="@+id/spinnerLoginStatus"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:background="@drawable/spinner_background"
                        android:paddingStart="8dp" android:paddingEnd="8dp"
                        android:paddingTop="8dp" android:paddingBottom="8dp"/>
                </LinearLayout>

                <!-- ─── ROW 7: Account Expiry Date * | Login Flag ─── -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="10dp"
                    android:gravity="center_vertical">

                    <LinearLayout android:layout_width="130dp" android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Acct Expiry Date" android:textSize="12sp" android:textColor="#555555"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text=" *" android:textSize="12sp" android:textColor="#F44336"/>
                    </LinearLayout>
                    <EditText android:id="@+id/etAccountExpiryDate"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:background="@drawable/edittext_background"
                        android:paddingStart="8dp" android:paddingEnd="8dp"
                        android:paddingTop="8dp" android:paddingBottom="8dp"
                        android:hint="dd-mm-yyyy" android:textColorHint="#AAAAAA"
                        android:textSize="13sp" android:focusable="true" android:clickable="true"/>

                    <View android:layout_width="16dp" android:layout_height="1dp"/>

                    <TextView android:layout_width="130dp" android:layout_height="wrap_content"
                        android:text="Login Flag" android:textSize="12sp" android:textColor="#555555"/>
                    <EditText android:id="@+id/etLoginFlag"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:background="@drawable/edittext_background"
                        android:paddingStart="8dp" android:paddingEnd="8dp"
                        android:paddingTop="8dp" android:paddingBottom="8dp"
                        android:text="N" android:textSize="13sp"
                        android:textColor="#AAAAAA" android:enabled="false"/>
                </LinearLayout>

                <!-- ─── ROW 8: Account Access Code | Document Access Code ─── -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView android:layout_width="130dp" android:layout_height="wrap_content"
                        android:text="Acct Access Code" android:textSize="12sp" android:textColor="#555555"/>
                    <Spinner android:id="@+id/spinnerAccountAccessCode"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:background="@drawable/spinner_background"
                        android:paddingStart="8dp" android:paddingEnd="8dp"
                        android:paddingTop="8dp" android:paddingBottom="8dp"/>

                    <View android:layout_width="16dp" android:layout_height="1dp"/>

                    <TextView android:layout_width="130dp" android:layout_height="wrap_content"
                        android:text="Doc Access Code" android:textSize="12sp" android:textColor="#555555"/>
                    <Spinner android:id="@+id/spinnerDocumentAccessCode"
                        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                        android:background="@drawable/spinner_background"
                        android:paddingStart="8dp" android:paddingEnd="8dp"
                        android:paddingTop="8dp" android:paddingBottom="8dp"/>
                </LinearLayout>

            </LinearLayout>

            <!-- ══════════════════════════════════ -->
            <!-- ROLE AND RIGHTS CARD               -->
            <!-- ══════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_background"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ROLE AND RIGHTS"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#333333"
                    android:background="#EEEEEE"
                    android:paddingStart="16dp" android:paddingEnd="16dp"
                    android:paddingTop="12dp" android:paddingBottom="12dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- ─── ROW 1: Role Id * | Role Description ─── -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:layout_marginBottom="10dp"
                        android:gravity="center_vertical">

                        <LinearLayout android:layout_width="130dp" android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Role Id" android:textSize="12sp" android:textColor="#555555"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text=" *" android:textSize="12sp" android:textColor="#F44336"/>
                        </LinearLayout>
                        <Spinner android:id="@+id/spinnerRoleId"
                            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:background="@drawable/spinner_background"
                            android:paddingStart="8dp" android:paddingEnd="8dp"
                            android:paddingTop="8dp" android:paddingBottom="8dp"/>

                        <View android:layout_width="16dp" android:layout_height="1dp"/>

                        <TextView android:layout_width="130dp" android:layout_height="wrap_content"
                            android:text="Role Description" android:textSize="12sp" android:textColor="#555555"/>
                        <EditText android:id="@+id/etRoleDescription"
                            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:background="@drawable/edittext_background"
                            android:paddingStart="8dp" android:paddingEnd="8dp"
                            android:paddingTop="8dp" android:paddingBottom="8dp"
                            android:textSize="13sp" android:textColor="#AAAAAA" android:enabled="false"/>
                    </LinearLayout>

                    <!-- ─── ROW 2: Permissions | Work Class ─── -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:layout_marginBottom="10dp"
                        android:gravity="center_vertical">

                        <TextView android:layout_width="130dp" android:layout_height="wrap_content"
                            android:text="Permissions" android:textSize="12sp" android:textColor="#555555"/>
                        <Spinner android:id="@+id/spinnerPermissions"
                            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:background="@drawable/spinner_background"
                            android:paddingStart="8dp" android:paddingEnd="8dp"
                            android:paddingTop="8dp" android:paddingBottom="8dp"/>

                        <View android:layout_width="16dp" android:layout_height="1dp"/>

                        <TextView android:layout_width="130dp" android:layout_height="wrap_content"
                            android:text="Work Class" android:textSize="12sp" android:textColor="#555555"/>
                        <Spinner android:id="@+id/spinnerWorkClass"
                            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:background="@drawable/spinner_background"
                            android:paddingStart="8dp" android:paddingEnd="8dp"
                            android:paddingTop="8dp" android:paddingBottom="8dp"/>
                    </LinearLayout>

                    <!-- ─── ROW 3: Access Control | Remarks ─── -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView android:layout_width="130dp" android:layout_height="wrap_content"
                            android:text="Access Control" android:textSize="12sp" android:textColor="#555555"/>
                        <ImageView android:id="@+id/ivAccessControl"
                            android:layout_width="0dp" android:layout_height="32dp"
                            android:layout_weight="1"
                            android:src="@android:drawable/ic_menu_search"
                            android:scaleType="fitStart"
                            android:padding="4dp"
                            app:tint="#2196F3"
                            android:clickable="true" android:focusable="true"/>

                        <View android:layout_width="16dp" android:layout_height="1dp"/>

                        <TextView android:layout_width="130dp" android:layout_height="wrap_content"
                            android:text="Remarks" android:textSize="12sp" android:textColor="#555555"/>
                        <EditText android:id="@+id/etRemarks"
                            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:background="@drawable/edittext_background"
                            android:paddingStart="8dp" android:paddingEnd="8dp"
                            android:paddingTop="8dp" android:paddingBottom="8dp"
                            android:textSize="13sp" android:inputType="text"/>
                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>