<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!--
        COLUMN WIDTHS — must match header exactly:
        S.NO          = 60dp
        CUSTOMER ID   = 140dp
        CUSTOMER NAME = 220dp
        DOB           = 110dp
        BRANCH NAME   = 220dp
        MOBILE NO     = 150dp
        EMAIL         = 220dp
        STATUS        = 100dp
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView android:id="@+id/tvSno"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="0.8" android:minWidth="60dp"
            android:paddingTop="12dp" android:paddingBottom="12dp"
            android:background="@drawable/table_cell_bg" android:gravity="center_vertical"
            android:paddingStart="8dp" android:paddingEnd="4dp" android:textSize="12sp" android:textColor="#333333"/>

        <TextView android:id="@+id/tvCustomerId"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1.5" android:minWidth="140dp"
            android:paddingTop="12dp" android:paddingBottom="12dp"
            android:background="@drawable/table_cell_bg" android:gravity="center_vertical"
            android:paddingStart="8dp" android:paddingEnd="4dp" android:textSize="12sp" android:textColor="#2196F3"
            android:clickable="true" android:focusable="true"/>

        <TextView android:id="@+id/tvCustomerName"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="2.2" android:minWidth="220dp"
            android:paddingTop="12dp" android:paddingBottom="12dp"
            android:background="@drawable/table_cell_bg" android:gravity="center_vertical"
            android:paddingStart="8dp" android:paddingEnd="4dp" android:textSize="12sp" android:textColor="#333333"/>

        <TextView android:id="@+id/tvDob"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1.2" android:minWidth="110dp"
            android:paddingTop="12dp" android:paddingBottom="12dp"
            android:background="@drawable/table_cell_bg" android:gravity="center_vertical"
            android:paddingStart="8dp" android:paddingEnd="4dp" android:textSize="12sp" android:textColor="#333333"/>

        <TextView android:id="@+id/tvBranchName"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="2.2" android:minWidth="220dp"
            android:paddingTop="12dp" android:paddingBottom="12dp"
            android:background="@drawable/table_cell_bg" android:gravity="center_vertical"
            android:paddingStart="8dp" android:paddingEnd="4dp" android:textSize="12sp" android:textColor="#333333"/>

        <TextView android:id="@+id/tvMobileNo"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1.5" android:minWidth="150dp"
            android:paddingTop="12dp" android:paddingBottom="12dp"
            android:background="@drawable/table_cell_bg" android:gravity="center_vertical"
            android:paddingStart="8dp" android:paddingEnd="4dp" android:textSize="12sp" android:textColor="#333333"/>

        <TextView android:id="@+id/tvEmail"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="2.2" android:minWidth="220dp"
            android:paddingTop="12dp" android:paddingBottom="12dp"
            android:background="@drawable/table_cell_bg" android:gravity="center_vertical"
            android:paddingStart="8dp" android:paddingEnd="4dp" android:textSize="12sp" android:textColor="#333333"/>

        <TextView android:id="@+id/tvStatus"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1.2" android:minWidth="100dp"
            android:paddingTop="12dp" android:paddingBottom="12dp"
            android:background="@drawable/table_cell_bg" android:gravity="center_vertical"
            android:paddingStart="8dp" android:paddingEnd="4dp" android:textSize="12sp" android:textColor="#333333"/>

    </LinearLayout>


    <!-- Row divider -->
    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="#E0E0E0"/>

</LinearLayout>