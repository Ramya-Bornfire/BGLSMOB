<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- ─── TOP HEADER ─── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#F8F9FA"
        android:padding="12dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="TRANSACTION MAINTANANCE - LIST"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="#333333"/>

        <EditText
            android:id="@+id/etFilterDate"
            android:layout_width="120dp"
            android:layout_height="36dp"
            android:background="@drawable/edittext_background"
            android:padding="8dp"
            android:text="06-05-2026"
            android:textSize="12sp"
            android:textColor="#333333"
            android:drawableEnd="@android:drawable/ic_menu_my_calendar"
            android:layout_marginEnd="8dp"
            android:focusable="false"
            android:clickable="true"/>

        <Button
            android:id="@+id/btnFilter"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Filter"
            android:backgroundTint="#007BFF"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textAllCaps="false"
            android:minHeight="0dp"/>
    </LinearLayout>

    <!-- ─── TABLE: Header + Rows inside SAME HorizontalScrollView ─── -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="horizontal">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- ─── TABLE HEADER ─── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#E8EAED"
                android:paddingVertical="8dp">

                <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.1" android:text="TRAN DATE"/>
                <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.0" android:text="TRAN ID"/>
                <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="0.9" android:text="PA TRAN TY"/>
                <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="0.8" android:text="CURRENCY"/>
                <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.2" android:text="AMOUNT" android:gravity="end" android:paddingEnd="8dp"/>
                <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.0" android:text="ACCT ID"/>
                <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.3" android:text="ACCT NAME"/>
                <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.8" android:text="TRAN PARTICULAR"/>
                <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.0" android:text="STATUS"/>
                <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.1" android:text="ACTION" android:gravity="center"/>
            </LinearLayout>

            <!-- ─── ROWS ─── -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvJournalList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#FFFFFF"
                android:scrollbars="none"/>

        </LinearLayout>
    </HorizontalScrollView>

    <!-- ─── BOTTOM ACTIONS ─── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="16dp"
        android:background="#F8F9FA">

        <Button
            android:id="@+id/btnHome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Home"
            android:textColor="#FFFFFF"
            android:backgroundTint="#007BFF"
            android:layout_marginEnd="8dp"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Back"
            android:textColor="#FFFFFF"
            android:backgroundTint="#007BFF"
            android:textAllCaps="false" />
    </LinearLayout>

</LinearLayout>