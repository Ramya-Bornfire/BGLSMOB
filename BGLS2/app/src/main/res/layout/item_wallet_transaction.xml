<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="36dp"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <TextView android:id="@+id/tvTranDate" android:layout_width="100dp" android:layout_height="wrap_content" android:gravity="center" android:textSize="12sp" android:textColor="#2C3E50"/>
    <TextView android:id="@+id/tvValueDate" android:layout_width="100dp" android:layout_height="wrap_content" android:gravity="center" android:textSize="12sp" android:textColor="#2C3E50"/>
    <TextView android:id="@+id/tvCustId" android:layout_width="100dp" android:layout_height="wrap_content" android:gravity="center" android:textSize="12sp" android:textColor="#2C3E50"/>
    <TextView android:id="@+id/tvAccNo" android:layout_width="120dp" android:layout_height="wrap_content" android:gravity="center" android:textSize="12sp" android:textColor="#2C3E50"/>
    <TextView android:id="@+id/tvName" android:layout_width="150dp" android:layout_height="wrap_content" android:gravity="start|center_vertical" android:paddingStart="8dp" android:textSize="12sp" android:textColor="#2C3E50"/>
    <TextView android:id="@+id/tvType" android:layout_width="80dp" android:layout_height="wrap_content" android:gravity="center" android:textSize="12sp" android:textColor="#2C3E50"/>
    <TextView android:id="@+id/tvParticulars" android:layout_width="150dp" android:layout_height="wrap_content" android:gravity="start|center_vertical" android:paddingStart="8dp" android:textSize="12sp" android:textColor="#2C3E50"/>
    <TextView android:id="@+id/tvCurrency" android:layout_width="60dp" android:layout_height="wrap_content" android:gravity="center" android:textSize="12sp" android:textColor="#2C3E50"/>
    <TextView android:id="@+id/tvAmount" android:layout_width="100dp" android:layout_height="wrap_content" android:gravity="end|center_vertical" android:paddingEnd="8dp" android:textSize="12sp" android:textStyle="bold" android:textColor="#2C3E50"/>

</LinearLayout>
