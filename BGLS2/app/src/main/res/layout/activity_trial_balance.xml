<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- SLEEK PROFESSIONAL HEADER (Single Row) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/header_bg"
        android:layout_marginTop="30dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:paddingHorizontal="24dp"
        android:elevation="8dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/arrow_back"
            android:padding="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/white"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"/>

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TRIAL BALANCE - REPORTS"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:layout_centerInParent="true"/>

        <!-- Right Side Container (User Info + Buttons) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true">

            <!-- Vertical User Info -->
            <LinearLayout
                android:id="@+id/userInfoLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginEnd="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="65dp"
                        android:layout_height="wrap_content"
                        android:text="User ID"
                        android:textColor="#AACFFF"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=":"
                        android:textColor="#AACFFF"
                        android:textSize="10sp"
                        android:layout_marginEnd="4dp"/>
                    <TextView
                        android:id="@+id/txtUserIdInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="EMP04"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="2dp">
                    <TextView
                        android:layout_width="65dp"
                        android:layout_height="wrap_content"
                        android:text="User Name"
                        android:textColor="#AACFFF"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=":"
                        android:textColor="#AACFFF"
                        android:textSize="10sp"
                        android:layout_marginEnd="4dp"/>
                    <TextView
                        android:id="@+id/txtUserNameInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Manivanan"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="2dp">
                    <TextView
                        android:layout_width="65dp"
                        android:layout_height="wrap_content"
                        android:text="Login Time"
                        android:textColor="#AACFFF"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=":"
                        android:textColor="#AACFFF"
                        android:textSize="10sp"
                        android:layout_marginEnd="4dp"/>
                    <TextView
                        android:id="@+id/txtLoginTimeInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>

            <ImageView
                android:id="@+id/btnHome"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/home"
                android:padding="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/white"/>

        </LinearLayout>
    </RelativeLayout>

    <!-- Toolbar for actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end|center_vertical"
        android:padding="8dp"
        android:background="#E9ECEF">
        
        <LinearLayout
            android:id="@+id/layoutDatePicker"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/edittext_background"
            android:paddingHorizontal="8dp"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="8dp">
            <TextView
                android:id="@+id/tvSelectedDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="02-May-2026"
                android:textSize="11sp"
                android:textColor="#333333"
                android:layout_marginEnd="4dp"/>
            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@android:drawable/ic_menu_my_calendar"
                android:tint="#666666"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnFilter"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="Filter"
            android:backgroundTint="#007BFF"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textAllCaps="false"
            android:minHeight="0dp"/>
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="horizontal"
        android:descendantFocusability="blocksDescendants">
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:minWidth="1000dp"
            android:background="#FFFFFF">
            
            <!-- Table Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#E8EAED">
                <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="0.8" android:minWidth="80dp" android:background="@drawable/table_cell_bg" android:padding="12dp" android:text="GL CODE"/>
                <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="2.0" android:minWidth="200dp" android:background="@drawable/table_cell_bg" android:padding="12dp" android:text="ACCOUNT NAME"/>
                <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.5" android:minWidth="150dp" android:background="@drawable/table_cell_bg" android:padding="12dp" android:text="OPENING BALANCE" android:gravity="end|center_vertical"/>
                <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.2" android:minWidth="120dp" android:background="@drawable/table_cell_bg" android:padding="12dp" android:text="CREDIT" android:gravity="end|center_vertical"/>
                <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.2" android:minWidth="120dp" android:background="@drawable/table_cell_bg" android:padding="12dp" android:text="DEBIT" android:gravity="end|center_vertical"/>
                <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.2" android:minWidth="120dp" android:background="@drawable/table_cell_bg" android:padding="12dp" android:text="NET CHANGE" android:gravity="end|center_vertical"/>
                <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.2" android:minWidth="120dp" android:background="@drawable/table_cell_bg" android:padding="12dp" android:text="CLOSING BALANCE" android:gravity="end|center_vertical"/>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvTrialBalance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minWidth="910dp"
                android:background="#FFFFFF"
                android:nestedScrollingEnabled="false"/>

            <!-- Total Row (Aligned with columns) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#F8F9FA"
                android:minWidth="910dp">
                
                <View android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.8" android:minWidth="80dp"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2.0"
                    android:minWidth="200dp"
                    android:text="Total:"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:textColor="#333333"
                    android:padding="12dp"
                    android:gravity="end"/>
                
                <View android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.5" android:minWidth="150dp"/>

                <TextView
                    android:id="@+id/tvTotalCredits"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:minWidth="120dp"
                    android:text="0.00"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:textColor="#333333"
                    android:padding="12dp"
                    android:gravity="end"/>

                <TextView
                    android:id="@+id/tvTotalDebits"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.2"
                    android:minWidth="120dp"
                    android:text="0.00"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:textColor="#333333"
                    android:padding="12dp"
                    android:gravity="end"/>
                
                <View android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2.4" android:minWidth="240dp"/>
            </LinearLayout>

            <!-- GLSH Details Section -->
            <LinearLayout
                android:id="@+id/layoutGLSH"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginTop="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="GLSH DETAILS"
                    android:background="#E8EAED"
                    android:padding="8dp"
                    android:textStyle="bold"
                    android:textSize="14sp"
                    android:textColor="#333333"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="#E8EAED">
                    <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1" android:minWidth="120dp" android:background="@drawable/table_cell_bg" android:padding="12dp" android:text="GLSH CODE"/>
                    <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.2" android:minWidth="145dp" android:background="@drawable/table_cell_bg" android:padding="12dp" android:text="ACCOUNT NO"/>
                    <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="2" android:minWidth="240dp" android:background="@drawable/table_cell_bg" android:padding="12dp" android:text="ACCOUNT NAME"/>
                    <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.2" android:minWidth="145dp" android:background="@drawable/table_cell_bg" android:padding="12dp" android:text="CREDIT" android:gravity="end|center_vertical"/>
                    <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.2" android:minWidth="145dp" android:background="@drawable/table_cell_bg" android:padding="12dp" android:text="DEBIT" android:gravity="end|center_vertical"/>
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvGLSHDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minWidth="795dp"
                    android:background="#FFFFFF"
                    android:nestedScrollingEnabled="false"/>
            </LinearLayout>
        </LinearLayout>
    </HorizontalScrollView>

</LinearLayout>