<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- SLEEK PROFESSIONAL HEADER (Single Row) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/header_bg"
        android:layout_marginTop="30dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:paddingHorizontal="24dp"
        android:elevation="8dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/arrow_back"
            android:padding="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/white"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"/>

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ACCOUNT BALANCES - LIST"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:layout_centerInParent="true"/>

        <!-- Right Side Container (User Info + Buttons) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true">

            <!-- Vertical User Info -->
            <LinearLayout
                android:id="@+id/userInfoLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginEnd="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="65dp"
                        android:layout_height="wrap_content"
                        android:text="User ID"
                        android:textColor="#AACFFF"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=":"
                        android:textColor="#AACFFF"
                        android:textSize="10sp"
                        android:layout_marginEnd="4dp"/>
                    <TextView
                        android:id="@+id/txtUserIdInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="EMP04"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="2dp">
                    <TextView
                        android:layout_width="65dp"
                        android:layout_height="wrap_content"
                        android:text="User Name"
                        android:textColor="#AACFFF"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=":"
                        android:textColor="#AACFFF"
                        android:textSize="10sp"
                        android:layout_marginEnd="4dp"/>
                    <TextView
                        android:id="@+id/txtUserNameInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Manivanan"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="2dp">
                    <TextView
                        android:layout_width="65dp"
                        android:layout_height="wrap_content"
                        android:text="Login Time"
                        android:textColor="#AACFFF"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=":"
                        android:textColor="#AACFFF"
                        android:textSize="10sp"
                        android:layout_marginEnd="4dp"/>
                    <TextView
                        android:id="@+id/txtLoginTimeInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>

            <ImageView
                android:id="@+id/btnHome"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/home"
                android:padding="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/white"/>

        </LinearLayout>
    </RelativeLayout>

    <!-- Toolbar for actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end|center_vertical"
        android:padding="8dp"
        android:background="#E9ECEF">
        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Balances As On:"
            android:textSize="11sp"
            android:textColor="#333333"
            android:layout_marginEnd="8dp"/>

        <EditText
            android:id="@+id/etLeaseDatePicker"
            android:layout_width="120dp"
            android:layout_height="32dp"
            android:hint="Select Date"
            android:textSize="11sp"
            android:textColor="#333333"
            android:background="@drawable/edittext_background"
            android:paddingStart="12dp"
            android:paddingEnd="8dp"
            android:focusable="false"
            android:clickable="true"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnLeaseFilter"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="Search/Filter"
            android:textSize="10sp"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#007BFF"
            android:paddingHorizontal="16dp"
            android:minWidth="0dp"
            android:minHeight="0dp"/>
    </LinearLayout>

    <!-- Filter search box (shown when Filter button is active) -->
    <EditText
        android:id="@+id/etLeaseSearch"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:hint="Search by Customer ID / Account ID / Account Name..."
        android:textSize="12sp"
        android:background="#FFFFFF"
        android:paddingHorizontal="16dp"
        android:visibility="gone"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:singleLine="true"
        android:elevation="2dp"/>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- TABLE HEADER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#F8F9FA"
                android:paddingVertical="8dp">
                <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="0.6" android:minWidth="50dp"  android:text="SRL NO"/>
                <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.6" android:minWidth="120dp" android:text="CUSTOMER ID"/>
                <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="2.0" android:minWidth="160dp" android:text="ACCOUNT ID"/>
                <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.8" android:minWidth="150dp" android:text="ACCOUNT NAME"/>
                <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.2" android:minWidth="100dp"  android:text="DATE OF LOAN"/>
                <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.4" android:minWidth="120dp" android:gravity="end|center_vertical" android:paddingEnd="8dp" android:text="LOAN AMOUNT"/>
                <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.4" android:minWidth="120dp" android:gravity="end|center_vertical" android:paddingEnd="8dp" android:text="BALANCE"/>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvLeaseAccounts"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#FFFFFF"/>
        </LinearLayout>
    </HorizontalScrollView>

    <ProgressBar
        android:id="@+id/progressLease"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"
        android:layout_marginVertical="16dp"/>

    <TextView
        android:id="@+id/tvLeaseNoData"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="16dp"
        android:text="No records found for the selected date"
        android:textColor="#DC3545"
        android:textSize="13sp"
        android:visibility="gone"/>

</LinearLayout>
