<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- ─── TITLE BAR ─── -->
    <LinearLayout
        android:layout_marginTop="30dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/header_bg"
        android:padding="10dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/btnBackArrow"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/arrow_back"
            android:scaleType="centerCrop"
            android:layout_marginEnd="12dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ACCOUNT BALANCES - LIST"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/white"/>
    </LinearLayout>

    <!-- ─── SUB-HEADER: date picker + filter ─── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#E9ECEF"
        android:padding="8dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ACCOUNT BALANCES"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#333333"/>

        <EditText
            android:id="@+id/etLeaseDatePicker"
            android:layout_width="130dp"
            android:layout_height="36dp"
            android:hint="Select Date"
            android:textSize="11sp"
            android:textColor="#333333"
            android:background="@drawable/edittext_background"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:focusable="false"
            android:clickable="true"
            android:cursorVisible="false"
            android:layout_marginEnd="6dp"/>

        <Button
            android:id="@+id/btnLeaseFilter"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Filter"
            android:textSize="12sp"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#007BFF"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"/>
    </LinearLayout>

    <!-- Filter search box (shown when Filter button is active) -->
    <EditText
        android:id="@+id/etLeaseSearch"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:hint="Search by Customer ID / Account ID / Account Name..."
        android:textSize="12sp"
        android:background="#FFFFFF"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:visibility="gone"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:singleLine="true"/>

    <!-- ─── TABLE (header + rows) inside HorizontalScrollView ─── -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- TABLE HEADER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:orientation="horizontal"
                android:background="#E9ECEF"
                android:gravity="center_vertical"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="0.6" android:minWidth="40dp"  android:text="SRL NO"/>
                <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#AAAAAA"/>
                <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.6" android:minWidth="120dp" android:text="CUSTOMER ID"/>
                <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#AAAAAA"/>
                <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="2.0" android:minWidth="160dp" android:text="ACCOUNT ID"/>
                <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#AAAAAA"/>
                <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.6" android:minWidth="120dp" android:text="ACCOUNT NAME"/>
                <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#AAAAAA"/>
                <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.2" android:minWidth="90dp"  android:text="DATE OF LOAN"/>
                <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#AAAAAA"/>
                <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.4" android:minWidth="110dp" android:gravity="end|center_vertical" android:text="LOAN AMOUNT"/>
                <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#AAAAAA"/>
                <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.4" android:minWidth="110dp" android:gravity="end|center_vertical" android:text="BALANCE"/>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#CCCCCC"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvLeaseAccounts"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#FFFFFF"/>
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Progress + no-data -->
    <ProgressBar
        android:id="@+id/progressLease"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/tvLeaseNoData"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="16dp"
        android:text="No data available"
        android:textColor="#DC3545"
        android:textSize="13sp"
        android:visibility="gone"/>

    <!-- ─── BOTTOM ACTION BAR ─── -->
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#CCCCCC"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="12dp"
        android:background="#E9ECEF">

        <Button
            android:id="@+id/btnHome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Home"
            android:textColor="#FFFFFF"
            android:backgroundTint="#007BFF"
            android:layout_marginEnd="8dp"
            android:textAllCaps="false"/>

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Back"
            android:textColor="#FFFFFF"
            android:backgroundTint="#007BFF"
            android:textAllCaps="false"/>
    </LinearLayout>

</LinearLayout>
