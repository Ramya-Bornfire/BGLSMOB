<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:id="@+id/drawerLayout"
    android:background="#F0F0F0">
    <!-- 🔷 MAIN CONTENT -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/colorBackground">

        <!-- 🔷 TOP BAR -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="30dp"
            android:background="@drawable/header_bg"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:id="@+id/menuIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_centerVertical="true"
                android:src="@drawable/menu"
                android:clickable="true"
                android:focusable="true"
                app:tint="@android:color/white" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BUSINESS ACTIVITY DETAILS"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:layout_centerInParent="true"/>

            <!-- Date on right -->
            <TextView
                android:id="@+id/tvCurrentDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="24/04/2026"
                android:textSize="13sp"
                android:textColor="@color/black"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/edittext_background"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />
        </RelativeLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#CCCCCC" />

        <!-- 🔷 CONTENT AREA -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="12dp">

            <!-- 🔶 CENTERED CONTAINER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:orientation="vertical"
                android:background="#FFFFFF">

                <!-- HEADER ROW -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="#E8E8E8"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">

                    <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.2" android:minWidth="120dp" android:text="AUDIT DATE"/>
                    <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2.2" android:minWidth="220dp" android:text="TABLE NAME"/>
                    <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.3" android:minWidth="130dp" android:text="FUNCTION"/>
                    <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.3" android:minWidth="130dp" android:text="ENTRY USER"/>
                    <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.3" android:minWidth="130dp" android:text="ENTRY TIME"/>
                    <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.5" android:minWidth="150dp" android:text="AUTHORIZER"/>
                    <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.7" android:minWidth="170dp" android:text="AUTH TIME"/>
                    <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.6" android:minWidth="160dp" android:text="FIELD NAME"/>
                    <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.6" android:minWidth="160dp" android:text="OLD VALUE"/>
                    <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.6" android:minWidth="160dp" android:text="NEW VALUE"/>
                    <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2.2" android:minWidth="220dp" android:text="REMARKS"/>
                </LinearLayout>


                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#CCCCCC" />

                <!-- DATA LIST -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerViewbusinessActivity"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="#FFFFFF" />

            </LinearLayout>
        </FrameLayout>

    </LinearLayout>
    <!-- SIDE MENU (same as in MainActivity) -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:menu="@menu/drawer_menu"
        android:background="@color/lite" />

</androidx.drawerlayout.widget.DrawerLayout>