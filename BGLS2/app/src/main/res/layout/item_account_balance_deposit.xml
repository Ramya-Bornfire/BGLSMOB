<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">

    <TextView
        android:id="@+id/tvSrlNo"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.5"
        android:minWidth="36dp"
        android:gravity="center_vertical"
        android:textSize="11sp"
        android:textColor="#333333"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"/>

    <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#CCCCCC"/>

    <TextView
        android:id="@+id/tvCustomerId"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.4"
        android:minWidth="110dp"
        android:gravity="center_vertical"
        android:textSize="11sp"
        android:textColor="#333333"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"/>

    <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#CCCCCC"/>

    <TextView
        android:id="@+id/tvAccountId"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.4"
        android:minWidth="110dp"
        android:gravity="center_vertical"
        android:textSize="11sp"
        android:textColor="#1a6bb5"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"/>

    <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#CCCCCC"/>

    <TextView
        android:id="@+id/tvAccountName"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.4"
        android:minWidth="110dp"
        android:gravity="center_vertical"
        android:textSize="11sp"
        android:textColor="#333333"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"/>

    <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#CCCCCC"/>

    <TextView
        android:id="@+id/tvDateOfPeriod"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.2"
        android:minWidth="90dp"
        android:gravity="center_vertical"
        android:textSize="11sp"
        android:textColor="#333333"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"/>

    <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#CCCCCC"/>

    <TextView
        android:id="@+id/tvDepositAmount"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.3"
        android:minWidth="100dp"
        android:gravity="center_vertical|end"
        android:textSize="11sp"
        android:textColor="#333333"
        android:paddingStart="4dp"
        android:paddingEnd="6dp"/>

    <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#CCCCCC"/>

    <TextView
        android:id="@+id/tvPeriod"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.8"
        android:minWidth="60dp"
        android:gravity="center_vertical"
        android:textSize="11sp"
        android:textColor="#333333"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"/>

    <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#CCCCCC"/>

    <TextView
        android:id="@+id/tvRateOfInterest"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.0"
        android:minWidth="80dp"
        android:gravity="center_vertical"
        android:textSize="11sp"
        android:textColor="#333333"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"/>

    <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#CCCCCC"/>

    <TextView
        android:id="@+id/tvMaturityDate"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.2"
        android:minWidth="90dp"
        android:gravity="center_vertical"
        android:textSize="11sp"
        android:textColor="#333333"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"/>

    <View android:layout_width="1dp" android:layout_height="match_parent" android:background="#CCCCCC"/>

    <TextView
        android:id="@+id/tvAccountBalance"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.3"
        android:minWidth="100dp"
        android:gravity="center_vertical|end"
        android:textSize="11sp"
        android:textColor="#333333"
        android:paddingStart="4dp"
        android:paddingEnd="6dp"/>

</LinearLayout>
