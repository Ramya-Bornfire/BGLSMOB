<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:background="@drawable/header_bg"
        android:paddingHorizontal="16dp"
        android:gravity="center_vertical">
        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="TRANSACTION REVERSAL-EDIT"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@color/white"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Date"
            android:textSize="12sp"
            android:textColor="@color/white"
            android:layout_marginEnd="8dp"/>
        <TextView
            android:id="@+id/tvHeaderDate"
            android:layout_width="120dp"
            android:layout_height="32dp"
            android:background="#FFFFFF"
            android:gravity="center"
            android:text="10-04-2019"
            android:textColor="#333333"
            android:textSize="12sp"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_margin="16dp"
        android:fillViewport="true">
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ORIGINAL TRANSACTION -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_background"
                android:layout_marginBottom="16dp"
                android:elevation="2dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ORIGINAL TRANSACTION"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:textColor="#333333"
                    android:padding="8dp"/>
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="#E8EAED">
                    <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="0.9" android:text="TRAN DATE" android:textSize="9sp" android:padding="8dp"/>
                    <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.0" android:text="TRAN ID" android:textSize="9sp" android:padding="8dp"/>
                    <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="0.7" android:text="PA TRAN TY" android:textSize="9sp" android:padding="8dp"/>
                    <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="0.6" android:text="CURRENCY" android:textSize="9sp" android:padding="8dp"/>
                    <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="0.9" android:text="AMOUNT" android:textSize="9sp" android:padding="8dp" android:gravity="end|center_vertical"/>
                    <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.2" android:text="ACCT ID" android:textSize="9sp" android:padding="8dp"/>
                    <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.4" android:text="ACCT NAME" android:textSize="9sp" android:padding="8dp"/>
                    <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="0.8" android:text="STATUS" android:textSize="9sp" android:padding="8dp"/>
                    <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="0.6" android:text="SELECT" android:textSize="9sp" android:padding="8dp" android:gravity="center"/>
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvOriginalTransaction"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"/>
            </LinearLayout>

            <!-- REVERSAL TRANSACTION -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_background"
                android:layout_marginBottom="16dp"
                android:elevation="2dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="REVERSAL TRANSACTION"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:textColor="#333333"
                    android:padding="8dp"/>
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="#E8EAED">
                    <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="0.9" android:text="TRAN DATE" android:textSize="9sp" android:padding="8dp"/>
                    <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.0" android:text="TRAN ID" android:textSize="9sp" android:padding="8dp"/>
                    <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="0.7" android:text="PA TRAN TY" android:textSize="9sp" android:padding="8dp"/>
                    <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="0.6" android:text="CURRENCY" android:textSize="9sp" android:padding="8dp"/>
                    <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="0.9" android:text="AMOUNT" android:textSize="9sp" android:padding="8dp" android:gravity="end|center_vertical"/>
                    <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.2" android:text="ACCT ID" android:textSize="9sp" android:padding="8dp"/>
                    <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.4" android:text="ACCT NAME" android:textSize="9sp" android:padding="8dp"/>
                    <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="0.8" android:text="STATUS" android:textSize="9sp" android:padding="8dp"/>
                    <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="0.6" android:text="SELECT" android:textSize="9sp" android:padding="8dp" android:gravity="center"/>
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvReversalTransaction"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"/>
            </LinearLayout>

            <!-- NEW TRANSACTION -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_background"
                android:layout_marginBottom="16dp"
                android:elevation="2dp">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="NEW TRANSACTION"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:textColor="#333333"
                        android:layout_centerVertical="true"/>
                    <Button
                        android:id="@+id/btnAddTransaction"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="Add"
                        android:backgroundTint="#2196F3"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:textAllCaps="false"
                        android:minHeight="0dp"
                        android:minWidth="60dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"/>
                </RelativeLayout>
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="#E8EAED">
                    <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="0.9" android:text="TRAN DATE" android:textSize="9sp" android:padding="8dp"/>
                    <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.0" android:text="TRAN ID" android:textSize="9sp" android:padding="8dp"/>
                    <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="0.7" android:text="PA TRAN TY" android:textSize="9sp" android:padding="8dp"/>
                    <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="0.6" android:text="CURRENCY" android:textSize="9sp" android:padding="8dp"/>
                    <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="0.9" android:text="AMOUNT" android:textSize="9sp" android:padding="8dp" android:gravity="end|center_vertical"/>
                    <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.2" android:text="ACCT ID" android:textSize="9sp" android:padding="8dp"/>
                    <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.4" android:text="ACCT NAME" android:textSize="9sp" android:padding="8dp"/>
                    <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="0.8" android:text="STATUS" android:textSize="9sp" android:padding="8dp"/>
                    <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="0.6" android:text="SELECT" android:textSize="9sp" android:padding="8dp" android:gravity="center"/>
                    <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="0.6" android:text="DELETE" android:textSize="9sp" android:padding="8dp" android:gravity="center"/>
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvNewTransaction"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Footer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="16dp"
        android:background="#E8EAED">
        <Button
            android:id="@+id/btnEditHome"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Home"
            android:backgroundTint="#2196F3"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:layout_marginEnd="4dp"
            android:textAllCaps="false"
            android:minHeight="0dp"
            android:minWidth="80dp"/>
        <Button
            android:id="@+id/btnEditSubmit"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Submit"
            android:backgroundTint="#2196F3"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:layout_marginEnd="4dp"
            android:textAllCaps="false"
            android:minHeight="0dp"
            android:minWidth="80dp"/>
        <Button
            android:id="@+id/btnEditBack"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Back"
            android:backgroundTint="#2196F3"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textAllCaps="false"
            android:minHeight="0dp"
            android:minWidth="80dp"/>
    </LinearLayout>

</LinearLayout>
