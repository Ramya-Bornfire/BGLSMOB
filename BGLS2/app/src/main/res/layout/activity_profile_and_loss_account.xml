<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- SLEEK PROFESSIONAL HEADER (Single Row) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/header_bg"
        android:layout_marginTop="30dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:paddingHorizontal="24dp"
        android:elevation="8dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/arrow_back"
            android:padding="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/white"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"/>

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PROFIT AND LOSS ACCOUNT"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:layout_centerInParent="true"/>

        <!-- Right Side Container (User Info + Buttons) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true">

            <!-- Vertical User Info -->
            <LinearLayout
                android:id="@+id/userInfoLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginEnd="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="65dp"
                        android:layout_height="wrap_content"
                        android:text="User ID"
                        android:textColor="#AACFFF"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=":"
                        android:textColor="#AACFFF"
                        android:textSize="10sp"
                        android:layout_marginEnd="4dp"/>
                    <TextView
                        android:id="@+id/txtUserIdInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="EMP04"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="2dp">
                    <TextView
                        android:layout_width="65dp"
                        android:layout_height="wrap_content"
                        android:text="User Name"
                        android:textColor="#AACFFF"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=":"
                        android:textColor="#AACFFF"
                        android:textSize="10sp"
                        android:layout_marginEnd="4dp"/>
                    <TextView
                        android:id="@+id/txtUserNameInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Manivanan"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="2dp">
                    <TextView
                        android:layout_width="65dp"
                        android:layout_height="wrap_content"
                        android:text="Login Time"
                        android:textColor="#AACFFF"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=":"
                        android:textColor="#AACFFF"
                        android:textSize="10sp"
                        android:layout_marginEnd="4dp"/>
                    <TextView
                        android:id="@+id/txtLoginTimeInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>

            <ImageView
                android:id="@+id/btnHome"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/home"
                android:padding="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/white"/>

        </LinearLayout>
    </RelativeLayout>

    <!-- Toolbar for actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end|center_vertical"
        android:padding="8dp"
        android:background="#E9ECEF">
        
        <LinearLayout
            android:id="@+id/llDatePicker"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/edittext_background"
            android:paddingHorizontal="8dp"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginEnd="8dp">
            <TextView
                android:id="@+id/tvSelectedDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="02-May-2026"
                android:textSize="11sp"
                android:textColor="#333333"
                android:layout_marginEnd="4dp"/>
            <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@android:drawable/ic_menu_my_calendar" app:tint="#666666"/>
        </LinearLayout>

        <Button android:id="@+id/btnFilterIncome" android:layout_width="wrap_content" android:layout_height="32dp" android:text="Income Filter" android:backgroundTint="#007BFF" android:textColor="#FFFFFF" android:textSize="10sp" android:textAllCaps="false" android:minHeight="0dp" android:layout_marginEnd="8dp"/>
        <Button android:id="@+id/btnFilterExpenditure" android:layout_width="wrap_content" android:layout_height="32dp" android:text="Exp. Filter" android:backgroundTint="#007BFF" android:textColor="#FFFFFF" android:textSize="10sp" android:textAllCaps="false" android:minHeight="0dp"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp">

            <!-- INCOME SECTION -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:elevation="2dp"
                android:layout_marginEnd="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:orientation="horizontal"
                    android:background="#F8F9FA"
                    android:paddingHorizontal="12dp"
                    android:gravity="center_vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="INCOME" android:textStyle="bold" android:textSize="14sp" android:textColor="#333333" android:gravity="center"/>
                </LinearLayout>

                <!-- Income Table Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#E8EAED">

                    <LinearLayout
                        android:id="@+id/incomeHeaderRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.2" android:text="GL HEAD" android:textSize="10sp" android:padding="8dp"/>
                        <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.0" android:text="ACCT ID" android:textSize="10sp" android:padding="8dp"/>
                        <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="2.0" android:text="ACCT NAME" android:textSize="10sp" android:padding="8dp"/>
                        <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="0.6" android:text="CUR" android:textSize="10sp" android:padding="8dp"/>
                        <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.0" android:text="AMOUNT" android:textSize="10sp" android:padding="8dp" android:gravity="end"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/llIncomeFilters"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:visibility="gone"
                        android:paddingHorizontal="4dp"
                        android:paddingVertical="4dp">
                        <EditText android:id="@+id/etFilterIncomeGl" android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1.2" android:background="@drawable/edittext_background" android:textSize="10sp" android:hint="GL" android:paddingHorizontal="4dp" android:inputType="text"/>
                        <EditText android:id="@+id/etFilterIncomeId" android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1.0" android:background="@drawable/edittext_background" android:textSize="10sp" android:hint="Acct ID" android:paddingHorizontal="4dp" android:inputType="text"/>
                        <EditText android:id="@+id/etFilterIncomeName" android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="2.0" android:background="@drawable/edittext_background" android:textSize="10sp" android:hint="Name" android:paddingHorizontal="4dp" android:inputType="text"/>
                        <EditText android:id="@+id/etFilterIncomeCurrency" android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="0.6" android:background="@drawable/edittext_background" android:textSize="10sp" android:hint="Cur" android:paddingHorizontal="4dp" android:inputType="text"/>
                        <EditText android:id="@+id/etFilterIncomeAmount" android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1.0" android:background="@drawable/edittext_background" android:textSize="10sp" android:hint="Amount" android:paddingHorizontal="4dp" android:inputType="numberDecimal"/>
                    </LinearLayout>
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvIncome"
                    android:layout_width="match_parent"
                    android:layout_height="400dp"
                    android:background="#FFFFFF"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="8dp"
                    android:gravity="end"
                    android:background="#F8F9FA">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Total:" android:textStyle="bold" android:textSize="12sp" android:layout_marginEnd="16dp"/>
                    <TextView android:id="@+id/tvTotalIncome" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.00" android:textStyle="bold" android:textSize="12sp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- EXPENDITURE SECTION -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:elevation="2dp"
                android:layout_marginStart="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:orientation="horizontal"
                    android:background="#F8F9FA"
                    android:paddingHorizontal="12dp"
                    android:gravity="center_vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="EXPENDITURE" android:textStyle="bold" android:textSize="14sp" android:textColor="#333333" android:gravity="center"/>
                </LinearLayout>

                <!-- Expenditure Table Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#E8EAED">

                    <LinearLayout
                        android:id="@+id/expenditureHeaderRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.2" android:text="GL HEAD" android:textSize="10sp" android:padding="8dp"/>
                        <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.0" android:text="ACCT ID" android:textSize="10sp" android:padding="8dp"/>
                        <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="2.0" android:text="ACCT NAME" android:textSize="10sp" android:padding="8dp"/>
                        <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="0.6" android:text="CUR" android:textSize="10sp" android:padding="8dp"/>
                        <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.0" android:text="AMOUNT" android:textSize="10sp" android:padding="8dp" android:gravity="end"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/llExpenditureFilters"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:visibility="gone"
                        android:paddingHorizontal="4dp"
                        android:paddingVertical="4dp">
                        <EditText android:id="@+id/etFilterExpGl" android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1.2" android:background="@drawable/edittext_background" android:textSize="10sp" android:hint="GL" android:paddingHorizontal="4dp" android:inputType="text"/>
                        <EditText android:id="@+id/etFilterExpId" android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1.0" android:background="@drawable/edittext_background" android:textSize="10sp" android:hint="Acct ID" android:paddingHorizontal="4dp" android:inputType="text"/>
                        <EditText android:id="@+id/etFilterExpName" android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="2.0" android:background="@drawable/edittext_background" android:textSize="10sp" android:hint="Name" android:paddingHorizontal="4dp" android:inputType="text"/>
                        <EditText android:id="@+id/etFilterExpCurrency" android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="0.6" android:background="@drawable/edittext_background" android:textSize="10sp" android:hint="Cur" android:paddingHorizontal="4dp" android:inputType="text"/>
                        <EditText android:id="@+id/etFilterExpAmount" android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1.0" android:background="@drawable/edittext_background" android:textSize="10sp" android:hint="Amount" android:paddingHorizontal="4dp" android:inputType="numberDecimal"/>
                    </LinearLayout>
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvExpenditure"
                    android:layout_width="match_parent"
                    android:layout_height="400dp"
                    android:background="#FFFFFF"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="8dp"
                    android:gravity="end"
                    android:background="#F8F9FA">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Total:" android:textStyle="bold" android:textSize="12sp" android:layout_marginEnd="16dp"/>
                    <TextView android:id="@+id/tvTotalExpenditure" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.00" android:textStyle="bold" android:textSize="12sp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Bottom Profit Info -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#FFFFFF"
        android:gravity="center"
        android:elevation="4dp">
        
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Report Status : " android:textStyle="bold" android:textSize="16sp" android:textColor="#333333"/>
            <TextView android:id="@+id/tvReportStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Profit" android:textStyle="bold" android:textSize="16sp" android:textColor="#4CAF50"/>
        </LinearLayout>

        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp">
            <TextView android:id="@+id/tvProfitAmountLabel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Profit Amount: " android:textStyle="bold" android:textSize="16sp" android:textColor="#333333"/>
            <TextView android:id="@+id/tvProfitAmount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.00" android:textStyle="bold" android:textSize="16sp" android:textColor="#333333"/>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
