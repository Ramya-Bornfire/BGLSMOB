<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

    <!-- SLEEK PROFESSIONAL HEADER (Single Row) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/header_bg"
        android:layout_marginTop="30dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:paddingHorizontal="24dp"
        android:elevation="8dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/arrow_back"
            android:padding="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/white"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ACCOUNT LEDGER POSTING"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:layout_centerInParent="true"/>

        <!-- Right Side Container (User Info + Buttons) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true">

            <!-- Vertical User Info -->
            <LinearLayout
                android:id="@+id/userInfoLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginEnd="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="65dp"
                        android:layout_height="wrap_content"
                        android:text="User ID"
                        android:textColor="#AACFFF"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=":"
                        android:textColor="#AACFFF"
                        android:textSize="10sp"
                        android:layout_marginEnd="4dp"/>
                    <TextView
                        android:id="@+id/txtUserIdInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="EMP04"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="2dp">
                    <TextView
                        android:layout_width="65dp"
                        android:layout_height="wrap_content"
                        android:text="User Name"
                        android:textColor="#AACFFF"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=":"
                        android:textColor="#AACFFF"
                        android:textSize="10sp"
                        android:layout_marginEnd="4dp"/>
                    <TextView
                        android:id="@+id/txtUserNameInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Manivanan"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="2dp">
                    <TextView
                        android:layout_width="65dp"
                        android:layout_height="wrap_content"
                        android:text="Login Time"
                        android:textColor="#AACFFF"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=":"
                        android:textColor="#AACFFF"
                        android:textSize="10sp"
                        android:layout_marginEnd="4dp"/>
                    <TextView
                        android:id="@+id/txtLoginTimeInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>

            <ImageView
                android:id="@+id/btnHome"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/home"
                android:padding="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/white"/>

        </LinearLayout>
    </RelativeLayout>

    <!-- Toolbar for actions (Filter) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end|center_vertical"
        android:padding="8dp"
        android:background="#E9ECEF">
        
        <Button
            android:id="@+id/btnFilter"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Filter"
            android:backgroundTint="#2196F3"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textAllCaps="false"
            android:minHeight="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"/>
    </LinearLayout>

    <!-- ─── TABLE: Header + Rows inside SAME HorizontalScrollView ─── -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="horizontal"
        android:descendantFocusability="blocksDescendants">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:minWidth="1200dp">

            <!-- Table Header -->
            <LinearLayout
                android:id="@+id/headerRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:minWidth="1200dp"
                android:background="#E8EAED">
                
                <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1" android:minWidth="100dp" android:background="@drawable/table_cell_bg" android:padding="12dp" android:text="TRAN DATE"/>
                <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1" android:minWidth="100dp" android:background="@drawable/table_cell_bg" android:padding="12dp" android:text="TRAN ID"/>
                <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1" android:minWidth="100dp" android:background="@drawable/table_cell_bg" android:padding="12dp" android:text="PA TRAN TY"/>
                <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="0.8" android:minWidth="80dp" android:background="@drawable/table_cell_bg" android:padding="12dp" android:text="CURRENCY"/>
                <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.2" android:minWidth="120dp" android:background="@drawable/table_cell_bg" android:padding="12dp" android:text="AMOUNT" android:gravity="end|center_vertical"/>
                <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1" android:minWidth="100dp" android:background="@drawable/table_cell_bg" android:padding="12dp" android:text="ACCT ID"/>
                <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.8" android:minWidth="180dp" android:background="@drawable/table_cell_bg" android:padding="12dp" android:text="ACCT NAME"/>
                <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="2.2" android:minWidth="220dp" android:background="@drawable/table_cell_bg" android:padding="12dp" android:text="TRAN PARTICULAR"/>
                <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="0.9" android:minWidth="90dp" android:background="@drawable/table_cell_bg" android:padding="12dp" android:text="STATUS"/>
                <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="0.8" android:minWidth="80dp" android:background="@drawable/table_cell_bg" android:padding="12dp" android:text="SELECT" android:gravity="center"/>
            </LinearLayout>

            <!-- Filter Row -->
            <LinearLayout
                android:id="@+id/filterRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:minWidth="1200dp"
                android:background="#E0E5E9"
                android:padding="2dp"
                android:visibility="gone">
                <EditText android:id="@+id/etFilterTranDate" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minWidth="100dp" android:hint="DATE" android:textSize="10sp" android:padding="4dp" android:background="@drawable/edittext_bg" android:layout_margin="1dp"/>
                <EditText android:id="@+id/etFilterTranId" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minWidth="100dp" android:hint="ID" android:textSize="10sp" android:padding="4dp" android:background="@drawable/edittext_bg" android:layout_margin="1dp"/>
                <EditText android:id="@+id/etFilterPaTranTy" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minWidth="100dp" android:hint="TYPE" android:textSize="10sp" android:padding="4dp" android:background="@drawable/edittext_bg" android:layout_margin="1dp"/>
                <EditText android:id="@+id/etFilterCurrency" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.8" android:minWidth="80dp" android:hint="CURR" android:textSize="10sp" android:padding="4dp" android:background="@drawable/edittext_bg" android:layout_margin="1dp"/>
                <EditText android:id="@+id/etFilterAmount" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.2" android:minWidth="120dp" android:hint="AMOUNT" android:textSize="10sp" android:padding="4dp" android:background="@drawable/edittext_bg" android:layout_margin="1dp"/>
                <EditText android:id="@+id/etFilterAcctId" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minWidth="100dp" android:hint="ACCT ID" android:textSize="10sp" android:padding="4dp" android:background="@drawable/edittext_bg" android:layout_margin="1dp"/>
                <EditText android:id="@+id/etFilterAcctName" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.8" android:minWidth="180dp" android:hint="NAME" android:textSize="10sp" android:padding="4dp" android:background="@drawable/edittext_bg" android:layout_margin="1dp"/>
                <EditText android:id="@+id/etFilterTranParticular" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2.2" android:minWidth="220dp" android:hint="PARTICULAR" android:textSize="10sp" android:padding="4dp" android:background="@drawable/edittext_bg" android:layout_margin="1dp"/>
                <EditText android:id="@+id/etFilterStatus" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.9" android:minWidth="90dp" android:hint="STATUS" android:textSize="10sp" android:padding="4dp" android:background="@drawable/edittext_bg" android:layout_margin="1dp"/>
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.8" android:minWidth="80dp" android:text="Action" android:gravity="center" android:textSize="10sp" android:textStyle="bold"/>
            </LinearLayout>

            <!-- Table Body -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvAccountLedger"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:minWidth="1200dp"
                android:background="#FFFFFF"/>
        </LinearLayout>
    </HorizontalScrollView>

</LinearLayout>
