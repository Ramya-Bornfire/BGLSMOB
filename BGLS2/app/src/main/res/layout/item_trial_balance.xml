<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:minWidth="910dp">

    <TextView android:id="@+id/tvGlCode"
        android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="0.8" android:minWidth="80dp"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:textSize="11sp" android:textColor="#2196F3"/>

    <TextView android:id="@+id/tvAccountName"
        android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="2.0" android:minWidth="200dp"
        android:padding="12dp"
        android:gravity="center_vertical"
        android:textSize="11sp" android:textColor="#333333"/>

    <TextView android:id="@+id/tvOpeningBal"
        android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1.5" android:minWidth="150dp"
        android:padding="12dp"
        android:gravity="center_vertical|end"
        android:textSize="11sp" android:textColor="#333333"/>

    <TextView android:id="@+id/tvCredit"
        android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1.2" android:minWidth="120dp"
        android:padding="12dp"
        android:gravity="center_vertical|end"
        android:textSize="11sp" android:textColor="#333333"/>

    <TextView android:id="@+id/tvDebit"
        android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1.2" android:minWidth="120dp"
        android:padding="12dp"
        android:gravity="center_vertical|end"
        android:textSize="11sp" android:textColor="#333333"/>

    <TextView android:id="@+id/tvNetChange"
        android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1.2" android:minWidth="120dp"
        android:padding="12dp"
        android:gravity="center_vertical|end"
        android:textSize="11sp" android:textColor="#333333"/>

    <TextView android:id="@+id/tvClosingBal"
        android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1.2" android:minWidth="120dp"
        android:padding="12dp"
        android:gravity="center_vertical|end"
        android:textSize="11sp" android:textColor="#333333"/>

</LinearLayout>
