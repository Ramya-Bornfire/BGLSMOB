<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/table_cell_bg">

    <TextView
        android:id="@+id/tvTranId"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.2"
        android:padding="4dp"
        android:text="TJ15O680BP"
        android:textSize="8sp"
        android:textColor="#333333"
        android:gravity="center_vertical"
        android:background="@drawable/table_cell_bg"/>

    <EditText
        android:id="@+id/etNames"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.0"
        android:padding="4dp"
        android:text=""
        android:textSize="8sp"
        android:textColor="#333333"
        android:gravity="center_vertical"
        android:background="@drawable/edittext_bg"
        android:hint="Name"
        android:singleLine="true"/>

    <EditText
        android:id="@+id/etReference"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.0"
        android:padding="4dp"
        android:text="22998710"
        android:textSize="8sp"
        android:textColor="#333333"
        android:gravity="center_vertical"
        android:background="@drawable/edittext_bg"
        android:hint="Ref"
        android:singleLine="true"/>

    <EditText
        android:id="@+id/etMobile"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.5"
        android:padding="4dp"
        android:text=""
        android:textSize="8sp"
        android:textColor="#333333"
        android:gravity="center_vertical"
        android:background="@drawable/edittext_bg"
        android:hint="Mobile"
        android:inputType="phone"
        android:singleLine="true"/>

    <TextView
        android:id="@+id/tvAmount"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.0"
        android:padding="4dp"
        android:text="14,000.00"
        android:textSize="8sp"
        android:textColor="#333333"
        android:gravity="end|center_vertical"
        android:background="@drawable/table_cell_bg"/>

    <TextView
        android:id="@+id/tvAllocatedAmt"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.0"
        android:padding="4dp"
        android:text="0.00"
        android:textSize="8sp"
        android:textColor="#333333"
        android:gravity="end|center_vertical"
        android:background="@drawable/table_cell_bg"/>

    <TextView
        android:id="@+id/tvTransTime"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.2"
        android:padding="4dp"
        android:text="01-10-2025"
        android:textSize="8sp"
        android:textColor="#333333"
        android:gravity="center_vertical"
        android:background="@drawable/table_cell_bg"/>

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.0"
        android:padding="4dp"
        android:text="UNALLOCATED"
        android:textSize="8sp"
        android:textColor="#333333"
        android:gravity="center"
        android:background="@drawable/table_cell_bg"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.8"
        android:gravity="center"
        android:background="@drawable/table_cell_bg">
        <RadioButton
            android:id="@+id/rbAccounts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleX="0.6"
            android:scaleY="0.6"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.8"
        android:gravity="center"
        android:background="@drawable/table_cell_bg">
        <RadioButton
            android:id="@+id/rbValues"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleX="0.6"
            android:scaleY="0.6"/>
    </LinearLayout>

</LinearLayout>
