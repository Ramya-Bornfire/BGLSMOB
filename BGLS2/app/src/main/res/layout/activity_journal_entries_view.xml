<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- SLEEK PROFESSIONAL HEADER (Single Row) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/header_bg"
        android:layout_marginTop="30dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:paddingHorizontal="24dp"
        android:elevation="8dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/arrow_back"
            android:padding="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/white"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="JOURNAL ENTRIES-VIEW"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:layout_centerInParent="true"/>

        <!-- Right Side Container (User Info + Buttons) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true">

            <!-- Vertical User Info -->
            <LinearLayout
                android:id="@+id/userInfoLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginEnd="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="65dp"
                        android:layout_height="wrap_content"
                        android:text="User ID"
                        android:textColor="#AACFFF"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=":"
                        android:textColor="#AACFFF"
                        android:textSize="10sp"
                        android:layout_marginEnd="4dp"/>
                    <TextView
                        android:id="@+id/txtUserIdInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="EMP04"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="2dp">
                    <TextView
                        android:layout_width="65dp"
                        android:layout_height="wrap_content"
                        android:text="User Name"
                        android:textColor="#AACFFF"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=":"
                        android:textColor="#AACFFF"
                        android:textSize="10sp"
                        android:layout_marginEnd="4dp"/>
                    <TextView
                        android:id="@+id/txtUserNameInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Manivanan"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="2dp">
                    <TextView
                        android:layout_width="65dp"
                        android:layout_height="wrap_content"
                        android:text="Login Time"
                        android:textColor="#AACFFF"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=":"
                        android:textColor="#AACFFF"
                        android:textSize="10sp"
                        android:layout_marginEnd="4dp"/>
                    <TextView
                        android:id="@+id/txtLoginTimeInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>

            <ImageView
                android:id="@+id/btnHome"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/home"
                android:padding="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/white"/>

        </LinearLayout>
    </RelativeLayout>

    <!-- Toolbar for actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end|center_vertical"
        android:padding="8dp"
        android:background="#E9ECEF">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Date"
            android:textSize="14sp"
            android:textColor="#333333"
            android:layout_marginEnd="8dp"/>
        <EditText
            android:layout_width="120dp"
            android:layout_height="32dp"
            android:background="@drawable/table_cell_bg"
            android:backgroundTint="#FFFFFF"
            android:text="27-04-2026"
            android:enabled="false"
            android:padding="6dp"
            android:gravity="center"
            android:textSize="12sp"
            android:textColor="#333333"
            android:layout_marginEnd="16dp"/>
        <Button
            android:id="@+id/btnView"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="VIEW"
            android:backgroundTint="#2196F3"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:minHeight="0dp"
            android:textAllCaps="false"/>
    </LinearLayout>
    <!-- After the header LinearLayout (before ScrollView) -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />
    <!-- Main Content Box (Always Visible) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.6"
        android:padding="16dp">
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/table_cell_bg"
            android:padding="24dp"
            android:gravity="center_horizontal">
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false">
                    
                    <!-- COLUMN 1 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="16dp">
                        
                        <!-- Rows -->
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                            <TextView android:layout_width="140dp" android:layout_height="wrap_content" android:text="Tran Id" android:textSize="11sp" android:textColor="#444444"/>
                            <EditText android:id="@+id/etTranId" android:layout_width="0dp" android:layout_height="28dp" android:layout_weight="1" android:background="@drawable/table_cell_bg" android:backgroundTint="#E8EAED" android:enabled="false" android:text="TR8798" android:paddingStart="8dp" android:textSize="11sp" android:textColor="#333333"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                            <TextView android:layout_width="140dp" android:layout_height="wrap_content" android:text="Acct ID" android:textSize="11sp" android:textColor="#444444"/>
                            <EditText android:id="@+id/etAcctId" android:layout_width="0dp" android:layout_height="28dp" android:layout_weight="1" android:background="@drawable/table_cell_bg" android:backgroundTint="#E8EAED" android:enabled="false" android:text="LA0019" android:paddingStart="8dp" android:textSize="11sp" android:textColor="#333333"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                            <TextView android:layout_width="140dp" android:layout_height="wrap_content" android:text="Tran Type" android:textSize="11sp" android:textColor="#444444"/>
                            <EditText android:id="@+id/etTranType" android:layout_width="0dp" android:layout_height="28dp" android:layout_weight="1" android:background="@drawable/table_cell_bg" android:backgroundTint="#E8EAED" android:enabled="false" android:text="TRANSFER" android:paddingStart="8dp" android:textSize="11sp" android:textColor="#333333"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                            <TextView android:layout_width="140dp" android:layout_height="wrap_content" android:text="Account Currency" android:textSize="11sp" android:textColor="#444444"/>
                            <EditText android:id="@+id/etAcctCurrency" android:layout_width="0dp" android:layout_height="28dp" android:layout_weight="1" android:background="@drawable/table_cell_bg" android:backgroundTint="#E8EAED" android:enabled="false" android:text="SCR" android:paddingStart="8dp" android:textSize="11sp" android:textColor="#333333"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                            <TextView android:layout_width="140dp" android:layout_height="wrap_content" android:text="Tran Particulars" android:textSize="11sp" android:textColor="#444444"/>
                            <EditText android:id="@+id/etTranParticulars" android:layout_width="0dp" android:layout_height="28dp" android:layout_weight="1" android:background="@drawable/table_cell_bg" android:backgroundTint="#E8EAED" android:enabled="false" android:text="LA0019 Loan Disbursement" android:paddingStart="8dp" android:textSize="11sp" android:textColor="#333333"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                            <TextView android:layout_width="140dp" android:layout_height="wrap_content" android:text="Flow Code" android:textSize="11sp" android:textColor="#444444"/>
                            <EditText android:id="@+id/etFlowCode" android:layout_width="0dp" android:layout_height="28dp" android:layout_weight="1" android:background="@drawable/table_cell_bg" android:backgroundTint="#E8EAED" android:enabled="false" android:text="DISBT" android:paddingStart="8dp" android:textSize="11sp" android:textColor="#333333"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                            <TextView android:layout_width="140dp" android:layout_height="wrap_content" android:text="Tran Date" android:textSize="11sp" android:textColor="#444444"/>
                            <EditText android:id="@+id/etTranDate" android:layout_width="0dp" android:layout_height="28dp" android:layout_weight="1" android:background="@drawable/table_cell_bg" android:backgroundTint="#E8EAED" android:enabled="false" android:text="27-04-2026" android:paddingStart="8dp" android:textSize="11sp" android:textColor="#333333"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                            <TextView android:layout_width="140dp" android:layout_height="wrap_content" android:text="Tran Code" android:textSize="11sp" android:textColor="#444444"/>
                            <EditText android:id="@+id/etTranCode" android:layout_width="0dp" android:layout_height="28dp" android:layout_weight="1" android:background="@drawable/table_cell_bg" android:backgroundTint="#E8EAED" android:enabled="false" android:paddingStart="8dp" android:textSize="11sp" android:textColor="#333333"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                            <TextView android:layout_width="140dp" android:layout_height="wrap_content" android:text="Tran Ref NO" android:textSize="11sp" android:textColor="#444444"/>
                            <EditText android:id="@+id/etTranRefNo" android:layout_width="0dp" android:layout_height="28dp" android:layout_weight="1" android:background="@drawable/table_cell_bg" android:backgroundTint="#E8EAED" android:enabled="false" android:paddingStart="8dp" android:textSize="11sp" android:textColor="#333333"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                            <TextView android:layout_width="140dp" android:layout_height="wrap_content" android:text="Partition Type" android:textSize="11sp" android:textColor="#444444"/>
                            <EditText android:id="@+id/etPartitionType" android:layout_width="0dp" android:layout_height="28dp" android:layout_weight="1" android:background="@drawable/table_cell_bg" android:backgroundTint="#E8EAED" android:enabled="false" android:paddingStart="8dp" android:textSize="11sp" android:textColor="#333333"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                            <TextView android:layout_width="140dp" android:layout_height="wrap_content" android:text="Instrument NO" android:textSize="11sp" android:textColor="#444444"/>
                            <EditText android:id="@+id/etInstrumentNo" android:layout_width="0dp" android:layout_height="28dp" android:layout_weight="1" android:background="@drawable/table_cell_bg" android:backgroundTint="#E8EAED" android:enabled="false" android:paddingStart="8dp" android:textSize="11sp" android:textColor="#333333"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                            <TextView android:layout_width="140dp" android:layout_height="wrap_content" android:text="Account Currency" android:textSize="11sp" android:textColor="#444444"/>
                            <EditText android:id="@+id/etAccountCurrency2" android:layout_width="0dp" android:layout_height="28dp" android:layout_weight="1" android:background="@drawable/table_cell_bg" android:backgroundTint="#E8EAED" android:enabled="false" android:paddingStart="8dp" android:textSize="11sp" android:textColor="#333333"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                            <TextView android:layout_width="140dp" android:layout_height="wrap_content" android:text="Rate Code" android:textSize="11sp" android:textColor="#444444"/>
                            <EditText android:id="@+id/etRateCode" android:layout_width="0dp" android:layout_height="28dp" android:layout_weight="1" android:background="@drawable/table_cell_bg" android:backgroundTint="#E8EAED" android:enabled="false" android:paddingStart="8dp" android:textSize="11sp" android:textColor="#333333"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                            <TextView android:layout_width="140dp" android:layout_height="wrap_content" android:text="Entry User" android:textSize="11sp" android:textColor="#444444"/>
                            <EditText android:id="@+id/etEntryUser" android:layout_width="0dp" android:layout_height="28dp" android:layout_weight="1" android:background="@drawable/table_cell_bg" android:backgroundTint="#E8EAED" android:enabled="false" android:text="EMP04" android:paddingStart="8dp" android:textSize="11sp" android:textColor="#333333"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                            <TextView android:layout_width="140dp" android:layout_height="wrap_content" android:text="Entry Time" android:textSize="11sp" android:textColor="#444444"/>
                            <EditText android:id="@+id/etEntryTime" android:layout_width="0dp" android:layout_height="28dp" android:layout_weight="1" android:background="@drawable/table_cell_bg" android:backgroundTint="#E8EAED" android:enabled="false" android:text="27-04-2026" android:paddingStart="8dp" android:textSize="11sp" android:textColor="#333333"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                            <TextView android:layout_width="140dp" android:layout_height="wrap_content" android:text="Tran Status" android:textSize="11sp" android:textColor="#444444"/>
                            <EditText android:id="@+id/etTranStatus" android:layout_width="0dp" android:layout_height="28dp" android:layout_weight="1" android:background="@drawable/table_cell_bg" android:backgroundTint="#E8EAED" android:enabled="false" android:text="ENTERED" android:paddingStart="8dp" android:textSize="11sp" android:textColor="#333333"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- COLUMN 2 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                            <TextView android:layout_width="140dp" android:layout_height="wrap_content" android:text="Part Tran Id" android:textSize="11sp" android:textColor="#444444"/>
                            <EditText android:id="@+id/etPartTranId" android:layout_width="0dp" android:layout_height="28dp" android:layout_weight="1" android:background="@drawable/table_cell_bg" android:backgroundTint="#E8EAED" android:enabled="false" android:text="1" android:paddingStart="8dp" android:textSize="11sp" android:textColor="#333333"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                            <TextView android:layout_width="140dp" android:layout_height="wrap_content" android:text="Acct Name" android:textSize="11sp" android:textColor="#444444"/>
                            <EditText android:id="@+id/etAcctName" android:layout_width="0dp" android:layout_height="28dp" android:layout_weight="1" android:background="@drawable/table_cell_bg" android:backgroundTint="#E8EAED" android:enabled="false" android:text="PRAKASH" android:paddingStart="8dp" android:textSize="11sp" android:textColor="#333333"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                            <TextView android:layout_width="140dp" android:layout_height="wrap_content" android:text="Part Tran Type" android:textSize="11sp" android:textColor="#444444"/>
                            <EditText android:id="@+id/etPartTranType" android:layout_width="0dp" android:layout_height="28dp" android:layout_weight="1" android:background="@drawable/table_cell_bg" android:backgroundTint="#E8EAED" android:enabled="false" android:text="Debit" android:paddingStart="8dp" android:textSize="11sp" android:textColor="#333333"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                            <TextView android:layout_width="140dp" android:layout_height="wrap_content" android:text="Tran Amt" android:textSize="11sp" android:textColor="#444444"/>
                            <EditText android:id="@+id/etTranAmt" android:layout_width="0dp" android:layout_height="28dp" android:layout_weight="1" android:background="@drawable/table_cell_bg" android:backgroundTint="#E8EAED" android:enabled="false" android:text="500,000.00" android:paddingStart="8dp" android:textSize="11sp" android:textColor="#333333"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                            <TextView android:layout_width="140dp" android:layout_height="wrap_content" android:text="Tran Remarks" android:textSize="11sp" android:textColor="#444444"/>
                            <EditText android:id="@+id/etTranRemarks" android:layout_width="0dp" android:layout_height="28dp" android:layout_weight="1" android:background="@drawable/table_cell_bg" android:backgroundTint="#E8EAED" android:enabled="false" android:text="LA0019 Loan Disbursement" android:paddingStart="8dp" android:textSize="11sp" android:textColor="#333333"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                            <TextView android:layout_width="140dp" android:layout_height="wrap_content" android:text="Flow Date" android:textSize="11sp" android:textColor="#444444"/>
                            <EditText android:id="@+id/etFlowDate" android:layout_width="0dp" android:layout_height="28dp" android:layout_weight="1" android:background="@drawable/table_cell_bg" android:backgroundTint="#E8EAED" android:enabled="false" android:text="27-04-2026" android:paddingStart="8dp" android:textSize="11sp" android:textColor="#333333"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                            <TextView android:layout_width="140dp" android:layout_height="wrap_content" android:text="Value Date" android:textSize="11sp" android:textColor="#444444"/>
                            <EditText android:id="@+id/etValueDate" android:layout_width="0dp" android:layout_height="28dp" android:layout_weight="1" android:background="@drawable/table_cell_bg" android:backgroundTint="#E8EAED" android:enabled="false" android:text="27-04-2026" android:paddingStart="8dp" android:textSize="11sp" android:textColor="#333333"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                            <TextView android:layout_width="140dp" android:layout_height="wrap_content" android:text="Tran Report Code" android:textSize="11sp" android:textColor="#444444"/>
                            <EditText android:id="@+id/etTranReportCode" android:layout_width="0dp" android:layout_height="28dp" android:layout_weight="1" android:background="@drawable/table_cell_bg" android:backgroundTint="#E8EAED" android:enabled="false" android:paddingStart="8dp" android:textSize="11sp" android:textColor="#333333"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                            <TextView android:layout_width="140dp" android:layout_height="wrap_content" android:text="Additional Details" android:textSize="11sp" android:textColor="#444444"/>
                            <EditText android:id="@+id/etAdditionalDetails" android:layout_width="0dp" android:layout_height="28dp" android:layout_weight="1" android:background="@drawable/table_cell_bg" android:backgroundTint="#E8EAED" android:enabled="false" android:paddingStart="8dp" android:textSize="11sp" android:textColor="#333333"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                            <TextView android:layout_width="140dp" android:layout_height="wrap_content" android:text="Partition Details" android:textSize="11sp" android:textColor="#444444"/>
                            <EditText android:id="@+id/etPartitionDetails" android:layout_width="0dp" android:layout_height="28dp" android:layout_weight="1" android:background="@drawable/table_cell_bg" android:backgroundTint="#E8EAED" android:enabled="false" android:paddingStart="8dp" android:textSize="11sp" android:textColor="#333333"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                            <TextView android:layout_width="140dp" android:layout_height="wrap_content" android:text="Instrument Date" android:textSize="11sp" android:textColor="#444444"/>
                            <EditText android:id="@+id/etInstrumentDate" android:layout_width="0dp" android:layout_height="28dp" android:layout_weight="1" android:background="@drawable/table_cell_bg" android:backgroundTint="#E8EAED" android:enabled="false" android:paddingStart="8dp" android:textSize="11sp" android:textColor="#333333"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                            <TextView android:layout_width="140dp" android:layout_height="wrap_content" android:text="Home Currency Amount" android:textSize="11sp" android:textColor="#444444"/>
                            <EditText android:id="@+id/etHomeCurrencyAmount" android:layout_width="0dp" android:layout_height="28dp" android:layout_weight="1" android:background="@drawable/table_cell_bg" android:backgroundTint="#E8EAED" android:enabled="false" android:paddingStart="8dp" android:textSize="11sp" android:textColor="#333333"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                            <TextView android:layout_width="140dp" android:layout_height="wrap_content" android:text="Rate" android:textSize="11sp" android:textColor="#444444"/>
                            <EditText android:id="@+id/etRate" android:layout_width="0dp" android:layout_height="28dp" android:layout_weight="1" android:background="@drawable/table_cell_bg" android:backgroundTint="#E8EAED" android:enabled="false" android:paddingStart="8dp" android:textSize="11sp" android:textColor="#333333"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                            <TextView android:layout_width="140dp" android:layout_height="wrap_content" android:text="Post User" android:textSize="11sp" android:textColor="#444444"/>
                            <EditText android:id="@+id/etPostUser" android:layout_width="0dp" android:layout_height="28dp" android:layout_weight="1" android:background="@drawable/table_cell_bg" android:backgroundTint="#E8EAED" android:enabled="false" android:paddingStart="8dp" android:textSize="11sp" android:textColor="#333333"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                            <TextView android:layout_width="140dp" android:layout_height="wrap_content" android:text="Post Time" android:textSize="11sp" android:textColor="#444444"/>
                            <EditText android:id="@+id/etPostTime" android:layout_width="0dp" android:layout_height="28dp" android:layout_weight="1" android:background="@drawable/table_cell_bg" android:backgroundTint="#E8EAED" android:enabled="false" android:paddingStart="8dp" android:textSize="11sp" android:textColor="#333333"/>
                        </LinearLayout>
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                            <TextView android:layout_width="140dp" android:layout_height="wrap_content" android:text="Deleted" android:textSize="11sp" android:textColor="#444444"/>
                            <EditText android:id="@+id/etDeleted" android:layout_width="0dp" android:layout_height="28dp" android:layout_weight="1" android:background="@drawable/table_cell_bg" android:backgroundTint="#E8EAED" android:enabled="false" android:text="N" android:paddingStart="8dp" android:textSize="11sp" android:textColor="#333333"/>
                        </LinearLayout>

                    </LinearLayout>
                </LinearLayout>
            
            <!-- Pagination inside the bordered box -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end|center_vertical"
                android:layout_marginTop="16dp">
                
                <Button android:id="@+id/btnPrev" android:layout_width="wrap_content" android:layout_height="36dp" android:text="Previous" android:backgroundTint="#007BFF" android:textColor="#FFFFFF" android:textSize="12sp" android:textAllCaps="false" android:minHeight="0dp" android:layout_marginEnd="8dp"/>
                <TextView android:id="@+id/tvPageInfo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1 / 8" android:textSize="12sp" android:layout_marginEnd="8dp"/>
                <Button android:id="@+id/btnNext" android:layout_width="wrap_content" android:layout_height="36dp" android:text="Next" android:backgroundTint="#007BFF" android:textColor="#FFFFFF" android:textSize="12sp" android:textAllCaps="false" android:minHeight="0dp"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- ─── RELATED ENTRIES TABLE ─── -->
    <LinearLayout
        android:id="@+id/layoutTableContainer"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:visibility="gone"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="8dp"
        android:backgroundTint="#FFFFFF"
        android:elevation="2dp">
        
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">
                
                <!-- Table Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="#E8EAED"
                    android:paddingVertical="8dp">
                    <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.1" android:text="TRAN DATE"/>
                    <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.0" android:text="TRAN ID"/>
                    <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="0.9" android:text="PA TRAN TY"/>
                    <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="0.8" android:text="CURRENCY"/>
                    <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.2" android:text="AMOUNT" android:gravity="end" android:paddingEnd="8dp"/>
                    <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.0" android:text="ACCT ID"/>
                    <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="2.0" android:text="ACCT NAME"/>
                    <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.0" android:text="STATUS"/>
                    <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="0.8" android:text="SELECT" android:gravity="center"/>
                </LinearLayout>
                
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvRelatedEntries"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#FFFFFF"/>
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

</LinearLayout>
