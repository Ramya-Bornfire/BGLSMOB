<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- ─── HEADER ROW ─── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"

        android:background="@drawable/header_bg"
        android:padding="10dp">

        <TextView
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="LOAN MAINTENANCE - LIST"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#333333"/>

        <!-- Filters Section -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Spinner
                android:id="@+id/spinnerFilter"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/spinner_background"
                android:minWidth="120dp"
                android:layout_marginEnd="8dp"/>

            <Spinner
                android:id="@+id/spinnerStatus"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/spinner_background"
                android:minWidth="130dp"
                android:layout_marginEnd="8dp"/>

            <Spinner
                android:id="@+id/spinnerVerified"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/spinner_background"
                android:minWidth="100dp"/>

        </LinearLayout>
    </LinearLayout>

    <!-- ─── TABLE CONTENT ─── -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="horizontal|vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="#FFFFFF">

            <!-- Table Header Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#E8EAED">

                <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="0.5" android:minWidth="50dp" android:text="S.NO" />
                <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="2.2" android:minWidth="200dp" android:text="LOAN ID" />
                <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.8" android:minWidth="160dp" android:text="LOAN TYPE" />
                <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="2.5" android:minWidth="220dp" android:text="LOAN NAME" />
                <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.2" android:minWidth="100dp" android:text="MOBILE NO" />
                <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.8" android:minWidth="160dp" android:text="RETAILER BRANCH ID" />
                <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.5" android:minWidth="140dp" android:text="Status" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewLoanMaintenance"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- ─── PAGINATION ─── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#FFFFFF"
        android:padding="10dp">

        <Button
            android:id="@+id/btnPrev"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="0dp"
            android:text="Prev"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2196F3"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginEnd="12dp"/>

        <TextView
            android:id="@+id/tvPageInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Page 1 of 14"
            android:textSize="13sp"
            android:textColor="#333333"
            android:layout_marginEnd="12dp"/>

        <Button
            android:id="@+id/btnNext"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="0dp"
            android:text="Next"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2196F3"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"/>
    </LinearLayout>

</LinearLayout>