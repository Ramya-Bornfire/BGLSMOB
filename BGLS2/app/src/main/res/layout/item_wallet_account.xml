<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="8dp"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/tvCategory"
        style="@style/tableCell"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.8"
        android:minWidth="60dp"
        android:text="Wallet"/>

    <TextView
        android:id="@+id/tvCustId"
        style="@style/tableCell"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.2"
        android:minWidth="100dp"
        android:text="CUST001"
        android:textColor="#007BFF"/>

    <TextView
        android:id="@+id/tvAccNo"
        style="@style/tableCell"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.0"
        android:minWidth="80dp"
        android:text="TD001"/>

    <TextView
        android:id="@+id/tvName"
        style="@style/tableCell"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.5"
        android:minWidth="120dp"
        android:text="Name"/>

    <TextView
        android:id="@+id/tvOpenDate"
        style="@style/tableCell"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.0"
        android:minWidth="80dp"
        android:text="01-01-2026"/>

    <TextView
        android:id="@+id/tvCloseDate"
        style="@style/tableCell"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.0"
        android:minWidth="80dp"
        android:text=""/>

    <TextView
        android:id="@+id/tvCurrency"
        style="@style/tableCell"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.8"
        android:minWidth="60dp"
        android:text="SCR"/>

    <TextView
        android:id="@+id/tvBalance"
        style="@style/tableCell"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.0"
        android:minWidth="80dp"
        android:text="0.00"
        android:gravity="end"
        android:paddingEnd="8dp"/>

    <TextView
        android:id="@+id/tvStatus"
        style="@style/tableCell"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.8"
        android:minWidth="70dp"
        android:text="Verified"
        android:textColor="#28A745"/>

    <RelativeLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.8"
        android:minWidth="60dp"
        android:gravity="center">
        <TextView
            android:id="@+id/rbSelect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Action"
            android:textColor="#007BFF"
            android:textSize="11sp"
            android:textStyle="normal"
            android:clickable="false"
            android:focusable="false"/>
    </RelativeLayout>
</LinearLayout>
