<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <TextView android:id="@+id/tvGlHead"
        android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1.2"
        android:padding="8dp"
        android:background="@drawable/table_cell_bg" android:gravity="center_vertical"
        android:textSize="10sp" android:textColor="#333333"/>

    <TextView android:id="@+id/tvAcctId"
        android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1.0"
        android:padding="8dp"
        android:background="@drawable/table_cell_bg" android:gravity="center_vertical"
        android:textSize="10sp" android:textColor="#333333"/>

    <TextView android:id="@+id/tvAcctName"
        android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="2.0"
        android:padding="8dp"
        android:background="@drawable/table_cell_bg" android:gravity="center_vertical"
        android:textSize="10sp" android:textColor="#333333"/>

    <TextView android:id="@+id/tvCurrency"
        android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="0.6"
        android:padding="8dp"
        android:background="@drawable/table_cell_bg" android:gravity="center_vertical"
        android:textSize="10sp" android:textColor="#333333"/>

    <TextView android:id="@+id/tvAmount"
        android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1.0"
        android:padding="8dp"
        android:background="@drawable/table_cell_bg" android:gravity="center_vertical|end"
        android:textSize="10sp" android:textColor="#333333"/>

</LinearLayout>
