<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/drawerLayout"
    android:background="#F5F7F9">

    <!-- MAIN SCREEN -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- HEADER AREA (Pro UI - Single Row) -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/header_bg"
            android:layout_marginTop="30dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:paddingHorizontal="24dp"
            android:elevation="8dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/arrow_back"
                android:padding="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/white"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CUSTOMER MAINTENANCE - LIST"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_centerInParent="true"/>

            <!-- Right Side Container (User Info + Buttons) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true">

                <!-- Vertical User Info -->
                <LinearLayout
                    android:id="@+id/userInfoLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginEnd="24dp">

                    <!-- User ID -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="75dp"
                            android:layout_height="wrap_content"
                            android:text="User ID"
                            android:textColor="#AACFFF"
                            android:textSize="12sp"
                            android:textStyle="bold"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=":"
                            android:textColor="#AACFFF"
                            android:textSize="12sp"
                            android:layout_marginEnd="8dp"/>
                        <TextView
                            android:id="@+id/txtUserId"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="EMP04"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <!-- User Name -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="2dp">
                        <TextView
                            android:layout_width="75dp"
                            android:layout_height="wrap_content"
                            android:text="User Name"
                            android:textColor="#AACFFF"
                            android:textSize="12sp"
                            android:textStyle="bold"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=":"
                            android:textColor="#AACFFF"
                            android:textSize="12sp"
                            android:layout_marginEnd="8dp"/>
                        <TextView
                            android:id="@+id/txtUserName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Manivanan"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <!-- Login Time -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="2dp">
                        <TextView
                            android:layout_width="75dp"
                            android:layout_height="wrap_content"
                            android:text="Login Time"
                            android:textColor="#AACFFF"
                            android:textSize="12sp"
                            android:textStyle="bold"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=":"
                            android:textColor="#AACFFF"
                            android:textSize="12sp"
                            android:layout_marginEnd="8dp"/>
                        <TextView
                            android:id="@+id/txtLoginTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:textStyle="bold"/>
                    </LinearLayout>
                </LinearLayout>

                <ImageView
                    android:id="@+id/btnDownload"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@android:drawable/stat_sys_download"
                    android:padding="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="@color/white"
                    android:layout_marginEnd="8dp"/>

                <ImageView
                    android:id="@+id/btnHome"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/home"
                    android:padding="8dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="@color/white"/>

            </LinearLayout>
        </RelativeLayout>

        <!-- FILTERS & ACTIONS (Above table) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:gravity="end|center_vertical"
            android:background="#F5F7F9">

            <Spinner
                android:id="@+id/spinnerFilter"
                android:layout_width="120dp"
                android:layout_height="34dp"
                android:background="@drawable/spinner_background"
                android:layout_marginEnd="8dp"/>

            <Spinner
                android:id="@+id/spinnerStatus"
                android:layout_width="120dp"
                android:layout_height="34dp"
                android:background="@drawable/spinner_background"
                android:layout_marginEnd="8dp"/>

            <Spinner
                android:id="@+id/spinnerAll"
                android:layout_width="100dp"
                android:layout_height="34dp"
                android:background="@drawable/spinner_background"
                android:layout_marginEnd="8dp"/>
        </LinearLayout>

        <!-- TABLE SECTION -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="horizontal"
            android:descendantFocusability="blocksDescendants">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:minWidth="1080dp">

                <!-- DUAL HEADER: Default vs Filter Row -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- 1. Default Table Header (TextViews) -->
                    <LinearLayout
                        android:id="@+id/layoutDefaultHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="#E8EAED"
                        android:visibility="visible">

                        <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.6" android:minWidth="60dp" android:background="@drawable/table_cell_bg" android:padding="12dp" android:text="S.NO"/>
                        <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.5" android:minWidth="140dp" android:background="@drawable/table_cell_bg" android:padding="12dp" android:text="CUSTOMER ID"/>
                        <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2.2" android:minWidth="200dp" android:background="@drawable/table_cell_bg" android:padding="12dp" android:text="CUSTOMER NAME"/>
                        <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.2" android:minWidth="100dp" android:background="@drawable/table_cell_bg" android:padding="12dp" android:text="DOB"/>
                        <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.8" android:minWidth="160dp" android:background="@drawable/table_cell_bg" android:padding="12dp" android:text="BRANCH NAME"/>
                        <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.5" android:minWidth="130dp" android:background="@drawable/table_cell_bg" android:padding="12dp" android:text="Mobile No"/>
                        <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2.2" android:minWidth="200dp" android:background="@drawable/table_cell_bg" android:padding="12dp" android:text="Email"/>
                        <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minWidth="90dp" android:background="@drawable/table_cell_bg" android:padding="12dp" android:text="STATUS"/>
                    </LinearLayout>

                    <!-- 2. Filter Table Header (EditTexts) -->
                    <LinearLayout
                        android:id="@+id/layoutFilterHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="#E8EAED"
                        android:visibility="gone">

                        <EditText android:id="@+id/etFilterSrNo" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.6" android:minWidth="60dp" android:background="@drawable/table_cell_bg" android:padding="8dp" android:hint="No" android:textSize="11sp" android:singleLine="true"/>
                        <EditText android:id="@+id/etFilterCustomerId" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.5" android:minWidth="140dp" android:background="@drawable/table_cell_bg" android:padding="8dp" android:hint="ID" android:textSize="11sp" android:singleLine="true"/>
                        <EditText android:id="@+id/etFilterCustomerName" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2.2" android:minWidth="200dp" android:background="@drawable/table_cell_bg" android:padding="8dp" android:hint="Name" android:textSize="11sp" android:singleLine="true"/>
                        <EditText android:id="@+id/etFilterDob" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.2" android:minWidth="100dp" android:background="@drawable/table_cell_bg" android:padding="8dp" android:hint="DOB" android:textSize="11sp" android:singleLine="true"/>
                        <EditText android:id="@+id/etFilterBranchName" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.8" android:minWidth="160dp" android:background="@drawable/table_cell_bg" android:padding="8dp" android:hint="Branch" android:textSize="11sp" android:singleLine="true"/>
                        <EditText android:id="@+id/etFilterMobileNo" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.5" android:minWidth="130dp" android:background="@drawable/table_cell_bg" android:padding="8dp" android:hint="Mobile" android:textSize="11sp" android:singleLine="true"/>
                        <EditText android:id="@+id/etFilterEmail" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2.2" android:minWidth="200dp" android:background="@drawable/table_cell_bg" android:padding="8dp" android:hint="Email" android:textSize="11sp" android:singleLine="true"/>
                        <EditText android:id="@+id/etFilterStatus" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minWidth="90dp" android:background="@drawable/table_cell_bg" android:padding="8dp" android:hint="Status" android:textSize="11sp" android:singleLine="true"/>
                    </LinearLayout>
                </FrameLayout>

                <!-- TABLE ROWS -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerViewCustomerMaintenance"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:minWidth="1080dp"
                    android:background="#FFFFFF"/>

            </LinearLayout>
        </HorizontalScrollView>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E0E0E0"/>

        <!-- BOTTOM AREA: PAGINATION ONLY -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:elevation="12dp"
            android:gravity="center">

            <!-- PAGINATION -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/btnPrev"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:minWidth="0dp"
                    android:text="Prev"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#1976D2"
                    android:paddingHorizontal="16dp"
                    android:layout_marginEnd="16dp"/>

                <TextView
                    android:id="@+id/tvPageInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Page 1 of 11"
                    android:textSize="14sp"
                    android:textColor="#333333"
                    android:textStyle="bold"
                    android:layout_marginEnd="16dp"/>

                <Button
                    android:id="@+id/btnNext"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:minWidth="0dp"
                    android:text="Next"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#1976D2"
                    android:paddingHorizontal="16dp"/>
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- SIDE MENU -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:menu="@menu/drawer_menu"
        android:background="@color/lite" />

</androidx.drawerlayout.widget.DrawerLayout>