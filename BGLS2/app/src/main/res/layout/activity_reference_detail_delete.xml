<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F2F2F2">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- TOP HEADER -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/header_bg"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/btnBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/arrow_back"
                    android:contentDescription="Back"
                    android:scaleType="centerInside" />

                <TextView
                    android:id="@+id/toolbarTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="REFERENCE CODE MAINTENANCE - DELETE"
                    android:textColor="@android:color/white"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:gravity="center" />
                <Button
                    android:id="@+id/btnUpdate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Delete"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#2196F3" />


            </LinearLayout>

        </androidx.appcompat.widget.Toolbar>

        <!-- MAIN CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- ROW 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/ref"
                    android:layout_width="130dp"
                    android:layout_height="wrap_content"
                    android:text="Reference Type"
                    android:textSize="13sp"
                    android:textColor="#555555" />

                <Spinner
                    android:id="@+id/spRefType"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/edittext_background"/>

                <View
                    android:layout_width="16dp"
                    android:layout_height="1dp" />

                <TextView
                    android:id="@+id/type"
                    android:layout_width="130dp"
                    android:layout_height="wrap_content"
                    android:text="Type Descriptions"
                    android:textSize="13sp"
                    android:textColor="#555555" />

                <EditText
                    android:id="@+id/ettype"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/edittext_background"
                    android:padding="8dp"
                    />
            </LinearLayout>

            <!-- ROW 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/refid"
                    android:layout_width="130dp"
                    android:layout_height="wrap_content"
                    android:text="Reference Id"
                    android:textSize="13sp"
                    android:textColor="#555555" />

                <EditText
                    android:id="@+id/etrefid"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/edittext_background"
                    android:padding="8dp" />

                <View
                    android:layout_width="16dp"
                    android:layout_height="1dp" />

                <TextView
                    android:id="@+id/refdes"
                    android:layout_width="130dp"
                    android:layout_height="wrap_content"
                    android:text="Reference Descriptions"
                    android:textSize="13sp"
                    android:textColor="#555555" />

                <EditText
                    android:id="@+id/etrefdes"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/edittext_background"
                    android:padding="8dp" />
            </LinearLayout>

            <!-- ROW 3 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/mod"
                    android:layout_width="130dp"
                    android:layout_height="wrap_content"
                    android:text="Module"
                    android:textSize="13sp"
                    android:textColor="#555555" />

                <EditText
                    android:id="@+id/etmod"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/edittext_background"
                    android:padding="8dp" />

                <View
                    android:layout_width="16dp"
                    android:layout_height="1dp" />

                <TextView
                    android:id="@+id/remark"
                    android:layout_width="130dp"
                    android:layout_height="wrap_content"
                    android:text="Remarks"
                    android:textSize="13sp"
                    android:textColor="#555555" />

                <EditText
                    android:id="@+id/etremark"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/edittext_background"
                    android:padding="8dp"/>
            </LinearLayout>


        </LinearLayout>

    </LinearLayout>

</ScrollView>