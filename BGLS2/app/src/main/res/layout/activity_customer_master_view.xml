<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- SLEEK PROFESSIONAL HEADER (Single Row) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/header_bg"
        android:layout_marginTop="30dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:paddingHorizontal="24dp"
        android:elevation="8dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/arrow_back"
            android:padding="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/white"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CUSTOMER MASTER - VIEW"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:layout_centerInParent="true"/>

        <!-- Right Side Container (User Info + Buttons) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true">

            <!-- Vertical User Info -->
            <LinearLayout
                android:id="@+id/userInfoLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginEnd="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="65dp"
                        android:layout_height="wrap_content"
                        android:text="User ID"
                        android:textColor="#AACFFF"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=":"
                        android:textColor="#AACFFF"
                        android:textSize="10sp"
                        android:layout_marginEnd="4dp"/>
                    <TextView
                        android:id="@+id/txtUserIdInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="EMP04"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="2dp">
                    <TextView
                        android:layout_width="65dp"
                        android:layout_height="wrap_content"
                        android:text="User Name"
                        android:textColor="#AACFFF"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=":"
                        android:textColor="#AACFFF"
                        android:textSize="10sp"
                        android:layout_marginEnd="4dp"/>
                    <TextView
                        android:id="@+id/txtUserNameInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Manivanan"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="2dp">
                    <TextView
                        android:layout_width="65dp"
                        android:layout_height="wrap_content"
                        android:text="Login Time"
                        android:textColor="#AACFFF"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=":"
                        android:textColor="#AACFFF"
                        android:textSize="10sp"
                        android:layout_marginEnd="4dp"/>
                    <TextView
                        android:id="@+id/txtLoginTimeInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>

            <ImageView
                android:id="@+id/btnHome"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/home"
                android:padding="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/white"/>

        </LinearLayout>
    </RelativeLayout>

    <!-- Toolbar for actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end|center_vertical"
        android:padding="8dp"
        android:background="#E9ECEF">

        <Button
            android:id="@+id/btnAccountDetails"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Account Details"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2196F3"
            android:textAllCaps="false"/>
    </LinearLayout>

    <!-- Progress indicator while fetching full customer detail -->
    <ProgressBar
        android:id="@+id/progressBarView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"
        android:indeterminate="true"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"/>

    <!-- ─── FORM (read-only) ─── -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp">

            <!-- ─── ROW 1: Customer Id | Customer Name ─── -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="12dp"
                android:gravity="center_vertical">

                <TextView android:layout_width="160dp" android:layout_height="wrap_content"
                    android:text="Customer Id" android:textSize="13sp" android:textColor="#444444"/>
                <EditText android:id="@+id/etCustomerId"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:background="@drawable/edittext_background"
                    android:paddingStart="8dp" android:paddingEnd="8dp"
                    android:paddingTop="6dp" android:paddingBottom="6dp"
                    android:textSize="13sp" android:textColor="#333333"
                    android:enabled="false"/>

                <View android:layout_width="24dp" android:layout_height="1dp"/>

                <TextView android:layout_width="160dp" android:layout_height="wrap_content"
                    android:text="Customer Name" android:textSize="13sp" android:textColor="#444444"/>
                <EditText android:id="@+id/etCustomerName"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:background="@drawable/edittext_background"
                    android:paddingStart="8dp" android:paddingEnd="8dp"
                    android:paddingTop="6dp" android:paddingBottom="6dp"
                    android:textSize="13sp" android:textColor="#333333"
                    android:enabled="false"/>
            </LinearLayout>

            <!-- ─── ROW 2: First Name | Last Name ─── -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="12dp"
                android:gravity="center_vertical">

                <TextView android:layout_width="160dp" android:layout_height="wrap_content"
                    android:text="First Name" android:textSize="13sp" android:textColor="#444444"/>
                <EditText android:id="@+id/etFirstName"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:background="@drawable/edittext_background"
                    android:paddingStart="8dp" android:paddingEnd="8dp"
                    android:paddingTop="6dp" android:paddingBottom="6dp"
                    android:textSize="13sp" android:textColor="#333333"
                    android:enabled="false"/>

                <View android:layout_width="24dp" android:layout_height="1dp"/>

                <TextView android:layout_width="160dp" android:layout_height="wrap_content"
                    android:text="Last Name" android:textSize="13sp" android:textColor="#444444"/>
                <EditText android:id="@+id/etLastName"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:background="@drawable/edittext_background"
                    android:paddingStart="8dp" android:paddingEnd="8dp"
                    android:paddingTop="6dp" android:paddingBottom="6dp"
                    android:textSize="13sp" android:textColor="#333333"
                    android:enabled="false"/>
            </LinearLayout>

            <!-- ─── ROW 3: Gender | Date of Birth ─── -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="12dp"
                android:gravity="center_vertical">

                <TextView android:layout_width="160dp" android:layout_height="wrap_content"
                    android:text="Gender" android:textSize="13sp" android:textColor="#444444"/>
                <EditText android:id="@+id/etGender"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:background="@drawable/edittext_background"
                    android:paddingStart="8dp" android:paddingEnd="8dp"
                    android:paddingTop="6dp" android:paddingBottom="6dp"
                    android:textSize="13sp" android:textColor="#333333"
                    android:enabled="false"/>

                <View android:layout_width="24dp" android:layout_height="1dp"/>

                <TextView android:layout_width="160dp" android:layout_height="wrap_content"
                    android:text="Date of Birth" android:textSize="13sp" android:textColor="#444444"/>
                <EditText android:id="@+id/etDateOfBirth"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:background="@drawable/edittext_background"
                    android:paddingStart="8dp" android:paddingEnd="8dp"
                    android:paddingTop="6dp" android:paddingBottom="6dp"
                    android:textSize="13sp" android:textColor="#333333"
                    android:enabled="false"/>
            </LinearLayout>

            <!-- ─── ROW 4: Branch | Client Role Key ─── -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="12dp"
                android:gravity="center_vertical">

                <TextView android:layout_width="160dp" android:layout_height="wrap_content"
                    android:text="Branch" android:textSize="13sp" android:textColor="#444444"/>
                <EditText android:id="@+id/etBranch"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:background="@drawable/edittext_background"
                    android:paddingStart="8dp" android:paddingEnd="8dp"
                    android:paddingTop="6dp" android:paddingBottom="6dp"
                    android:textSize="13sp" android:textColor="#333333"
                    android:enabled="false"/>

                <View android:layout_width="24dp" android:layout_height="1dp"/>

                <TextView android:layout_width="160dp" android:layout_height="wrap_content"
                    android:text="Client Role Key" android:textSize="13sp" android:textColor="#444444"/>
                <EditText android:id="@+id/etClientRoleKey"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:background="@drawable/edittext_background"
                    android:paddingStart="8dp" android:paddingEnd="8dp"
                    android:paddingTop="6dp" android:paddingBottom="6dp"
                    android:textSize="13sp" android:textColor="#333333"
                    android:enabled="false"/>
            </LinearLayout>

            <!-- ─── ROW 5: Creation Date | Approval Date ─── -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="12dp"
                android:gravity="center_vertical">

                <TextView android:layout_width="160dp" android:layout_height="wrap_content"
                    android:text="Creation Date" android:textSize="13sp" android:textColor="#444444"/>
                <EditText android:id="@+id/etCreationDate"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:background="@drawable/edittext_background"
                    android:paddingStart="8dp" android:paddingEnd="8dp"
                    android:paddingTop="6dp" android:paddingBottom="6dp"
                    android:textSize="13sp" android:textColor="#333333"
                    android:enabled="false"/>

                <View android:layout_width="24dp" android:layout_height="1dp"/>

                <TextView android:layout_width="160dp" android:layout_height="wrap_content"
                    android:text="Approval Date" android:textSize="13sp" android:textColor="#444444"/>
                <EditText android:id="@+id/etApprovalDate"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:background="@drawable/edittext_background"
                    android:paddingStart="8dp" android:paddingEnd="8dp"
                    android:paddingTop="6dp" android:paddingBottom="6dp"
                    android:textSize="13sp" android:textColor="#333333"
                    android:enabled="false"/>
            </LinearLayout>

            <!-- ─── ROW 6: Last Modification Date | Activation Date ─── -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="12dp"
                android:gravity="center_vertical">

                <TextView android:layout_width="160dp" android:layout_height="wrap_content"
                    android:text="Last Modification Date" android:textSize="13sp" android:textColor="#444444"/>
                <EditText android:id="@+id/etLastModificationDate"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:background="@drawable/edittext_background"
                    android:paddingStart="8dp" android:paddingEnd="8dp"
                    android:paddingTop="6dp" android:paddingBottom="6dp"
                    android:textSize="13sp" android:textColor="#333333"
                    android:enabled="false"/>

                <View android:layout_width="24dp" android:layout_height="1dp"/>

                <TextView android:layout_width="160dp" android:layout_height="wrap_content"
                    android:text="Activation Date" android:textSize="13sp" android:textColor="#444444"/>
                <EditText android:id="@+id/etActivationDate"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:background="@drawable/edittext_background"
                    android:paddingStart="8dp" android:paddingEnd="8dp"
                    android:paddingTop="6dp" android:paddingBottom="6dp"
                    android:textSize="13sp" android:textColor="#333333"
                    android:enabled="false"/>
            </LinearLayout>

            <!-- ─── ROW 7: Mobile No | Email Id ─── -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="12dp"
                android:gravity="center_vertical">

                <TextView android:layout_width="160dp" android:layout_height="wrap_content"
                    android:text="Mobile No" android:textSize="13sp" android:textColor="#444444"/>
                <EditText android:id="@+id/etMobileNo"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:background="@drawable/edittext_background"
                    android:paddingStart="8dp" android:paddingEnd="8dp"
                    android:paddingTop="6dp" android:paddingBottom="6dp"
                    android:textSize="13sp" android:textColor="#333333"
                    android:enabled="false"/>

                <View android:layout_width="24dp" android:layout_height="1dp"/>

                <TextView android:layout_width="160dp" android:layout_height="wrap_content"
                    android:text="Email Id" android:textSize="13sp" android:textColor="#444444"/>
                <EditText android:id="@+id/etEmailId"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:background="@drawable/edittext_background"
                    android:paddingStart="8dp" android:paddingEnd="8dp"
                    android:paddingTop="6dp" android:paddingBottom="6dp"
                    android:textSize="13sp" android:textColor="#333333"
                    android:enabled="false"/>
            </LinearLayout>

            <!-- ─── ROW 8: Address 1 | Address 2 ─── -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="12dp"
                android:gravity="center_vertical">

                <TextView android:layout_width="160dp" android:layout_height="wrap_content"
                    android:text="Address 1" android:textSize="13sp" android:textColor="#444444"/>
                <EditText android:id="@+id/etAddress1"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:background="@drawable/edittext_background"
                    android:paddingStart="8dp" android:paddingEnd="8dp"
                    android:paddingTop="6dp" android:paddingBottom="6dp"
                    android:textSize="13sp" android:textColor="#333333"
                    android:enabled="false"/>

                <View android:layout_width="24dp" android:layout_height="1dp"/>

                <TextView android:layout_width="160dp" android:layout_height="wrap_content"
                    android:text="Address 2" android:textSize="13sp" android:textColor="#444444"/>
                <EditText android:id="@+id/etAddress2"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:background="@drawable/edittext_background"
                    android:paddingStart="8dp" android:paddingEnd="8dp"
                    android:paddingTop="6dp" android:paddingBottom="6dp"
                    android:textSize="13sp" android:textColor="#333333"
                    android:enabled="false"/>
            </LinearLayout>

            <!-- ─── ROW 9: City | Suburb ─── -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="12dp"
                android:gravity="center_vertical">

                <TextView android:layout_width="160dp" android:layout_height="wrap_content"
                    android:text="City" android:textSize="13sp" android:textColor="#444444"/>
                <EditText android:id="@+id/etCity"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:background="@drawable/edittext_background"
                    android:paddingStart="8dp" android:paddingEnd="8dp"
                    android:paddingTop="6dp" android:paddingBottom="6dp"
                    android:textSize="13sp" android:textColor="#333333"
                    android:enabled="false"/>

                <View android:layout_width="24dp" android:layout_height="1dp"/>

                <TextView android:layout_width="160dp" android:layout_height="wrap_content"
                    android:text="Suburb" android:textSize="13sp" android:textColor="#444444"/>
                <EditText android:id="@+id/etSuburb"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:background="@drawable/edittext_background"
                    android:paddingStart="8dp" android:paddingEnd="8dp"
                    android:paddingTop="6dp" android:paddingBottom="6dp"
                    android:textSize="13sp" android:textColor="#333333"
                    android:enabled="false"/>
            </LinearLayout>

            <!-- ─── ROW 10: Loan Cycle | Group Loan Cycle ─── -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="12dp"
                android:gravity="center_vertical">

                <TextView android:layout_width="160dp" android:layout_height="wrap_content"
                    android:text="Loan Cycle" android:textSize="13sp" android:textColor="#444444"/>
                <EditText android:id="@+id/etLoanCycle"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:background="@drawable/edittext_background"
                    android:paddingStart="8dp" android:paddingEnd="8dp"
                    android:paddingTop="6dp" android:paddingBottom="6dp"
                    android:textSize="13sp" android:textColor="#333333"
                    android:enabled="false"/>

                <View android:layout_width="24dp" android:layout_height="1dp"/>

                <TextView android:layout_width="160dp" android:layout_height="wrap_content"
                    android:text="Group Loan Cycle" android:textSize="13sp" android:textColor="#444444"/>
                <EditText android:id="@+id/etGroupLoanCycle"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:background="@drawable/edittext_background"
                    android:paddingStart="8dp" android:paddingEnd="8dp"
                    android:paddingTop="6dp" android:paddingBottom="6dp"
                    android:textSize="13sp" android:textColor="#333333"
                    android:enabled="false"/>
            </LinearLayout>

            <!-- ─── ROW 11: Assigned User | As On Date ─── -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView android:layout_width="160dp" android:layout_height="wrap_content"
                    android:text="Assigned User" android:textSize="13sp" android:textColor="#444444"/>
                <EditText android:id="@+id/etAssignedUser"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:background="@drawable/edittext_background"
                    android:paddingStart="8dp" android:paddingEnd="8dp"
                    android:paddingTop="6dp" android:paddingBottom="6dp"
                    android:textSize="13sp" android:textColor="#333333"
                    android:enabled="false"/>

                <View android:layout_width="24dp" android:layout_height="1dp"/>

                <TextView android:layout_width="160dp" android:layout_height="wrap_content"
                    android:text="As On Date" android:textSize="13sp" android:textColor="#444444"/>
                <EditText android:id="@+id/etAsOnDate"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:background="@drawable/edittext_background"
                    android:paddingStart="8dp" android:paddingEnd="8dp"
                    android:paddingTop="6dp" android:paddingBottom="6dp"
                    android:textSize="13sp" android:textColor="#333333"
                    android:enabled="false"/>
            </LinearLayout>

            <!-- ─── ACCOUNT DETAILS TABLE (Hidden by default) ─── -->
            <LinearLayout
                android:id="@+id/layoutAccountDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="20dp"
                android:visibility="gone">

                <!-- Progress for account details fetch -->
                <ProgressBar
                    android:id="@+id/progressBarAccDet"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:visibility="gone"
                    android:indeterminate="true"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"/>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fillViewport="true"
                    android:scrollbars="horizontal">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- HEADER ROW -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="2.5" android:minWidth="140dp" android:text="Account ID"/>
                            <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="2.5" android:minWidth="180dp" android:text="Account Name"/>
                            <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.5" android:minWidth="110dp" android:text="Date of Loan"/>
                            <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.5" android:minWidth="110dp" android:gravity="center_vertical|end" android:text="Loan Amount"/>
                            <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.5" android:minWidth="110dp" android:gravity="center_vertical|end" android:text="Loan Balance"/>
                        </LinearLayout>

                        <!-- DATA LIST -->
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/recyclerViewAccountDetails"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="#FFFFFF" />

                    </LinearLayout>
                </HorizontalScrollView>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>


