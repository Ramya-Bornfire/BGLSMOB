<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#ffffff">

    <!-- HEADER -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/header_bg"
        android:layout_marginTop="30dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:paddingHorizontal="16dp"
        android:elevation="8dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/arrow_back"
            android:padding="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/white"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ACCOUNT LEDGER"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_centerInParent="true"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true">

            <LinearLayout
                android:id="@+id/userInfoLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginEnd="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="65dp"
                        android:layout_height="wrap_content"
                        android:text="User ID"
                        android:textColor="#AACFFF"
                        android:textSize="9sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=":"
                        android:textColor="#AACFFF"
                        android:textSize="9sp"
                        android:layout_marginEnd="4dp"/>
                    <TextView
                        android:id="@+id/txtUserIdInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="EMP04"
                        android:textColor="@color/white"
                        android:textSize="9sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="2dp">
                    <TextView
                        android:layout_width="65dp"
                        android:layout_height="wrap_content"
                        android:text="User Name"
                        android:textColor="#AACFFF"
                        android:textSize="9sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=":"
                        android:textColor="#AACFFF"
                        android:textSize="9sp"
                        android:layout_marginEnd="4dp"/>
                    <TextView
                        android:id="@+id/txtUserNameInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Manivanan"
                        android:textColor="@color/white"
                        android:textSize="9sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="2dp">
                    <TextView
                        android:layout_width="65dp"
                        android:layout_height="wrap_content"
                        android:text="Login Time"
                        android:textColor="#AACFFF"
                        android:textSize="9sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=":"
                        android:textColor="#AACFFF"
                        android:textSize="9sp"
                        android:layout_marginEnd="4dp"/>
                    <TextView
                        android:id="@+id/txtLoginTimeInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textColor="@color/white"
                        android:textSize="9sp"
                        android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>

            <ImageView
                android:id="@+id/btnHome"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/home"
                android:padding="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/white"/>

        </LinearLayout>
    </RelativeLayout>

    <!-- TOOLBAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end|center_vertical"
        android:padding="8dp"
        android:background="#E9ECEF">
        <Button
            android:id="@+id/btnFilter"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="Filter"
            android:textSize="11sp"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2196F3"
            android:paddingHorizontal="20dp"/>
    </LinearLayout>

    <!-- PROGRESS & NO DATA -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/tvNoData"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No accounts found"
        android:textSize="14sp"
        android:textColor="#999999"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="gone"/>

    <!-- MAIN CONTENT -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="horizontal">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:minWidth="1200dp">

            <!-- HEADER ROW -->
            <LinearLayout
                android:id="@+id/headerRow"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:orientation="horizontal"
                android:background="#E9ECEF"
                android:gravity="center_vertical">

                <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="0.8" android:minWidth="80dp" android:text="HEAD" android:textColor="@color/black" android:textSize="12sp"/>
                <View android:layout_width="1dp" android:layout_height="24dp" android:background="#FFFFFF"/>
                <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.2" android:minWidth="120dp" android:text="ACCT ID" android:textColor="@color/black" android:textSize="12sp"/>
                <View android:layout_width="1dp" android:layout_height="24dp" android:background="#FFFFFF"/>
                <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="2.0" android:minWidth="200dp" android:text="ACCT NAME" android:textColor="@color/black" android:textSize="12sp"/>
                <View android:layout_width="1dp" android:layout_height="24dp" android:background="#FFFFFF"/>
                <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="0.6" android:minWidth="60dp" android:text="CUR" android:textColor="@color/black" android:textSize="12sp"/>
                <View android:layout_width="1dp" android:layout_height="24dp" android:background="#FFFFFF"/>
                <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.0" android:minWidth="100dp" android:gravity="end|center_vertical" android:paddingEnd="12dp" android:text="CREDITS" android:textColor="@color/black" android:textSize="12sp"/>
                <View android:layout_width="1dp" android:layout_height="24dp" android:background="#FFFFFF"/>
                <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.0" android:minWidth="100dp" android:gravity="end|center_vertical" android:paddingEnd="12dp" android:text="DEBITS" android:textColor="@color/black" android:textSize="12sp"/>
                <View android:layout_width="1dp" android:layout_height="24dp" android:background="#FFFFFF"/>
                <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.0" android:minWidth="100dp" android:gravity="end|center_vertical" android:paddingEnd="12dp" android:text="BALANCE" android:textColor="@color/black" android:textSize="12sp"/>
                <View android:layout_width="1dp" android:layout_height="24dp" android:background="#FFFFFF"/>
                <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="0.7" android:minWidth="70dp" android:text="STATUS" android:textColor="@color/black" android:textSize="12sp"/>
                <View android:layout_width="1dp" android:layout_height="24dp" android:background="#FFFFFF"/>
                <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="0.5" android:minWidth="50dp" android:text="ACTION" android:textColor="@color/black" android:textSize="12sp"/>
            </LinearLayout>

            <!-- FILTER ROW -->
            <LinearLayout
                android:id="@+id/filterRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#E8EDF2"
                android:paddingVertical="6dp"
                android:visibility="gone">

                <EditText
                    android:id="@+id/etFilterHead"
                    android:layout_width="0dp"
                    android:layout_weight="0.8"
                    android:layout_height="38dp"
                    android:hint="Filter Head"
                    android:textSize="11sp"
                    android:padding="8dp"
                    android:background="@drawable/edittext_background"
                    android:layout_margin="2dp"
                    android:inputType="text"
                    android:imeOptions="actionSearch"/>

                <EditText
                    android:id="@+id/etFilterAcctId"
                    android:layout_width="0dp"
                    android:layout_weight="1.2"
                    android:layout_height="38dp"
                    android:hint="Filter Acct ID"
                    android:textSize="11sp"
                    android:padding="8dp"
                    android:background="@drawable/edittext_background"
                    android:layout_margin="2dp"
                    android:inputType="number"
                    android:imeOptions="actionSearch"/>

                <EditText
                    android:id="@+id/etFilterAcctName"
                    android:layout_width="0dp"
                    android:layout_weight="2.0"
                    android:layout_height="38dp"
                    android:hint="Filter Account Name"
                    android:textSize="11sp"
                    android:padding="8dp"
                    android:background="@drawable/edittext_background"
                    android:layout_margin="2dp"
                    android:inputType="text"
                    android:imeOptions="actionSearch"/>

                <EditText
                    android:id="@+id/etFilterCurrency"
                    android:layout_width="0dp"
                    android:layout_weight="0.6"
                    android:layout_height="38dp"
                    android:hint="Curr"
                    android:textSize="11sp"
                    android:padding="8dp"
                    android:background="@drawable/edittext_background"
                    android:layout_margin="2dp"
                    android:inputType="text"
                    android:imeOptions="actionSearch"/>

                <EditText
                    android:id="@+id/etFilterCredits"
                    android:layout_width="0dp"
                    android:layout_weight="1.0"
                    android:layout_height="38dp"
                    android:hint="Filter Credits"
                    android:textSize="11sp"
                    android:padding="8dp"
                    android:background="@drawable/edittext_background"
                    android:layout_margin="2dp"
                    android:inputType="numberDecimal"
                    android:imeOptions="actionSearch"/>

                <EditText
                    android:id="@+id/etFilterDebits"
                    android:layout_width="0dp"
                    android:layout_weight="1.0"
                    android:layout_height="38dp"
                    android:hint="Filter Debits"
                    android:textSize="11sp"
                    android:padding="8dp"
                    android:background="@drawable/edittext_background"
                    android:layout_margin="2dp"
                    android:inputType="numberDecimal"
                    android:imeOptions="actionSearch"/>

                <EditText
                    android:id="@+id/etFilterBalance"
                    android:layout_width="0dp"
                    android:layout_weight="1.0"
                    android:layout_height="38dp"
                    android:hint="Filter Balance"
                    android:textSize="11sp"
                    android:padding="8dp"
                    android:background="@drawable/edittext_background"
                    android:layout_margin="2dp"
                    android:inputType="numberDecimal"
                    android:imeOptions="actionSearch"/>

                <EditText
                    android:id="@+id/etFilterStatus"
                    android:layout_width="0dp"
                    android:layout_weight="0.7"
                    android:layout_height="38dp"
                    android:hint="Active/Inactive"
                    android:textSize="11sp"
                    android:padding="8dp"
                    android:background="@drawable/edittext_background"
                    android:layout_margin="2dp"
                    android:inputType="text"
                    android:imeOptions="actionSearch"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="0.5"
                    android:layout_height="38dp"/>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#CCCCCC"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvTransLedger"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#FFFFFF"
                android:nestedScrollingEnabled="true"/>
        </LinearLayout>
    </HorizontalScrollView>

</LinearLayout>