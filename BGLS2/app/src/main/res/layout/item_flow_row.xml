<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="8dp">
    <TextView android:id="@+id/tvFlowId" android:layout_width="80dp" android:layout_height="wrap_content" />
    <TextView android:id="@+id/tvFlowCode" android:layout_width="80dp" android:layout_height="wrap_content" />
    <TextView android:id="@+id/tvFlowDate" android:layout_width="100dp" android:layout_height="wrap_content" />
    <TextView android:id="@+id/tvFlowAmt" android:layout_width="120dp" android:layout_height="wrap_content" />
    <TextView android:id="@+id/tvOutstanding" android:layout_width="120dp" android:layout_height="wrap_content" />
</LinearLayout>