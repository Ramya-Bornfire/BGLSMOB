<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <TextView android:id="@+id/tvAccountId"
        android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="2.5" android:minWidth="140dp"
        android:paddingTop="4dp" android:paddingBottom="4dp"
        android:background="@drawable/table_cell_bg" android:gravity="center_vertical"
        android:paddingStart="8dp" android:paddingEnd="4dp"
        android:textSize="12sp" android:textColor="#2196F3"
        android:clickable="true" android:focusable="true"/>

    <TextView android:id="@+id/tvAccountName"
        android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="2.5" android:minWidth="180dp"
        android:paddingTop="4dp" android:paddingBottom="4dp"
        android:background="@drawable/table_cell_bg" android:gravity="center_vertical"
        android:paddingStart="8dp" android:paddingEnd="4dp"
        android:textSize="12sp" android:textColor="#333333"/>

    <TextView android:id="@+id/tvDateOfLoan"
        android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1.5" android:minWidth="110dp"
        android:paddingTop="4dp" android:paddingBottom="4dp"
        android:background="@drawable/table_cell_bg" android:gravity="center_vertical"
        android:paddingStart="8dp" android:paddingEnd="4dp"
        android:textSize="12sp" android:textColor="#333333"/>

    <TextView android:id="@+id/tvLoanAmount"
        android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1.5" android:minWidth="110dp"
        android:paddingTop="4dp" android:paddingBottom="4dp"
        android:background="@drawable/table_cell_bg" android:gravity="center_vertical|end"
        android:paddingStart="8dp" android:paddingEnd="8dp"
        android:textSize="12sp" android:textColor="#333333"/>

    <TextView android:id="@+id/tvLoanBalance"
        android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1.5" android:minWidth="110dp"
        android:paddingTop="4dp" android:paddingBottom="4dp"
        android:background="@drawable/table_cell_bg" android:gravity="center_vertical|end"
        android:paddingStart="8dp" android:paddingEnd="8dp"
        android:textSize="12sp" android:textColor="#333333"/>

</LinearLayout>
