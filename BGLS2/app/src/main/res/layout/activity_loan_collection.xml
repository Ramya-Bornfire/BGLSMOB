<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".LoanCollectionActivity">

    <LinearLayout
        android:id="@+id/layoutBulkCollection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- ─── Section Header Bar ─── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:background="@drawable/header_bg"
            android:padding="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Bulk Collection"
                android:textStyle="bold"
                android:textSize="13sp"
                android:gravity="center"
                android:textColor="@color/white"/>

            <Button
                android:id="@+id/btnBulkUpload"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Upload"
                android:textSize="10sp"
                android:textAllCaps="false"
                android:backgroundTint="#007BFF"
                android:textColor="#FFFFFF"/>
        </LinearLayout>

        <!-- ─── Add Button ─── -->
        <Button
            android:id="@+id/btnBulkAdd"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="Add"
            android:textSize="10sp"
            android:textAllCaps="false"
            android:backgroundTint="#28A745"
            android:textColor="#FFFFFF"
            android:layout_gravity="end"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"/>

        <!-- ─── Table Container ─── -->
        <!--
             KEY FIX: No HorizontalScrollView here.
             layout_weight works only when parent has a known width.
             match_parent on this outer LinearLayout gives weights
             a reference width = full screen width on every device.
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="4dp"
            android:background="#FFFFFF">

            <!-- ─── Table Header ─── -->
            <!--
                Weights used here:
                TranId=1.2, Names=1.5, Ref=1.2, Mobile=1.5,
                Amount=1.0, AllocAmt=1.2, Time=1.5, Status=1.2,
                AllocRB=0.8, Delete=0.6
                Total = 11.7
                All row cells must use the SAME weights.
            -->
            <LinearLayout
                android:id="@+id/llTableHeader"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:orientation="horizontal"
                android:background="#E9ECEF">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.2"
                    android:text="Transaction ID"
                    android:padding="4dp"
                    android:textStyle="bold"
                    android:textSize="9sp"
                    android:textColor="#444444"
                    android:background="@drawable/table_cell_bg"
                    android:gravity="center"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.5"
                    android:text="Names"
                    android:padding="4dp"
                    android:textStyle="bold"
                    android:textSize="9sp"
                    android:textColor="#444444"
                    android:background="@drawable/table_cell_bg"
                    android:gravity="center"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.2"
                    android:text="Reference"
                    android:padding="4dp"
                    android:textStyle="bold"
                    android:textSize="9sp"
                    android:textColor="#444444"
                    android:background="@drawable/table_cell_bg"
                    android:gravity="center"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.5"
                    android:text="Mobile Number"
                    android:padding="4dp"
                    android:textStyle="bold"
                    android:textSize="9sp"
                    android:textColor="#444444"
                    android:background="@drawable/table_cell_bg"
                    android:gravity="center"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.0"
                    android:text="Amount"
                    android:padding="4dp"
                    android:textStyle="bold"
                    android:textSize="9sp"
                    android:textColor="#444444"
                    android:background="@drawable/table_cell_bg"
                    android:gravity="center"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.2"
                    android:text="Allocated Amount"
                    android:padding="4dp"
                    android:textStyle="bold"
                    android:textSize="9sp"
                    android:textColor="#444444"
                    android:background="@drawable/table_cell_bg"
                    android:gravity="center"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.5"
                    android:text="Trans. Time"
                    android:padding="4dp"
                    android:textStyle="bold"
                    android:textSize="9sp"
                    android:textColor="#444444"
                    android:background="@drawable/table_cell_bg"
                    android:gravity="center"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1.2"
                    android:text="Status"
                    android:padding="4dp"
                    android:textStyle="bold"
                    android:textSize="9sp"
                    android:textColor="#444444"
                    android:background="@drawable/table_cell_bg"
                    android:gravity="center"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.8"
                    android:text="Allocated"
                    android:padding="4dp"
                    android:textStyle="bold"
                    android:textSize="9sp"
                    android:textColor="#444444"
                    android:background="@drawable/table_cell_bg"
                    android:gravity="center"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.6"
                    android:text="Del"
                    android:padding="4dp"
                    android:textStyle="bold"
                    android:textSize="9sp"
                    android:textColor="#444444"
                    android:background="@drawable/table_cell_bg"
                    android:gravity="center"/>
            </LinearLayout>

            <!-- ─── Rows Container ─── -->
            <LinearLayout
                android:id="@+id/llBulkRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF">

                <!-- Default first row — same weights as header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:orientation="horizontal">

                    <EditText android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.2" android:background="@drawable/table_cell_bg" android:textSize="9sp" android:padding="4dp" android:gravity="center"/>
                    <EditText android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.5" android:background="@drawable/table_cell_bg" android:textSize="9sp" android:padding="4dp" android:gravity="center"/>
                    <EditText android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.2" android:background="@drawable/table_cell_bg" android:textSize="9sp" android:padding="4dp" android:gravity="center"/>
                    <EditText android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.5" android:background="@drawable/table_cell_bg" android:textSize="9sp" android:padding="4dp" android:gravity="center"/>
                    <EditText android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.0" android:background="@drawable/table_cell_bg" android:textSize="9sp" android:padding="4dp" android:gravity="center"/>
                    <EditText android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.2" android:background="@drawable/table_cell_bg" android:textSize="9sp" android:padding="4dp" android:text="0" android:gravity="center"/>
                    <EditText android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.5" android:background="@drawable/table_cell_bg" android:textSize="9sp" android:padding="4dp" android:text="01-05-2026 13:00" android:gravity="center"/>
                    <EditText android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.2" android:background="@drawable/table_cell_bg" android:textSize="9sp" android:padding="4dp" android:text="UNALLOCATED" android:gravity="center"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0.8"
                        android:background="@drawable/table_cell_bg"
                        android:gravity="center">
                        <RadioButton
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="0dp"
                            android:minWidth="0dp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="0.6"
                        android:background="@drawable/table_cell_bg"
                        android:gravity="center">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@android:drawable/ic_menu_delete"
                            android:padding="2dp"/>
                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
    <Button
        android:id="@+id/btnSubmit"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:text="Submit"
        android:textSize="14sp"
        android:textAllCaps="false"
        android:backgroundTint="#007BFF"
        android:textColor="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>