<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".LoanCollectionActivity">

    <!-- MAIN CONTAINER -->
    <LinearLayout
        android:id="@+id/layoutBulkCollection"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btnSubmit"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- SLEEK PROFESSIONAL HEADER (Single Row) -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/header_bg"
            android:layout_marginTop="30dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:paddingHorizontal="24dp"
            android:elevation="8dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/arrow_back"
                android:padding="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@android:color/white"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BULK COLLECTION"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:layout_centerInParent="true"/>

            <!-- Right Side Container (User Info + Buttons) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true">

                <!-- Vertical User Info -->
                <LinearLayout
                    android:id="@+id/userInfoLayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginEnd="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="65dp"
                            android:layout_height="wrap_content"
                            android:text="User ID"
                            android:textColor="#AACFFF"
                            android:textSize="10sp"
                            android:textStyle="bold"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=":"
                            android:textColor="#AACFFF"
                            android:textSize="10sp"
                            android:layout_marginEnd="4dp"/>
                        <TextView
                            android:id="@+id/txtUserIdInfo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="EMP04"
                            android:textColor="@android:color/white"
                            android:textSize="10sp"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="2dp">
                        <TextView
                            android:layout_width="65dp"
                            android:layout_height="wrap_content"
                            android:text="User Name"
                            android:textColor="#AACFFF"
                            android:textSize="10sp"
                            android:textStyle="bold"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=":"
                            android:textColor="#AACFFF"
                            android:textSize="10sp"
                            android:layout_marginEnd="4dp"/>
                        <TextView
                            android:id="@+id/txtUserNameInfo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Manivanan"
                            android:textColor="@android:color/white"
                            android:textSize="10sp"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="2dp">
                        <TextView
                            android:layout_width="65dp"
                            android:layout_height="wrap_content"
                            android:text="Login Time"
                            android:textColor="#AACFFF"
                            android:textSize="10sp"
                            android:textStyle="bold"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=":"
                            android:textColor="#AACFFF"
                            android:textSize="10sp"
                            android:layout_marginEnd="4dp"/>
                        <TextView
                            android:id="@+id/txtLoginTimeInfo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--"
                            android:textColor="@android:color/white"
                            android:textSize="10sp"
                            android:textStyle="bold"/>
                    </LinearLayout>
                </LinearLayout>

                <ImageView
                    android:id="@+id/btnHome"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/home"
                    android:padding="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    app:tint="@android:color/white"/>

            </LinearLayout>
        </RelativeLayout>

        <!-- BUTTON ROW -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal"
            android:padding="8dp">

            <Button
                android:id="@+id/btnBulkUpload"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:backgroundTint="#007BFF"
                android:text="Upload"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnBulkAdd"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="#28A745"
                android:text="Add"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="11sp" />

        </LinearLayout>

        <!-- TABLE AREA -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="horizontal">

            <!-- IMPORTANT -->
            <!-- Width fixed so all columns visible correctly -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:minWidth="1120dp"
                android:orientation="vertical">

                <!-- TABLE HEADER -->
                <LinearLayout
                    android:id="@+id/llTableHeader"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:background="#DDE3EA"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1.2"
                        android:layout_height="match_parent"
                        android:background="@drawable/table_cell_bg"
                        android:gravity="center"
                        android:padding="4dp"
                        android:text="Transaction ID"
                        android:textColor="#222222"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1.5"
                        android:layout_height="match_parent"
                        android:background="@drawable/table_cell_bg"
                        android:gravity="center"
                        android:padding="4dp"
                        android:text="Names"
                        android:textColor="#222222"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1.2"
                        android:layout_height="match_parent"
                        android:background="@drawable/table_cell_bg"
                        android:gravity="center"
                        android:padding="4dp"
                        android:text="Reference"
                        android:textColor="#222222"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1.5"
                        android:layout_height="match_parent"
                        android:background="@drawable/table_cell_bg"
                        android:gravity="center"
                        android:padding="4dp"
                        android:text="Mobile Number"
                        android:textColor="#222222"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1.0"
                        android:layout_height="match_parent"
                        android:background="@drawable/table_cell_bg"
                        android:gravity="center"
                        android:padding="4dp"
                        android:text="Amount"
                        android:textColor="#222222"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1.4"
                        android:layout_height="match_parent"
                        android:background="@drawable/table_cell_bg"
                        android:gravity="center"
                        android:padding="4dp"
                        android:text="Allocated Amount"
                        android:textColor="#222222"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1.5"
                        android:layout_height="match_parent"
                        android:background="@drawable/table_cell_bg"
                        android:gravity="center"
                        android:padding="4dp"
                        android:text="Trans. Time"
                        android:textColor="#222222"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1.2"
                        android:layout_height="match_parent"
                        android:background="@drawable/table_cell_bg"
                        android:gravity="center"
                        android:padding="4dp"
                        android:text="Status"
                        android:textColor="#222222"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="0.9"
                        android:layout_height="match_parent"
                        android:background="@drawable/table_cell_bg"
                        android:gravity="center"
                        android:padding="4dp"
                        android:text="Allocated"
                        android:textColor="#222222"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="0.8"
                        android:layout_height="match_parent"
                        android:background="@drawable/table_cell_bg"
                        android:gravity="center"
                        android:padding="4dp"
                        android:text="Del"
                        android:textColor="#222222"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- ROWS -->
                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fillViewport="true">

                    <LinearLayout
                        android:id="@+id/llBulkRows"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- DEFAULT ROW -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="45dp"
                            android:orientation="horizontal">

                            <EditText
                                android:layout_width="0dp"
                                android:layout_weight="1.2"
                                android:layout_height="match_parent"
                                android:background="@drawable/table_cell_bg"
                                android:gravity="center"
                                android:padding="4dp"
                                android:textSize="10sp"/>

                            <EditText
                                android:layout_width="0dp"
                                android:layout_weight="1.5"
                                android:layout_height="match_parent"
                                android:background="@drawable/table_cell_bg"
                                android:gravity="center"
                                android:padding="4dp"
                                android:textSize="10sp"/>

                            <EditText
                                android:layout_width="0dp"
                                android:layout_weight="1.2"
                                android:layout_height="match_parent"
                                android:background="@drawable/table_cell_bg"
                                android:gravity="center"
                                android:padding="4dp"
                                android:textSize="10sp"/>

                            <EditText
                                android:layout_width="0dp"
                                android:layout_weight="1.5"
                                android:layout_height="match_parent"
                                android:background="@drawable/table_cell_bg"
                                android:gravity="center"
                                android:padding="4dp"
                                android:textSize="10sp"/>

                            <EditText
                                android:layout_width="0dp"
                                android:layout_weight="1.0"
                                android:layout_height="match_parent"
                                android:background="@drawable/table_cell_bg"
                                android:gravity="center"
                                android:padding="4dp"
                                android:textSize="10sp"/>

                            <EditText
                                android:layout_width="0dp"
                                android:layout_weight="1.4"
                                android:layout_height="match_parent"
                                android:background="@drawable/table_cell_bg"
                                android:gravity="center"
                                android:padding="4dp"
                                android:text="0"
                                android:textSize="10sp"/>

                            <EditText
                                android:layout_width="0dp"
                                android:layout_weight="1.5"
                                android:layout_height="match_parent"
                                android:background="@drawable/table_cell_bg"
                                android:gravity="center"
                                android:padding="4dp"
                                android:text="01-05-2026 13:00"
                                android:textSize="10sp"/>

                            <EditText
                                android:layout_width="0dp"
                                android:layout_weight="1.2"
                                android:layout_height="match_parent"
                                android:background="@drawable/table_cell_bg"
                                android:gravity="center"
                                android:padding="4dp"
                                android:text="UNALLOCATED"
                                android:textSize="10sp"/>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_weight="0.9"
                                android:layout_height="match_parent"
                                android:background="@drawable/table_cell_bg"
                                android:gravity="center">

                                <RadioButton
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"/>
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_weight="0.8"
                                android:layout_height="match_parent"
                                android:background="@drawable/table_cell_bg"
                                android:gravity="center">

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    app:tint="@android:color/holo_red_dark"
                                    android:src="@android:drawable/ic_menu_delete"/>
                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                </ScrollView>

            </LinearLayout>

        </HorizontalScrollView>

    </LinearLayout>

    <!-- SUBMIT -->
    <Button
        android:id="@+id/btnSubmit"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginBottom="14dp"
        android:backgroundTint="#007BFF"
        android:text="Submit"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
