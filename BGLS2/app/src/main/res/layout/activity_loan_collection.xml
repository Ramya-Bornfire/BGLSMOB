<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".LoanCollectionActivity">
    <LinearLayout
        android:id="@+id/layoutBulkCollection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="20dp">

        <LinearLayout
            android:layout_marginTop="30dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#E9ECEF"
            android:padding="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Bulk Collection"
                android:textStyle="bold"
                android:textSize="13sp"
                android:textColor="#333333"/>
            <Button
                android:id="@+id/btnBulkUpload"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Upload"
                android:textSize="10sp"
                android:textAllCaps="false"
                android:backgroundTint="#007BFF"
                android:textColor="#FFFFFF"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnBulkAdd"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="Add"
            android:textSize="10sp"
            android:textAllCaps="false"
            android:backgroundTint="#28A745"
            android:textColor="#FFFFFF"
            android:layout_gravity="end"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"/>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#FFFFFF"
            android:fillViewport="true"
            android:scrollbars="horizontal">
            <LinearLayout
                android:id="@+id/llBulkRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <!-- Bulk Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="#E9ECEF">

                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Transaction ID" android:padding="10dp" android:textStyle="bold" android:textSize="10sp" android:textColor="#444444" android:background="@drawable/table_cell_bg" android:gravity="center"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Names" android:padding="10dp" android:textStyle="bold" android:textSize="10sp" android:textColor="#444444" android:background="@drawable/table_cell_bg" android:gravity="center"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Reference" android:padding="10dp" android:textStyle="bold" android:textSize="10sp" android:textColor="#444444" android:background="@drawable/table_cell_bg" android:gravity="center"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Mobile Number" android:padding="10dp" android:textStyle="bold" android:textSize="10sp" android:textColor="#444444" android:background="@drawable/table_cell_bg" android:gravity="center"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Amount" android:padding="10dp" android:textStyle="bold" android:textSize="10sp" android:textColor="#444444" android:background="@drawable/table_cell_bg" android:gravity="center"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Allocated Amount" android:padding="10dp" android:textStyle="bold" android:textSize="10sp" android:textColor="#444444" android:background="@drawable/table_cell_bg" android:gravity="center"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Trans. Time" android:padding="10dp" android:textStyle="bold" android:textSize="10sp" android:textColor="#444444" android:background="@drawable/table_cell_bg" android:gravity="center"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Status" android:padding="10dp" android:textStyle="bold" android:textSize="10sp" android:textColor="#444444" android:background="@drawable/table_cell_bg" android:gravity="center"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.2" android:text="Allocated" android:padding="10dp" android:textStyle="bold" android:textSize="10sp" android:textColor="#444444" android:background="@drawable/table_cell_bg" android:gravity="center"/>
                </LinearLayout>

                <!-- Bulk Input Row Template -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="#E9ECEF">
                    <EditText
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:background="@drawable/table_cell_bg"
                        android:textSize="10sp"
                        android:padding="10dp"
                        android:gravity="center"/>
                    <EditText android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:background="@drawable/table_cell_bg" android:textSize="10sp" android:padding="10dp" android:gravity="center"/>
                    <EditText android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:background="@drawable/table_cell_bg" android:textSize="10sp" android:padding="10dp" android:gravity="center"/>
                    <EditText android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:background="@drawable/table_cell_bg" android:textSize="10sp" android:padding="10dp" android:gravity="center"/>
                    <EditText android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:background="@drawable/table_cell_bg" android:textSize="10sp" android:padding="10dp" android:gravity="center"/>
                    <EditText android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:background="@drawable/table_cell_bg" android:textSize="10sp" android:padding="10dp" android:text="0" android:gravity="center"/>
                    <EditText android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:background="@drawable/table_cell_bg" android:textSize="10sp" android:padding="10dp" android:text="01-05-2026 13:00" android:gravity="center"/>
                    <EditText android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="wrap_content" android:background="@drawable/table_cell_bg" android:textSize="10sp" android:padding="10dp" android:text="UNALLOCATED" android:gravity="center"/>

                    <RadioButton android:layout_width="0dp" android:layout_weight="0.8" android:layout_height="40dp" android:background="@drawable/table_cell_bg" android:gravity="center"/>
                </LinearLayout>
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Bulk Footer buttons -->
    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>
