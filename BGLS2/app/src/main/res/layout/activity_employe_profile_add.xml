<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F0F0">

    <!-- SLEEK PROFESSIONAL HEADER (Single Row) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/header_bg"
        android:layout_marginTop="30dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:paddingHorizontal="24dp"
        android:elevation="8dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/arrow_back"
            android:padding="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/white"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"/>

        <TextView
            android:id="@+id/toolbarTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EMPLOYEE PROFILE"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:layout_centerInParent="true"/>

        <!-- Right Side Container (User Info + Buttons) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true">

            <!-- Vertical User Info -->
            <LinearLayout
                android:id="@+id/userInfoLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginEnd="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="65dp"
                        android:layout_height="wrap_content"
                        android:text="User ID"
                        android:textColor="#AACFFF"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=":"
                        android:textColor="#AACFFF"
                        android:textSize="10sp"
                        android:layout_marginEnd="4dp"/>
                    <TextView
                        android:id="@+id/txtUserIdInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="EMP04"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="2dp">
                    <TextView
                        android:layout_width="65dp"
                        android:layout_height="wrap_content"
                        android:text="User Name"
                        android:textColor="#AACFFF"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=":"
                        android:textColor="#AACFFF"
                        android:textSize="10sp"
                        android:layout_marginEnd="4dp"/>
                    <TextView
                        android:id="@+id/txtUserNameInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Manivanan"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="2dp">
                    <TextView
                        android:layout_width="65dp"
                        android:layout_height="wrap_content"
                        android:text="Login Time"
                        android:textColor="#AACFFF"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=":"
                        android:textColor="#AACFFF"
                        android:textSize="10sp"
                        android:layout_marginEnd="4dp"/>
                    <TextView
                        android:id="@+id/txtLoginTimeInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>

            <Button android:id="@+id/btnList"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="List" android:textColor="#FFFFFF" android:backgroundTint="#2196F3"
                android:paddingStart="20dp" android:paddingEnd="20dp" android:layout_marginEnd="8dp"/>

            <Button android:id="@+id/btnSubmit"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Submit" android:textColor="#FFFFFF" android:backgroundTint="#2196F3"
                android:layout_marginEnd="8dp" android:paddingStart="20dp" android:paddingEnd="20dp"/>

            <ImageView
                android:id="@+id/btnHome"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/home"
                android:padding="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/white"/>

        </LinearLayout>
    </RelativeLayout>

    <!-- ─── SCROLLABLE FORM ─── -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp">

            <!-- ─── ROW 1: Branch Id | Branch Name ─── -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="10dp"
                android:gravity="center_vertical">

                <TextView android:layout_width="140dp" android:layout_height="wrap_content"
                    android:text="Branch Id" android:textSize="12sp" android:textColor="#555555"/>
                <Spinner android:id="@+id/spinnerBranchId"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:background="@drawable/spinner_background"
                    android:paddingStart="8dp" android:paddingEnd="8dp"
                    android:paddingTop="8dp" android:paddingBottom="8dp"/>

                <View android:layout_width="16dp" android:layout_height="1dp"/>

                <TextView android:layout_width="140dp" android:layout_height="wrap_content"
                    android:text="Branch Name" android:textSize="12sp" android:textColor="#555555"/>
                <EditText android:id="@+id/etBranchName"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:background="@drawable/edittext_background"
                    android:paddingStart="8dp" android:paddingEnd="8dp"
                    android:paddingTop="8dp" android:paddingBottom="8dp"
                    android:textSize="13sp" android:textColor="#AAAAAA" android:enabled="false"/>
            </LinearLayout>

            <!-- ─── ROW 2: Employee Id | Employee Name ─── -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="10dp"
                android:gravity="center_vertical">

                <TextView android:layout_width="140dp" android:layout_height="wrap_content"
                    android:text="Employee Id" android:textSize="12sp" android:textColor="#555555"/>
                <EditText android:id="@+id/etEmployeeId"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:background="@drawable/edittext_background"
                    android:paddingStart="8dp" android:paddingEnd="8dp"
                    android:paddingTop="8dp" android:paddingBottom="8dp"
                    android:textSize="13sp" android:inputType="text"/>

                <View android:layout_width="16dp" android:layout_height="1dp"/>

                <TextView android:layout_width="140dp" android:layout_height="wrap_content"
                    android:text="Employee Name" android:textSize="12sp" android:textColor="#555555"/>
                <EditText android:id="@+id/etEmployeeName"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:background="@drawable/edittext_background"
                    android:paddingStart="8dp" android:paddingEnd="8dp"
                    android:paddingTop="8dp" android:paddingBottom="8dp"
                    android:textSize="13sp" android:inputType="textPersonName"/>
            </LinearLayout>

            <!-- ─── ROW 3: Bank Name | Account Number ─── -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="10dp"
                android:gravity="center_vertical">

                <TextView android:layout_width="140dp" android:layout_height="wrap_content"
                    android:text="Bank Name" android:textSize="12sp" android:textColor="#555555"/>
                <EditText android:id="@+id/etBankName"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:background="@drawable/edittext_background"
                    android:paddingStart="8dp" android:paddingEnd="8dp"
                    android:paddingTop="8dp" android:paddingBottom="8dp"
                    android:textSize="13sp" android:inputType="text"/>

                <View android:layout_width="16dp" android:layout_height="1dp"/>

                <TextView android:layout_width="140dp" android:layout_height="wrap_content"
                    android:text="Account Number" android:textSize="12sp" android:textColor="#555555"/>
                <EditText android:id="@+id/etAccountNumber"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:background="@drawable/edittext_background"
                    android:paddingStart="8dp" android:paddingEnd="8dp"
                    android:paddingTop="8dp" android:paddingBottom="8dp"
                    android:textSize="13sp" android:inputType="number"/>
            </LinearLayout>

            <!-- ─── ROW 4: Date of Joining | Date of Birth ─── -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="10dp"
                android:gravity="center_vertical">

                <TextView android:layout_width="140dp" android:layout_height="wrap_content"
                    android:text="Date of Joining" android:textSize="12sp" android:textColor="#555555"/>
                <EditText android:id="@+id/etDateOfJoining"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:background="@drawable/edittext_background"
                    android:paddingStart="8dp" android:paddingEnd="8dp"
                    android:paddingTop="8dp" android:paddingBottom="8dp"
                    android:hint="dd-mm-yyyy" android:textColorHint="#AAAAAA"
                    android:textSize="13sp" android:focusable="true" android:clickable="true"/>

                <View android:layout_width="16dp" android:layout_height="1dp"/>

                <TextView android:layout_width="140dp" android:layout_height="wrap_content"
                    android:text="Date of Birth" android:textSize="12sp" android:textColor="#555555"/>
                <EditText android:id="@+id/etDateOfBirth"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:background="@drawable/edittext_background"
                    android:paddingStart="8dp" android:paddingEnd="8dp"
                    android:paddingTop="8dp" android:paddingBottom="8dp"
                    android:hint="dd-mm-yyyy" android:textColorHint="#AAAAAA"
                    android:textSize="13sp" android:focusable="true" android:clickable="true"/>
            </LinearLayout>

            <!-- ─── ROW 5: Category | Department ─── -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="10dp"
                android:gravity="center_vertical">

                <TextView android:layout_width="140dp" android:layout_height="wrap_content"
                    android:text="Category" android:textSize="12sp" android:textColor="#555555"/>
                <Spinner android:id="@+id/spinnerCategory"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:background="@drawable/spinner_background"
                    android:paddingStart="8dp" android:paddingEnd="8dp"
                    android:paddingTop="8dp" android:paddingBottom="8dp"/>

                <View android:layout_width="16dp" android:layout_height="1dp"/>

                <TextView android:layout_width="140dp" android:layout_height="wrap_content"
                    android:text="Department" android:textSize="12sp" android:textColor="#555555"/>
                <Spinner android:id="@+id/spinnerDepartment"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:background="@drawable/spinner_background"
                    android:paddingStart="8dp" android:paddingEnd="8dp"
                    android:paddingTop="8dp" android:paddingBottom="8dp"/>
            </LinearLayout>

            <!-- ─── ROW 6: Designation | Role ─── -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="10dp"
                android:gravity="center_vertical">

                <TextView android:layout_width="140dp" android:layout_height="wrap_content"
                    android:text="Designation" android:textSize="12sp" android:textColor="#555555"/>
                <Spinner android:id="@+id/spinnerDesignation"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:background="@drawable/spinner_background"
                    android:paddingStart="8dp" android:paddingEnd="8dp"
                    android:paddingTop="8dp" android:paddingBottom="8dp"/>

                <View android:layout_width="16dp" android:layout_height="1dp"/>

                <TextView android:layout_width="140dp" android:layout_height="wrap_content"
                    android:text="Role" android:textSize="12sp" android:textColor="#555555"/>
                <Spinner android:id="@+id/spinnerRole"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:background="@drawable/spinner_background"
                    android:paddingStart="8dp" android:paddingEnd="8dp"
                    android:paddingTop="8dp" android:paddingBottom="8dp"/>
            </LinearLayout>

            <!-- ─── ROW 7: Qualification | Additional Qualification ─── -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="10dp"
                android:gravity="center_vertical">

                <TextView android:layout_width="140dp" android:layout_height="wrap_content"
                    android:text="Qualification" android:textSize="12sp" android:textColor="#555555"/>
                <Spinner android:id="@+id/spinnerQualification"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:background="@drawable/spinner_background"
                    android:paddingStart="8dp" android:paddingEnd="8dp"
                    android:paddingTop="8dp" android:paddingBottom="8dp"/>

                <View android:layout_width="16dp" android:layout_height="1dp"/>

                <TextView android:layout_width="140dp" android:layout_height="wrap_content"
                    android:text="Additional Qualification" android:textSize="12sp" android:textColor="#555555"/>
                <EditText android:id="@+id/etAdditionalQualification"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:background="@drawable/edittext_background"
                    android:paddingStart="8dp" android:paddingEnd="8dp"
                    android:paddingTop="8dp" android:paddingBottom="8dp"
                    android:textSize="13sp" android:inputType="text"/>
            </LinearLayout>

            <!-- ─── ROW 8: Passport | Driving License ─── -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="10dp"
                android:gravity="center_vertical">

                <TextView android:layout_width="140dp" android:layout_height="wrap_content"
                    android:text="Passport" android:textSize="12sp" android:textColor="#555555"/>
                <EditText android:id="@+id/etPassport"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:background="@drawable/edittext_background"
                    android:paddingStart="8dp" android:paddingEnd="8dp"
                    android:paddingTop="8dp" android:paddingBottom="8dp"
                    android:textSize="13sp" android:inputType="text"/>

                <View android:layout_width="16dp" android:layout_height="1dp"/>

                <TextView android:layout_width="140dp" android:layout_height="wrap_content"
                    android:text="Driving License" android:textSize="12sp" android:textColor="#555555"/>
                <EditText android:id="@+id/etDrivingLicense"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:background="@drawable/edittext_background"
                    android:paddingStart="8dp" android:paddingEnd="8dp"
                    android:paddingTop="8dp" android:paddingBottom="8dp"
                    android:textSize="13sp" android:inputType="text"/>
            </LinearLayout>

            <!-- ─── ROW 9: Gender | Blood Group ─── -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="10dp"
                android:gravity="center_vertical">

                <TextView android:layout_width="140dp" android:layout_height="wrap_content"
                    android:text="Gender" android:textSize="12sp" android:textColor="#555555"/>
                <Spinner android:id="@+id/spinnerGender"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:background="@drawable/spinner_background"
                    android:paddingStart="8dp" android:paddingEnd="8dp"
                    android:paddingTop="8dp" android:paddingBottom="8dp"/>

                <View android:layout_width="16dp" android:layout_height="1dp"/>

                <TextView android:layout_width="140dp" android:layout_height="wrap_content"
                    android:text="Blood Group" android:textSize="12sp" android:textColor="#555555"/>
                <Spinner android:id="@+id/spinnerBloodGroup"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:background="@drawable/spinner_background"
                    android:paddingStart="8dp" android:paddingEnd="8dp"
                    android:paddingTop="8dp" android:paddingBottom="8dp"/>
            </LinearLayout>

            <!-- ─── ROW 10: Marital Status | Email ─── -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="10dp"
                android:gravity="center_vertical">

                <TextView android:layout_width="140dp" android:layout_height="wrap_content"
                    android:text="Marital Status" android:textSize="12sp" android:textColor="#555555"/>
                <Spinner android:id="@+id/spinnerMaritalStatus"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:background="@drawable/spinner_background"
                    android:paddingStart="8dp" android:paddingEnd="8dp"
                    android:paddingTop="8dp" android:paddingBottom="8dp"/>

                <View android:layout_width="16dp" android:layout_height="1dp"/>

                <TextView android:layout_width="140dp" android:layout_height="wrap_content"
                    android:text="Email" android:textSize="12sp" android:textColor="#555555"/>
                <EditText android:id="@+id/etEmail"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:background="@drawable/edittext_background"
                    android:paddingStart="8dp" android:paddingEnd="8dp"
                    android:paddingTop="8dp" android:paddingBottom="8dp"
                    android:textSize="13sp" android:inputType="textEmailAddress"/>
            </LinearLayout>

            <!-- ─── ROW 11: Mobile No | Alternate Mobile No ─── -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="10dp"
                android:gravity="center_vertical">

                <TextView android:layout_width="140dp" android:layout_height="wrap_content"
                    android:text="Mobile No" android:textSize="12sp" android:textColor="#555555"/>
                <EditText android:id="@+id/etMobileNo"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:background="@drawable/edittext_background"
                    android:paddingStart="8dp" android:paddingEnd="8dp"
                    android:paddingTop="8dp" android:paddingBottom="8dp"
                    android:textSize="13sp" android:inputType="phone"/>

                <View android:layout_width="16dp" android:layout_height="1dp"/>

                <TextView android:layout_width="140dp" android:layout_height="wrap_content"
                    android:text="Alternate Mobile No" android:textSize="12sp" android:textColor="#555555"/>
                <EditText android:id="@+id/etAlternateMobileNo"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:background="@drawable/edittext_background"
                    android:paddingStart="8dp" android:paddingEnd="8dp"
                    android:paddingTop="8dp" android:paddingBottom="8dp"
                    android:textSize="13sp" android:inputType="phone"/>
            </LinearLayout>

            <!-- ─── ROW 12: Address 1 | Address 2 ─── -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="10dp"
                android:gravity="center_vertical">

                <TextView android:layout_width="140dp" android:layout_height="wrap_content"
                    android:text="Address 1" android:textSize="12sp" android:textColor="#555555"/>
                <EditText android:id="@+id/etAddress1"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:background="@drawable/edittext_background"
                    android:paddingStart="8dp" android:paddingEnd="8dp"
                    android:paddingTop="8dp" android:paddingBottom="8dp"
                    android:textSize="13sp" android:inputType="text"/>

                <View android:layout_width="16dp" android:layout_height="1dp"/>

                <TextView android:layout_width="140dp" android:layout_height="wrap_content"
                    android:text="Address 2" android:textSize="12sp" android:textColor="#555555"/>
                <EditText android:id="@+id/etAddress2"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:background="@drawable/edittext_background"
                    android:paddingStart="8dp" android:paddingEnd="8dp"
                    android:paddingTop="8dp" android:paddingBottom="8dp"
                    android:textSize="13sp" android:inputType="text"/>
            </LinearLayout>

            <!-- ─── ROW 13: City | State ─── -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="10dp"
                android:gravity="center_vertical">

                <TextView android:layout_width="140dp" android:layout_height="wrap_content"
                    android:text="City" android:textSize="12sp" android:textColor="#555555"/>
                <EditText android:id="@+id/etCity"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:background="@drawable/edittext_background"
                    android:paddingStart="8dp" android:paddingEnd="8dp"
                    android:paddingTop="8dp" android:paddingBottom="8dp"
                    android:textSize="13sp" android:inputType="text"/>

                <View android:layout_width="16dp" android:layout_height="1dp"/>

                <TextView android:layout_width="140dp" android:layout_height="wrap_content"
                    android:text="State" android:textSize="12sp" android:textColor="#555555"/>
                <EditText android:id="@+id/etState"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:background="@drawable/edittext_background"
                    android:paddingStart="8dp" android:paddingEnd="8dp"
                    android:paddingTop="8dp" android:paddingBottom="8dp"
                    android:textSize="13sp" android:inputType="text"/>
            </LinearLayout>

            <!-- ─── ROW 14: Country | Zipcode ─── -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="10dp"
                android:gravity="center_vertical">

                <TextView android:layout_width="140dp" android:layout_height="wrap_content"
                    android:text="Country" android:textSize="12sp" android:textColor="#555555"/>
                <Spinner android:id="@+id/spinnerCountry"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:background="@drawable/spinner_background"
                    android:paddingStart="8dp" android:paddingEnd="8dp"
                    android:paddingTop="8dp" android:paddingBottom="8dp"/>

                <View android:layout_width="16dp" android:layout_height="1dp"/>

                <TextView android:layout_width="140dp" android:layout_height="wrap_content"
                    android:text="Zipcode" android:textSize="12sp" android:textColor="#555555"/>
                <EditText android:id="@+id/etZipcode"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:background="@drawable/edittext_background"
                    android:paddingStart="8dp" android:paddingEnd="8dp"
                    android:paddingTop="8dp" android:paddingBottom="8dp"
                    android:textSize="13sp" android:inputType="number"/>
            </LinearLayout>

            <!-- ─── ROW 15: Emergency Contact Person | Emergency Contact No ─── -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="10dp"
                android:gravity="center_vertical">

                <TextView android:layout_width="140dp" android:layout_height="wrap_content"
                    android:text="Emergency Contact Person" android:textSize="12sp" android:textColor="#555555"/>
                <EditText android:id="@+id/etEmergencyContactPerson"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:background="@drawable/edittext_background"
                    android:paddingStart="8dp" android:paddingEnd="8dp"
                    android:paddingTop="8dp" android:paddingBottom="8dp"
                    android:textSize="13sp" android:inputType="textPersonName"/>

                <View android:layout_width="16dp" android:layout_height="1dp"/>

                <TextView android:layout_width="140dp" android:layout_height="wrap_content"
                    android:text="Emergency Contact No" android:textSize="12sp" android:textColor="#555555"/>
                <EditText android:id="@+id/etEmergencyContactNo"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:background="@drawable/edittext_background"
                    android:paddingStart="8dp" android:paddingEnd="8dp"
                    android:paddingTop="8dp" android:paddingBottom="8dp"
                    android:textSize="13sp" android:inputType="phone"/>
            </LinearLayout>

            <!-- ─── ROW 16: Employee Photo | Employee Remarks ─── -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView android:layout_width="140dp" android:layout_height="wrap_content"
                    android:text="Employee Photo" android:textSize="12sp" android:textColor="#555555"/>

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <Button android:id="@+id/btnChoosePhoto"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Choose File" android:textSize="12sp"
                            android:textColor="#333333" android:backgroundTint="#E0E0E0"/>
                        <TextView android:id="@+id/tvPhotoName"
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="No file chosen" android:textSize="12sp"
                            android:textColor="#AAAAAA" android:paddingStart="8dp"
                            android:ellipsize="end" android:maxLines="1"/>
                    </LinearLayout>
                    <ImageView android:id="@+id/ivPhotoPreview"
                        android:layout_width="80dp" android:layout_height="80dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/edittext_background"
                        android:scaleType="centerCrop" android:visibility="gone"/>
                </LinearLayout>

                <View android:layout_width="16dp" android:layout_height="1dp"/>

                <TextView android:layout_width="140dp" android:layout_height="wrap_content"
                    android:text="Employee Remarks" android:textSize="12sp" android:textColor="#555555"/>
                <EditText android:id="@+id/etEmployeeRemarks"
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:background="@drawable/edittext_background"
                    android:paddingStart="8dp" android:paddingEnd="8dp"
                    android:paddingTop="8dp" android:paddingBottom="8dp"
                    android:textSize="13sp" android:inputType="textMultiLine" android:minLines="3"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>