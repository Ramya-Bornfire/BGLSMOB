<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="8dp">

    <TextView android:id="@+id/tvDueDate" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="11sp"/>
    <TextView android:id="@+id/tvPrincipalExpenses" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="11sp" android:gravity="end"/>
    <TextView android:id="@+id/tvInterestExpenses" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="11sp" android:gravity="end"/>
    <TextView android:id="@+id/tvFeeExpenses" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="11sp" android:gravity="end"/>
    <TextView android:id="@+id/tvPenaltyExpenses" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="11sp" android:gravity="end"/>
    <TextView android:id="@+id/tvRepaidDate" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="11sp"/>
    <TextView android:id="@+id/tvPrincipalPaid" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="11sp" android:gravity="end"/>
    <TextView android:id="@+id/tvInterestPaid" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="11sp" android:gravity="end"/>
    <TextView android:id="@+id/tvFeePaid" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="11sp" android:gravity="end"/>
    <TextView android:id="@+id/tvPenaltyPaid" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="11sp" android:gravity="end"/>
    <TextView android:id="@+id/tvTotalDues" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="11sp" android:gravity="end"/>

</LinearLayout>
