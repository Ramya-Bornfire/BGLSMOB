<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8F9FA">

    <!-- SLEEK PROFESSIONAL HEADER (Single Row) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/header_bg"
        android:layout_marginTop="30dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:paddingHorizontal="24dp"
        android:elevation="8dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/arrow_back"
            android:padding="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/white"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"/>

        <TextView
            android:id="@+id/tvMainTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DEPOSIT MAINTENANCE - LIST"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:layout_centerInParent="true"/>

        <!-- Right Side Container (User Info + Buttons) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true">

            <!-- Vertical User Info -->
            <LinearLayout
                android:id="@+id/userInfoLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginEnd="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="65dp"
                        android:layout_height="wrap_content"
                        android:text="User ID"
                        android:textColor="#AACFFF"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=":"
                        android:textColor="#AACFFF"
                        android:textSize="10sp"
                        android:layout_marginEnd="4dp"/>
                    <TextView
                        android:id="@+id/txtUserIdInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="EMP04"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="2dp">
                    <TextView
                        android:layout_width="65dp"
                        android:layout_height="wrap_content"
                        android:text="User Name"
                        android:textColor="#AACFFF"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=":"
                        android:textColor="#AACFFF"
                        android:textSize="10sp"
                        android:layout_marginEnd="4dp"/>
                    <TextView
                        android:id="@+id/txtUserNameInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Manivanan"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="2dp">
                    <TextView
                        android:layout_width="65dp"
                        android:layout_height="wrap_content"
                        android:text="Login Time"
                        android:textColor="#AACFFF"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=":"
                        android:textColor="#AACFFF"
                        android:textSize="10sp"
                        android:layout_marginEnd="4dp"/>
                    <TextView
                        android:id="@+id/txtLoginTimeInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>

            <ImageView
                android:id="@+id/btnHome"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/home"
                android:padding="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/white"/>

        </LinearLayout>
    </RelativeLayout>

    <!-- Toolbar for actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end|center_vertical"
        android:padding="8dp"
        android:background="#E9ECEF">
        <Button
            android:id="@+id/btnAdd"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="Add"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#007BFF"
            android:textAllCaps="false"
            android:paddingHorizontal="16dp"
            android:minHeight="0dp"
            android:minWidth="0dp"/>
    </LinearLayout>

    <!-- MAIN CONTENT -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="horizontal"
        android:descendantFocusability="blocksDescendants">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:minWidth="950dp"
            android:background="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#E8EAED">

                <TextView
                    style="@style/TableHeader"
                    android:layout_width="0dp"
                    android:layout_weight="1.5"
                    android:minWidth="150dp"
                    android:background="@drawable/table_cell_bg"
                    android:padding="12dp"
                    android:text="CUSTOMER ID"/>

                <TextView
                    style="@style/TableHeader"
                    android:layout_width="0dp"
                    android:layout_weight="2"
                    android:minWidth="200dp"
                    android:background="@drawable/table_cell_bg"
                    android:padding="12dp"
                    android:text="CUSTOMER NAME"/>

                <TextView
                    style="@style/TableHeader"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:minWidth="100dp"
                    android:background="@drawable/table_cell_bg"
                    android:padding="12dp"
                    android:text="ACCOUNT NO"/>

                <TextView
                    style="@style/TableHeader"
                    android:layout_width="0dp"
                    android:layout_weight="1.5"
                    android:minWidth="150dp"
                    android:background="@drawable/table_cell_bg"
                    android:padding="12dp"
                    android:text="DATE OF DEPOSIT"/>

                <TextView
                    style="@style/TableHeader"
                    android:layout_width="0dp"
                    android:layout_weight="1.5"
                    android:minWidth="150dp"
                    android:background="@drawable/table_cell_bg"
                    android:padding="12dp"
                    android:gravity="end|center_vertical"
                    android:text="DEPOSIT AMOUNT"/>

                <TextView
                    style="@style/TableHeader"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:minWidth="100dp"
                    android:background="@drawable/table_cell_bg"
                    android:padding="12dp"
                    android:gravity="center"
                    android:text="STATUS"/>

                <TextView
                    style="@style/TableHeader"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:minWidth="100dp"
                    android:background="@drawable/table_cell_bg"
                    android:padding="12dp"
                    android:gravity="center"
                    android:text="ACTION"/>
            </LinearLayout>


            <!-- RECYCLER VIEW -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvDepositAccounts"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:minWidth="950dp"
                android:background="#FFFFFF"/>
        </LinearLayout>
    </HorizontalScrollView>

</LinearLayout>