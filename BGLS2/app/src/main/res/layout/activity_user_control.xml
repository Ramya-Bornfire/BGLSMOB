<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F0F0F0">

    <!-- ─── TOP TITLE BAR ─── -->
    <LinearLayout
        android:layout_marginTop="30dp"

        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/header_bg"
        android:padding="10dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/menuIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/menu"
            android:scaleType="centerCrop"
            android:layout_gravity="top|start"
            android:layout_margin="16dp"/>
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="USER PROFILE - LIST"
            android:textSize="19sp"
            android:textStyle="bold"
            android:gravity="center"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/btnCreateUser"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Create User"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2196F3"
            android:paddingStart="16dp"
            android:paddingEnd="16dp" />
    </LinearLayout>

    <!-- ─── TOGGLE BUTTONS ─── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center">

        <Button
            android:id="@+id/btnUserProfile"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="16dp"
            android:text="User Profile"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2196F3"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/btnEmployeeProfile"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:text="Employee Profile"
            android:textColor="#333333"
            android:backgroundTint="#FFFFFF"
            android:stateListAnimator="@null" />
    </LinearLayout>

    <!-- ══════════════════════════════════════ -->
    <!-- USER PROFILE SECTION                  -->
    <!-- ══════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/layoutUserProfile"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="visible">

        <!-- User Profile Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#E8E8E8"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1.2" android:text="USER ID"
                android:textStyle="bold" android:textSize="13sp" android:textColor="#333333" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="2.5" android:text="USER NAME"
                android:textStyle="bold" android:textSize="13sp" android:textColor="#333333" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1.2" android:text="STATUS"
                android:textStyle="bold" android:textSize="13sp" android:textColor="#333333" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="SELECT"
                android:textStyle="bold" android:textSize="13sp" android:textColor="#333333" />
        </LinearLayout>

        <!-- User Profile List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewUsers"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FFFFFF" />
    </LinearLayout>

    <!-- ══════════════════════════════════════ -->
    <!-- EMPLOYEE PROFILE SECTION              -->
    <!-- KEY FIX: Header + RecyclerView BOTH   -->
    <!-- inside ONE HorizontalScrollView       -->
    <!-- ══════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/layoutEmployeeProfile"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scrollbars="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <!-- HEADER -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="#E8E8E8"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">

                    <!-- Repeat for all columns -->
                    <TextView
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:text="SRL NO"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:textColor="#333333"
                        android:padding="4dp"
                        android:gravity="center_vertical"
                        android:singleLine="true"
                        android:ellipsize="end"/>

                    <TextView
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:text="EMPLOYEE ID"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:textColor="#333333"
                        android:padding="4dp"
                        android:gravity="center_vertical"
                        android:singleLine="true"
                        android:ellipsize="end"/>

                    <TextView
                        android:layout_width="160dp"
                        android:layout_height="wrap_content"
                        android:text="NAME"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:textColor="#333333"
                        android:padding="4dp"
                        android:gravity="center_vertical"
                        android:singleLine="true"
                        android:ellipsize="end"/>

                    <TextView
                        android:layout_width="150dp"
                        android:layout_height="wrap_content"
                        android:text="DESIGNATION"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:textColor="#333333"
                        android:padding="4dp"
                        android:gravity="center_vertical"
                        android:singleLine="true"
                        android:ellipsize="end"/>

                    <TextView
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:text="CATEGORY"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:textColor="#333333"
                        android:padding="4dp"
                        android:gravity="center_vertical"
                        android:singleLine="true"
                        android:ellipsize="end"/>

                    <TextView
                        android:layout_width="140dp"
                        android:layout_height="wrap_content"
                        android:text="MOBILE"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:textColor="#333333"
                        android:padding="4dp"
                        android:gravity="center_vertical"
                        android:singleLine="true"
                        android:ellipsize="end"/>

                    <TextView
                        android:layout_width="190dp"
                        android:layout_height="wrap_content"
                        android:text="EMAIL"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:textColor="#333333"
                        android:padding="4dp"
                        android:gravity="center_vertical"
                        android:singleLine="true"
                        android:ellipsize="end"/>

                    <TextView
                        android:layout_width="130dp"
                        android:layout_height="wrap_content"
                        android:text="PROFILE STATUS"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:textColor="#333333"
                        android:padding="4dp"
                        android:gravity="center_vertical"
                        android:singleLine="true"
                        android:ellipsize="end"/>

                    <TextView
                        android:layout_width="90dp"
                        android:layout_height="wrap_content"
                        android:text="SELECT"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:textColor="#333333"
                        android:padding="4dp"
                        android:gravity="center"
                        android:singleLine="true"/>
                </LinearLayout>

                <!-- LIST -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerViewEmployees"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="#FFFFFF"/>

            </LinearLayout>
        </HorizontalScrollView>

    </LinearLayout>

