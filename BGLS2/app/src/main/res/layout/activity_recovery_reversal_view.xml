<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- SLEEK PROFESSIONAL HEADER (Single Row) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/header_bg"
        android:layout_marginTop="30dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:paddingHorizontal="24dp"
        android:elevation="8dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/arrow_back"
            android:padding="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/white"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"/>

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RECOVERY REVERSAL - VIEW"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:layout_centerInParent="true"/>

        <!-- Right Side Container (User Info + Buttons) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true">

            <!-- Vertical User Info -->
            <LinearLayout
                android:id="@+id/userInfoLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginEnd="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="65dp"
                        android:layout_height="wrap_content"
                        android:text="User ID"
                        android:textColor="#AACFFF"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=":"
                        android:textColor="#AACFFF"
                        android:textSize="10sp"
                        android:layout_marginEnd="4dp"/>
                    <TextView
                        android:id="@+id/txtUserIdInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="EMP04"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="2dp">
                    <TextView
                        android:layout_width="65dp"
                        android:layout_height="wrap_content"
                        android:text="User Name"
                        android:textColor="#AACFFF"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=":"
                        android:textColor="#AACFFF"
                        android:textSize="10sp"
                        android:layout_marginEnd="4dp"/>
                    <TextView
                        android:id="@+id/txtUserNameInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Manivanan"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="2dp">
                    <TextView
                        android:layout_width="65dp"
                        android:layout_height="wrap_content"
                        android:text="Login Time"
                        android:textColor="#AACFFF"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=":"
                        android:textColor="#AACFFF"
                        android:textSize="10sp"
                        android:layout_marginEnd="4dp"/>
                    <TextView
                        android:id="@+id/txtLoginTimeInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>

            <ImageView
                android:id="@+id/btnHome"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/home"
                android:padding="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/white"/>

        </LinearLayout>
    </RelativeLayout>

    <!-- Toolbar for actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end|center_vertical"
        android:padding="8dp"
        android:background="#E9ECEF">
        
        <Button
            android:id="@+id/btnDetailView"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="Toggle Table View"
            android:backgroundTint="#007BFF"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textAllCaps="false"
            android:minHeight="0dp"
            android:layout_marginEnd="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Date:"
            android:textSize="11sp"
            android:textColor="#333333"
            android:layout_marginEnd="8dp"/>
        <TextView
            android:id="@+id/tvHeaderDate"
            android:layout_width="100dp"
            android:layout_height="30dp"
            android:background="@drawable/edittext_background"
            android:gravity="center"
            android:text="10-04-2019"
            android:textColor="#333333"
            android:textSize="11sp"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_margin="16dp">
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:elevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Left Column -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginEnd="16dp">
                    
                    <include layout="@layout/view_field_item" android:id="@+id/fieldTranId" />
                    <include layout="@layout/view_field_item" android:id="@+id/fieldAcctId" />
                    <include layout="@layout/view_field_item" android:id="@+id/fieldTranType" />
                    <include layout="@layout/view_field_item" android:id="@+id/fieldAcctCurrency" />
                    <include layout="@layout/view_field_item" android:id="@+id/fieldTranParticulars" />
                    <include layout="@layout/view_field_item" android:id="@+id/fieldFlowCode" />
                    <include layout="@layout/view_field_item" android:id="@+id/fieldTranDate" />
                    <include layout="@layout/view_field_item" android:id="@+id/fieldTranCode" />
                    <include layout="@layout/view_field_item" android:id="@+id/fieldTranRefNo" />
                    <include layout="@layout/view_field_item" android:id="@+id/fieldPartitionType" />
                    <include layout="@layout/view_field_item" android:id="@+id/fieldInstrumentNo" />
                    <include layout="@layout/view_field_item" android:id="@+id/fieldAcctCurrency2" />
                    <include layout="@layout/view_field_item" android:id="@+id/fieldRateCode" />
                    <include layout="@layout/view_field_item" android:id="@+id/fieldEntryUser" />
                    <include layout="@layout/view_field_item" android:id="@+id/fieldEntryTime" />
                    <include layout="@layout/view_field_item" android:id="@+id/fieldTranStatus" />
                </LinearLayout>

                <!-- Right Column -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    
                    <include layout="@layout/view_field_item" android:id="@+id/fieldPartTranId" />
                    <include layout="@layout/view_field_item" android:id="@+id/fieldAcctName" />
                    <include layout="@layout/view_field_item" android:id="@+id/fieldPartTranType" />
                    <include layout="@layout/view_field_item" android:id="@+id/fieldTranAmt" />
                    <include layout="@layout/view_field_item" android:id="@+id/fieldTranRemarks" />
                    <include layout="@layout/view_field_item" android:id="@+id/fieldFlowDate" />
                    <include layout="@layout/view_field_item" android:id="@+id/fieldValueDate" />
                    <include layout="@layout/view_field_item" android:id="@+id/fieldTranReportCode" />
                    <include layout="@layout/view_field_item" android:id="@+id/fieldAdditionalDetails" />
                    <include layout="@layout/view_field_item" android:id="@+id/fieldPartitionDetails" />
                    <include layout="@layout/view_field_item" android:id="@+id/fieldInstrumentDate" />
                    <include layout="@layout/view_field_item" android:id="@+id/fieldHomeCurrencyAmount" />
                    <include layout="@layout/view_field_item" android:id="@+id/fieldRate" />
                    <include layout="@layout/view_field_item" android:id="@+id/fieldPostUser" />
                    <include layout="@layout/view_field_item" android:id="@+id/fieldPostTime" />
                    <include layout="@layout/view_field_item" android:id="@+id/fieldDeleted" />
                </LinearLayout>
            </LinearLayout>

            <!-- Mini Pagination -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end|center_vertical"
                android:layout_marginTop="16dp">
                <Button
                    android:id="@+id/btnDetailPrev"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:text="Previous"
                    android:backgroundTint="#6C757D"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textAllCaps="false"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="12dp"/>
                <TextView
                    android:id="@+id/tvDetailInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1523 / 2607"
                    android:layout_marginHorizontal="8dp"
                    android:textSize="11sp"
                    android:textColor="#333333"
                    android:textStyle="bold"/>
                <Button
                    android:id="@+id/btnDetailNext"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:text="Next"
                    android:backgroundTint="#6C757D"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textAllCaps="false"
                    android:minHeight="0dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="12dp"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Table Container (Hidden by default) -->
    <LinearLayout
        android:id="@+id/layoutTableContainer"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:visibility="gone"
        android:elevation="4dp">

        <!-- Rigid Table Header (9 Columns) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#F8F9FA"
            android:paddingVertical="8dp">
            <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="0.9" android:text="TRAN DATE" android:textSize="9sp" />
            <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.0" android:text="TRAN ID" android:textSize="9sp" />
            <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="0.7" android:text="PA TRAN TY" android:textSize="9sp" />
            <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="0.6" android:text="CURRENCY" android:textSize="9sp" />
            <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="0.9" android:text="AMOUNT" android:textSize="9sp" android:gravity="end|center_vertical" android:paddingEnd="4dp"/>
            <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.2" android:text="ACCT ID" android:textSize="9sp" />
            <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.4" android:text="ACCT NAME" android:textSize="9sp" />
            <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="0.8" android:text="STATUS" android:textSize="9sp" />
            <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="0.6" android:text="SELECT" android:textSize="9sp" android:gravity="center"/>
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvRelatedEntries"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </LinearLayout>

</LinearLayout>
