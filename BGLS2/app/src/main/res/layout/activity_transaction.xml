<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- SLEEK PROFESSIONAL HEADER (Single Row) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/header_bg"
        android:layout_marginTop="30dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:paddingHorizontal="24dp"
        android:elevation="8dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/arrow_back"
            android:padding="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/white"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TRANSACTION"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:layout_centerInParent="true"/>

        <!-- Right Side Container (User Info + Buttons) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true">

            <!-- Vertical User Info -->
            <LinearLayout
                android:id="@+id/userInfoLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginEnd="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="65dp"
                        android:layout_height="wrap_content"
                        android:text="User ID"
                        android:textColor="#AACFFF"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=":"
                        android:textColor="#AACFFF"
                        android:textSize="10sp"
                        android:layout_marginEnd="4dp"/>
                    <TextView
                        android:id="@+id/txtUserIdInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="EMP04"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="2dp">
                    <TextView
                        android:layout_width="65dp"
                        android:layout_height="wrap_content"
                        android:text="User Name"
                        android:textColor="#AACFFF"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=":"
                        android:textColor="#AACFFF"
                        android:textSize="10sp"
                        android:layout_marginEnd="4dp"/>
                    <TextView
                        android:id="@+id/txtUserNameInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Manivanan"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="2dp">
                    <TextView
                        android:layout_width="65dp"
                        android:layout_height="wrap_content"
                        android:text="Login Time"
                        android:textColor="#AACFFF"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=":"
                        android:textColor="#AACFFF"
                        android:textSize="10sp"
                        android:layout_marginEnd="4dp"/>
                    <TextView
                        android:id="@+id/txtLoginTimeInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>

            <ImageView
                android:id="@+id/btnHome"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/home"
                android:padding="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/white"/>

        </LinearLayout>
    </RelativeLayout>

    <!-- Toolbar for actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end|center_vertical"
        android:padding="8dp"
        android:background="#E9ECEF">

        <Spinner
            android:id="@+id/spinnerFilter"
            android:layout_width="150dp"
            android:layout_height="36dp"
            android:background="@drawable/spinner_background"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnDownload"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Download Disbursement"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2196F3"
            android:textAllCaps="false"/>
    </LinearLayout>
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />
        <!-- ─── TABS ─── -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:fillViewport="true"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/tabContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="4dp">

                <TextView
                    android:id="@+id/tabDisbursement"
                    style="@style/TransactionTab"
                    android:minWidth="120dp"
                    android:text="Disbursement"
                    android:textColor="#FFFFFF"
                    android:background="#1785A3"/>

                <TextView
                    android:id="@+id/tabInterest"
                    style="@style/TransactionTab"
                    android:minWidth="140dp"
                    android:text="Interest Transaction"/>

                <TextView
                    android:id="@+id/tabFees"
                    style="@style/TransactionTab"
                    android:minWidth="140dp"
                    android:text="Fees Transaction"/>

                <TextView
                    android:id="@+id/tabPenalty"
                    style="@style/TransactionTab"
                    android:minWidth="140dp"
                    android:text="Penalty Transaction"/>

                <TextView
                    android:id="@+id/tabRecovery"
                    style="@style/TransactionTab"
                    android:minWidth="140dp"
                    android:text="Recovery Transaction"/>
            </LinearLayout>
        </HorizontalScrollView>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#CCCCCC"/>

        <!-- ─── TABLE ─── -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="horizontal">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <!-- DUAL HEADER: Default vs Filter Row -->
                <FrameLayout
                    android:layout_marginTop="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minWidth="980dp">

                    <!-- 1. Default Table Header -->
                    <LinearLayout
                        android:id="@+id/layoutDefaultHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="#E8EAED"
                        android:visibility="visible">

                        <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="0.8" android:minWidth="60dp" android:paddingTop="10dp" android:paddingBottom="10dp" android:background="@drawable/table_cell_bg" android:text="S.NO"/>
                        <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.5" android:minWidth="100dp" android:paddingTop="10dp" android:paddingBottom="10dp" android:background="@drawable/table_cell_bg" android:text="FLOW ID"/>
                        <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.5" android:minWidth="100dp" android:paddingTop="10dp" android:paddingBottom="10dp" android:background="@drawable/table_cell_bg" android:text="FLOW DATE"/>
                        <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.5" android:minWidth="100dp" android:paddingTop="10dp" android:paddingBottom="10dp" android:background="@drawable/table_cell_bg" android:text="FLOW CODE"/>
                        <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.8" android:minWidth="120dp" android:paddingTop="10dp" android:paddingBottom="10dp" android:background="@drawable/table_cell_bg" android:text="FLOW AMOUNT" android:gravity="end|center_vertical" android:paddingEnd="12dp"/>
                        <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="2.5" android:minWidth="200dp" android:paddingTop="10dp" android:paddingBottom="10dp" android:background="@drawable/table_cell_bg" android:text="ACCOUNT NUMBER"/>
                        <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="2.5" android:minWidth="200dp" android:paddingTop="10dp" android:paddingBottom="10dp" android:background="@drawable/table_cell_bg" android:text="ACCOUNT NAME"/>
                    </LinearLayout>

                    <!-- 2. Filter Table Header -->
                    <LinearLayout
                        android:id="@+id/layoutFilterHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="#E8EAED"
                        android:visibility="gone">

                        <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.8" android:minWidth="60dp" android:paddingTop="10dp" android:paddingBottom="10dp" android:background="@drawable/table_cell_bg" android:text="S.NO"/>

                        <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.5" android:minWidth="100dp">
                            <TextView android:id="@+id/tvHdrFlowId" style="@style/TableHeader" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="10dp" android:paddingBottom="10dp" android:background="@drawable/table_cell_bg" android:text="FLOW ID"/>
                            <EditText android:id="@+id/etFilterFlowId" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/table_cell_bg" android:padding="8dp" android:hint="FLOW ID" android:textSize="11sp" android:singleLine="true" android:visibility="gone" android:imeOptions="actionSearch"/>
                        </FrameLayout>

                        <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.5" android:minWidth="100dp" android:paddingTop="10dp" android:paddingBottom="10dp" android:background="@drawable/table_cell_bg" android:text="FLOW DATE"/>
                        
                        <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.5" android:minWidth="100dp" android:paddingTop="10dp" android:paddingBottom="10dp" android:background="@drawable/table_cell_bg" android:text="FLOW CODE"/>
                        
                        <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.8" android:minWidth="120dp" android:paddingTop="10dp" android:paddingBottom="10dp" android:background="@drawable/table_cell_bg" android:text="FLOW AMOUNT" android:gravity="end|center_vertical" android:paddingEnd="12dp"/>

                        <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2.5" android:minWidth="200dp">
                            <TextView android:id="@+id/tvHdrAccountNumber" style="@style/TableHeader" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="10dp" android:paddingBottom="10dp" android:background="@drawable/table_cell_bg" android:text="ACCOUNT NUMBER"/>
                            <EditText android:id="@+id/etFilterAccountNumber" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/table_cell_bg" android:padding="8dp" android:hint="ACCOUNT NUMBER" android:textSize="11sp" android:singleLine="true" android:visibility="gone" android:imeOptions="actionSearch"/>
                        </FrameLayout>

                        <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2.5" android:minWidth="200dp">
                            <TextView android:id="@+id/tvHdrAccountName" style="@style/TableHeader" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="10dp" android:paddingBottom="10dp" android:background="@drawable/table_cell_bg" android:text="ACCOUNT NAME"/>
                            <EditText android:id="@+id/etFilterAccountName" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/table_cell_bg" android:padding="8dp" android:hint="ACCOUNT NAME" android:textSize="11sp" android:singleLine="true" android:visibility="gone" android:imeOptions="actionSearch"/>
                        </FrameLayout>
                    </LinearLayout>
                </FrameLayout>



                <!-- TABLE ROWS -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerViewTransactions"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#FFFFFF"/>

            </LinearLayout>
        </HorizontalScrollView>
</LinearLayout>
