<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- ─── TITLE BAR ─── -->
    <FrameLayout
        android:layout_marginTop="30dp"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@drawable/header_bg"
        android:padding="10dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="TRANSACTION"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/white"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Spinner
                android:id="@+id/spinnerFilter"
                android:layout_width="150dp"
                android:layout_height="wrap_content"
                android:background="@drawable/spinner_background"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btnDownload"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Download Disbursement"
                android:textColor="#FFFFFF"
                android:backgroundTint="#2196F3"
                android:textSize="10sp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"/>
        </LinearLayout>
    </FrameLayout>

    <!-- ─── TABS ─── -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:fillViewport="true"
        android:scrollbars="none">
        <LinearLayout
            android:id="@+id/tabContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="4dp">

            <TextView
                android:id="@+id/tabDisbursement"
                style="@style/TransactionTab"
                android:minWidth="120dp"
                android:text="Disbursement"
                android:textColor="#FFFFFF"
                android:background="#1785A3"/>

            <TextView
                android:id="@+id/tabInterest"
                style="@style/TransactionTab"
                android:minWidth="140dp"
                android:text="Interest Transaction"/>

            <TextView
                android:id="@+id/tabFees"
                style="@style/TransactionTab"
                android:minWidth="140dp"
                android:text="Fees Transaction"/>

            <TextView
                android:id="@+id/tabPenalty"
                style="@style/TransactionTab"
                android:minWidth="140dp"
                android:text="Penalty Transaction"/>

            <TextView
                android:id="@+id/tabRecovery"
                style="@style/TransactionTab"
                android:minWidth="140dp"
                android:text="Recovery Transaction"/>
        </LinearLayout>
    </HorizontalScrollView>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#CCCCCC"/>

    <!-- ─── TABLE ─── -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="horizontal">
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- TABLE HEADER -->
            <LinearLayout
                android:layout_marginTop="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                
                <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="0.8" android:minWidth="60dp" android:text="S.NO" android:background="@drawable/table_cell_bg" android:paddingTop="10dp" android:paddingBottom="10dp"/>
                <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.5" android:minWidth="100dp" android:text="FLOW ID" android:background="@drawable/table_cell_bg" android:paddingTop="10dp" android:paddingBottom="10dp"/>
                <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.5" android:minWidth="100dp" android:text="FLOW DATE" android:background="@drawable/table_cell_bg" android:paddingTop="10dp" android:paddingBottom="10dp"/>
                <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.5" android:minWidth="100dp" android:text="FLOW CODE" android:background="@drawable/table_cell_bg" android:paddingTop="10dp" android:paddingBottom="10dp"/>
                <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.8" android:minWidth="120dp" android:text="FLOW AMOUNT" android:background="@drawable/table_cell_bg" android:paddingTop="10dp" android:paddingBottom="10dp" android:gravity="end|center_vertical" android:paddingEnd="12dp"/>
                <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="2.5" android:minWidth="200dp" android:text="ACCOUNT NUMBER" android:background="@drawable/table_cell_bg" android:paddingTop="10dp" android:paddingBottom="10dp"/>
                <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="2.5" android:minWidth="200dp" android:text="ACCOUNT NAME" android:background="@drawable/table_cell_bg" android:paddingTop="10dp" android:paddingBottom="10dp"/>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#CCCCCC"/>

            <!-- TABLE ROWS -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewTransactions"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#FFFFFF"/>

        </LinearLayout>
    </HorizontalScrollView>

</LinearLayout>