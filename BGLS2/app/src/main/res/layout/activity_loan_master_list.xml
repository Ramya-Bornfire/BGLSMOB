<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:id="@+id/main"
    android:background="#FFFFFF">

    <!-- SLEEK PROFESSIONAL HEADER (Single Row) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/header_bg"
        android:layout_marginTop="30dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:paddingHorizontal="24dp"
        android:elevation="8dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/arrow_back"
            android:padding="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/white"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LOAN MASTER - LIST"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:layout_centerInParent="true"/>

        <!-- Right Side Container (User Info + Buttons) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true">

            <!-- Vertical User Info -->
            <LinearLayout
                android:id="@+id/userInfoLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginEnd="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="65dp"
                        android:layout_height="wrap_content"
                        android:text="User ID"
                        android:textColor="#AACFFF"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=":"
                        android:textColor="#AACFFF"
                        android:textSize="10sp"
                        android:layout_marginEnd="4dp"/>
                    <TextView
                        android:id="@+id/txtUserIdInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="EMP04"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="2dp">
                    <TextView
                        android:layout_width="65dp"
                        android:layout_height="wrap_content"
                        android:text="User Name"
                        android:textColor="#AACFFF"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=":"
                        android:textColor="#AACFFF"
                        android:textSize="10sp"
                        android:layout_marginEnd="4dp"/>
                    <TextView
                        android:id="@+id/txtUserNameInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Manivanan"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="2dp">
                    <TextView
                        android:layout_width="65dp"
                        android:layout_height="wrap_content"
                        android:text="Login Time"
                        android:textColor="#AACFFF"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=":"
                        android:textColor="#AACFFF"
                        android:textSize="10sp"
                        android:layout_marginEnd="4dp"/>
                    <TextView
                        android:id="@+id/txtLoginTimeInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>

            <ImageView
                android:id="@+id/btnHome"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/home"
                android:padding="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/white"/>

        </LinearLayout>
    </RelativeLayout>

    <!-- Toolbar for actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end|center_vertical"
        android:padding="8dp"
        android:background="#E9ECEF">

        <!-- Select Filter Spinner -->
        <Spinner
            android:id="@+id/spinnerFilter"
            android:layout_width="140dp"
            android:layout_height="36dp"
            android:background="@drawable/spinner_background"
            android:layout_marginEnd="8dp"/>

        <!-- Select Status Spinner -->
        <Spinner
            android:id="@+id/spinnerStatus"
            android:layout_width="140dp"
            android:layout_height="36dp"
            android:background="@drawable/spinner_background"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnDownload"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Download"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2196F3"
            android:textAllCaps="false"/>
    </LinearLayout>



    <!-- Loading indicator -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"/>

    <!-- ─── TABLE: Header + Rows inside SAME HorizontalScrollView ─── -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="horizontal">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- DUAL HEADER: Default vs Filter Row -->
            <FrameLayout
                android:layout_marginTop="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minWidth="1060dp">

                <!-- 1. Default Table Header -->
                <LinearLayout
                    android:id="@+id/layoutDefaultHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="#E8EAED"
                    android:visibility="visible">

                    <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="0.8" android:minWidth="80dp" android:background="@drawable/table_cell_bg" android:padding="12dp" android:text="S.NO"/>
                    <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.5" android:minWidth="150dp" android:background="@drawable/table_cell_bg" android:padding="12dp" android:text="LOAN ID"/>
                    <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.8" android:minWidth="180dp" android:background="@drawable/table_cell_bg" android:padding="12dp" android:text="LOAN TYPE"/>
                    <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="2.5" android:minWidth="250dp" android:background="@drawable/table_cell_bg" android:padding="12dp" android:text="LOAN NAME"/>
                    <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.3" android:minWidth="130dp" android:background="@drawable/table_cell_bg" android:padding="12dp" android:text="MOBILE NO"/>
                    <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.5" android:minWidth="150dp" android:background="@drawable/table_cell_bg" android:padding="12dp" android:text="RETAILER BRANCH ID"/>
                    <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_weight="1.2" android:minWidth="120dp" android:background="@drawable/table_cell_bg" android:padding="12dp" android:text="STATUS"/>
                </LinearLayout>

                <!-- 2. Filter Table Header -->
                <LinearLayout
                    android:id="@+id/layoutFilterHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="#E8EAED"
                    android:visibility="gone">

                    <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.8" android:minWidth="80dp" android:background="@drawable/table_cell_bg" android:padding="12dp" android:text="S.NO"/>

                    <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.5" android:minWidth="150dp">
                        <TextView android:id="@+id/tvHdrLoanId" style="@style/TableHeader" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/table_cell_bg" android:padding="12dp" android:text="LOAN ID"/>
                        <EditText android:id="@+id/etFilterLoanId" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/table_cell_bg" android:padding="8dp" android:hint="LOAN ID" android:textSize="11sp" android:singleLine="true" android:visibility="gone" android:imeOptions="actionSearch"/>
                    </FrameLayout>

                    <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.8" android:minWidth="180dp">
                        <TextView android:id="@+id/tvHdrLoanType" style="@style/TableHeader" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/table_cell_bg" android:padding="12dp" android:text="LOAN TYPE"/>
                        <EditText android:id="@+id/etFilterLoanType" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/table_cell_bg" android:padding="8dp" android:hint="LOAN TYPE" android:textSize="11sp" android:singleLine="true" android:visibility="gone" android:imeOptions="actionSearch"/>
                    </FrameLayout>

                    <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2.5" android:minWidth="250dp">
                        <TextView android:id="@+id/tvHdrLoanName" style="@style/TableHeader" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/table_cell_bg" android:padding="12dp" android:text="LOAN NAME"/>
                        <EditText android:id="@+id/etFilterLoanName" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/table_cell_bg" android:padding="8dp" android:hint="LOAN NAME" android:textSize="11sp" android:singleLine="true" android:visibility="gone" android:imeOptions="actionSearch"/>
                    </FrameLayout>

                    <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.3" android:minWidth="130dp">
                        <TextView android:id="@+id/tvHdrMobileNo" style="@style/TableHeader" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/table_cell_bg" android:padding="12dp" android:text="MOBILE NO"/>
                        <EditText android:id="@+id/etFilterMobileNo" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/table_cell_bg" android:padding="8dp" android:hint="MOBILE NO" android:textSize="11sp" android:singleLine="true" android:visibility="gone" android:imeOptions="actionSearch"/>
                    </FrameLayout>

                    <FrameLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.5" android:minWidth="150dp">
                        <TextView android:id="@+id/tvHdrRetailerBranchId" style="@style/TableHeader" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/table_cell_bg" android:padding="12dp" android:text="RETAILER BRANCH ID"/>
                        <EditText android:id="@+id/etFilterRetailerBranchId" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/table_cell_bg" android:padding="8dp" android:hint="BRANCH ID" android:textSize="11sp" android:singleLine="true" android:visibility="gone" android:imeOptions="actionSearch"/>
                    </FrameLayout>

                    <TextView style="@style/TableHeader" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.2" android:minWidth="120dp" android:background="@drawable/table_cell_bg" android:padding="12dp" android:text="STATUS"/>
                </LinearLayout>
            </FrameLayout>


            <!-- TABLE ROWS -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewLoansList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#FFFFFF"/>

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Divider -->
    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="#CCCCCC"/>

    <!-- ─── PAGINATION ─── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#FFFFFF"
        android:padding="10dp">

        <Button
            android:id="@+id/btnPrev"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Prev"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2196F3"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:layout_marginEnd="12dp"/>

        <TextView
            android:id="@+id/tvPageInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Page 1 of 11"
            android:textSize="13sp"
            android:textColor="#333333"
            android:layout_marginEnd="12dp"/>


        <Button
            android:id="@+id/btnNext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Next"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2196F3"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"/>
    </LinearLayout>

</LinearLayout>
