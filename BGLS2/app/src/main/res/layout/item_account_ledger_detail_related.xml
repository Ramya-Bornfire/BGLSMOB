<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <TextView android:id="@+id/tvTranDate"
        android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1.0"
        android:padding="12dp"
        android:background="@drawable/table_cell_bg" android:gravity="center_vertical"
        android:textSize="11sp" android:textColor="#333333"/>

    <TextView android:id="@+id/tvTranId"
        android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1.2"
        android:padding="12dp"
        android:background="@drawable/table_cell_bg" android:gravity="center_vertical"
        android:textSize="11sp" android:textColor="#333333"/>

    <TextView android:id="@+id/tvPaTranTy"
        android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="0.9"
        android:padding="12dp"
        android:background="@drawable/table_cell_bg" android:gravity="center_vertical"
        android:textSize="11sp" android:textColor="#333333"/>

    <TextView android:id="@+id/tvCurrency"
        android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="0.8"
        android:padding="12dp"
        android:background="@drawable/table_cell_bg" android:gravity="center_vertical"
        android:textSize="11sp" android:textColor="#333333"/>

    <TextView android:id="@+id/tvAmount"
        android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1.2"
        android:padding="12dp"
        android:background="@drawable/table_cell_bg" android:gravity="center_vertical|end"
        android:textSize="11sp" android:textColor="#333333"/>

    <TextView android:id="@+id/tvAcctId"
        android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1.0"
        android:padding="12dp"
        android:background="@drawable/table_cell_bg" android:gravity="center_vertical"
        android:textSize="11sp" android:textColor="#333333"/>

    <TextView android:id="@+id/tvAcctName"
        android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1.5"
        android:padding="12dp"
        android:background="@drawable/table_cell_bg" android:gravity="center_vertical"
        android:textSize="11sp" android:textColor="#333333"/>

    <TextView android:id="@+id/tvStatus"
        android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1.0"
        android:padding="12dp"
        android:background="@drawable/table_cell_bg" android:gravity="center_vertical"
        android:textSize="11sp" android:textColor="#333333"/>

    <LinearLayout
        android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="0.8"
        android:background="@drawable/table_cell_bg" android:gravity="center">
        <RadioButton android:id="@+id/rbValidate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:clickable="true" android:focusable="true"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1.0"
        android:background="@drawable/table_cell_bg" android:gravity="center">
        <RadioButton android:id="@+id/rbAccountBal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:clickable="true" android:focusable="true"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="0.8"
        android:background="@drawable/table_cell_bg" android:gravity="center">
        <RadioButton android:id="@+id/rbSelect" android:layout_width="wrap_content" android:layout_height="wrap_content" android:clickable="true" android:focusable="true"/>
    </LinearLayout>

</LinearLayout>
