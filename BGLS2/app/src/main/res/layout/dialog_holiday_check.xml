<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="0dp">

    <!-- Header -->
    <TextView
        android:id="@+id/tvDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Holiday Check"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:padding="16dp"/>

    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#FFFFFF"/>

    <!-- Content that will be hidden after submit -->
    <LinearLayout
        android:id="@+id/layoutDialogContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- From Date -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:text="From Date :"
                android:textStyle="bold"
                android:textColor="#333333"
                android:gravity="end"
                android:layout_marginEnd="16dp"/>

            <EditText
                android:id="@+id/etFromDate"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:background="@drawable/edittext_border"
                android:paddingHorizontal="8dp"
                android:textSize="14sp"
                android:focusable="false"
                android:textColor="#555555"/>
        </LinearLayout>

        <!-- To Date (current date, visible but read-only) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:text="To Date :"
                android:textStyle="bold"
                android:textColor="#333333"
                android:gravity="end"
                android:layout_marginEnd="16dp"/>

            <EditText
                android:id="@+id/etToDate"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:background="@drawable/edittext_background"
                android:paddingHorizontal="8dp"
                android:textSize="14sp"
                android:enabled="false"
                android:textColor="#555555"/>
        </LinearLayout>

    </LinearLayout>

    <!-- RESULT TextView – placed OUTSIDE layoutDialogContent so it stays visible -->
    <TextView
        android:id="@+id/tvValidationMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="20sp"
        android:textColor="#333333"
        android:gravity="center"
        android:visibility="gone"
        android:layout_margin="24dp"/>

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="16dp">

        <Button
            android:id="@+id/btnSubmit"
            android:layout_width="100dp"
            android:layout_height="40dp"
            android:text="Submit"
            android:backgroundTint="#007BFF"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnClose"
            android:layout_width="100dp"
            android:layout_height="40dp"
            android:text="Close"
            android:backgroundTint="#007BFF"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"/>
    </LinearLayout>

</LinearLayout>
