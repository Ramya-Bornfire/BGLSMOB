<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="8dp">
    <TextView android:id="@+id/tvFlowDate" android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="wrap_content" android:textSize="12sp"/>
    <TextView android:id="@+id/tvFlowId" android:layout_width="0dp" android:layout_weight="0.8" android:layout_height="wrap_content" android:textSize="12sp"/>
    <TextView android:id="@+id/tvFlowCode" android:layout_width="0dp" android:layout_weight="1.0" android:layout_height="wrap_content" android:textSize="12sp"/>
    <TextView android:id="@+id/tvFlowAmt" android:layout_width="0dp" android:layout_weight="1.0" android:layout_height="wrap_content" android:textSize="12sp" android:gravity="end"/>
    <TextView android:id="@+id/tvAcctNo" android:layout_width="0dp" android:layout_weight="1.5" android:layout_height="wrap_content" android:textSize="12sp"/>
    <TextView android:id="@+id/tvAcctName" android:layout_width="0dp" android:layout_weight="2.0" android:layout_height="wrap_content" android:textSize="12sp"/>
    <RadioButton android:id="@+id/rbSelectFlow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_weight="0.5"/>
</LinearLayout>