<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <TextView android:id="@+id/tvId"
        android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1" android:minWidth="60dp"
        android:paddingTop="12dp" android:paddingBottom="12dp"
        android:gravity="center_vertical"
        android:paddingStart="8dp" android:paddingEnd="8dp"
        android:textSize="12sp" android:textColor="#333333"/>

    <TextView android:id="@+id/tvEvent"
        android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1.5" android:minWidth="100dp"
        android:paddingTop="12dp" android:paddingBottom="12dp"
        android:gravity="center_vertical"
        android:paddingStart="8dp" android:paddingEnd="8dp"
        android:textSize="12sp" android:textColor="#333333"/>

    <TextView android:id="@+id/tvDebitAccNo"
        android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1.5" android:minWidth="120dp"
        android:paddingTop="12dp" android:paddingBottom="12dp"
        android:gravity="center_vertical"
        android:paddingStart="8dp" android:paddingEnd="8dp"
        android:textSize="12sp" android:textColor="#333333"/>

    <TextView android:id="@+id/tvDebitAccName"
        android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="2" android:minWidth="150dp"
        android:paddingTop="12dp" android:paddingBottom="12dp"
        android:gravity="center_vertical"
        android:paddingStart="8dp" android:paddingEnd="8dp"
        android:textSize="12sp" android:textColor="#333333"/>

    <TextView android:id="@+id/tvCreditAccNo"
        android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1.5" android:minWidth="120dp"
        android:paddingTop="12dp" android:paddingBottom="12dp"
        android:gravity="center_vertical"
        android:paddingStart="8dp" android:paddingEnd="8dp"
        android:textSize="12sp" android:textColor="#333333"/>

    <TextView android:id="@+id/tvCreditAccName"
        android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="2" android:minWidth="150dp"
        android:paddingTop="12dp" android:paddingBottom="12dp"
        android:gravity="center_vertical"
        android:paddingStart="8dp" android:paddingEnd="8dp"
        android:textSize="12sp" android:textColor="#333333"/>

    <TextView android:id="@+id/tvTranParticular"
        android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="2" android:minWidth="150dp"
        android:paddingTop="12dp" android:paddingBottom="12dp"
        android:gravity="center_vertical"
        android:paddingStart="8dp" android:paddingEnd="8dp"
        android:textSize="12sp" android:textColor="#333333"/>

    <TextView android:id="@+id/tvType"
        android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1" android:minWidth="60dp"
        android:paddingTop="12dp" android:paddingBottom="12dp"
        android:gravity="center_vertical"
        android:paddingStart="8dp" android:paddingEnd="8dp"
        android:textSize="12sp" android:textColor="#333333"/>

    <TextView android:id="@+id/tvAction"
        android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1" android:minWidth="80dp"
        android:paddingTop="12dp" android:paddingBottom="12dp"
        android:gravity="center_vertical"
        android:paddingStart="8dp" android:paddingEnd="8dp"
        android:textSize="12sp" android:textColor="#2196F3"
        android:text="Action ▼"/>

</LinearLayout>
